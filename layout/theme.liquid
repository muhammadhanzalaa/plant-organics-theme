        box-sizing: border-box;
      `;
      notice.innerText = 'One delivery subscription per profile. Your meal plan automatically renews based on your dietary preferences unless canceled by Thursday at 10 AM. Add-ons are not included in automatic renewals.';
      
      step1Container.appendChild(notice);
    }
  }

  // 2. SAFE FETCH INTERCEPTOR (Does not break Theme Checkout)
  const originalFetch = window.fetch;
  window.fetch = async function() {
    let response = await originalFetch.apply(this, arguments);
    let url = arguments[0] ? arguments[0].toString() : '';

    if (url.includes('/cart/add') || url.includes('/cart/update') || url.includes('/cart/change')) {
      setTimeout(checkAndCleanCart, 300);
    }
    return response;
  };

  async function checkAndCleanCart() {
    try {
      const res = await originalFetch('/cart.js');
      const cart = await res.json();
      let updates = {};
      let needsUpdate = false;

      cart.items.forEach(item => {
        // Checking if item is explicitly an addon line item
        if (item.properties && item.properties['_is_addon'] && item.selling_plan_allocation) {
          updates[item.key] = { quantity: item.quantity, selling_plan: '' };
          needsUpdate = true;
        }
      });

      if (needsUpdate) {
        await originalFetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ updates })
        });
      }
    } catch(e) {}
  }

  // Pure UI Event Listeners
  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(renderOrangeNotice, 500);
  });

  document.addEventListener('click', function() {
    setTimeout(renderOrangeNotice, 300);
  });
})();
</script>










<!-- Instant Cart Reset on Builder Start + Bullet Formatter -->
<script>
(function () {
  // 1. STEP 1 / BUILDER PAGE OPEN HOTAY HI CART RESET
  if (window.location.search.indexOf('view=shoptrigger') !== -1) {
    // Session check taakay refresh karne par bar bar clear na ho
    if (!sessionStorage.getItem('builder_started')) {
      fetch('/cart/clear.js', { 
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      }).then(function() {
        sessionStorage.setItem('builder_started', 'true');
      });
    }
  } else {
    sessionStorage.removeItem('builder_started');
  }

  // "Get Started" ya Step 1 button click par instant cart clear
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('button, a, div[role="button"]');
    if (!btn) return;
    var text = (btn.textContent || '').toLowerCase().trim();
    var id = (btn.id || '').toLowerCase();

    if (text.indexOf('get started') !== -1 || id.indexOf('step1') !== -1) {
      fetch('/cart/clear.js', { method: 'POST' });
    }
  });

  // 2. CART BULLET FORMATTER (Sirf /cart page par)
  if (window.location.pathname.indexOf('/cart') !== -1) {
    function formatCartProperties() {
      var elements = document.querySelectorAll('form[action*="/cart"] *, .cart_item *, main *');

      elements.forEach(function (el) {
        if (el.dataset.cleaned === "true") return;
        var text = (el.textContent || '').trim();

        if (/(Selected Proteins|Selected Sides|Selected Salads|Add-ons|Starter Meal Breakdown):/i.test(text) && text.indexOf(',') !== -1) {
          var hasChildMatch = Array.from(el.children).some(function(child) {
            return /(Selected Proteins|Selected Sides|Selected Salads|Add-ons|Starter Meal Breakdown):/i.test(child.textContent);
          });
          if (hasChildMatch) return;

          var parts = text.split(':');
          var key = parts[0].trim();
          var valString = parts.slice(1).join(':').trim();

          if (valString && valString.indexOf(',') !== -1) {
            var items = valString.split(',');
            var newHtml = '<strong style="color: #293f07; display: block; margin-top: 6px;">' + key + ':</strong>';
            
            items.forEach(function (item) {
              var cleanItem = item.trim();
              if (cleanItem) {
                newHtml += '<div style="padding-left: 14px; margin-top: 3px; font-size: 13px; color: #333;">• ' + cleanItem + '</div>';
              }
            });

            el.innerHTML = newHtml;
            el.dataset.cleaned = "true";
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', formatCartProperties);
    } else {
      formatCartProperties();
    }
    setInterval(formatCartProperties, 800);
  }
})();
</script>



































