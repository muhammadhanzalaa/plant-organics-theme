<!-- Universal Cart Properties Cleaner -->
<script>
(function () {
  function formatCartProperties() {
    // Cart page ke sabhi text elements ko scan karein
    var elements = document.querySelectorAll('form[action*="/cart"] *, .cart_item *, main *');

    elements.forEach(function (el) {
      if (el.dataset.cleaned === "true") return;

      var text = (el.textContent || '').trim();

      // Check karein agar target label aur comma (,) majood hai
      if (/(Selected Proteins|Selected Sides|Selected Salads|Add-ons|Starter Meal Breakdown):/i.test(text) && text.indexOf(',') !== -1) {
        
        // Deepest child element check
        var hasChildMatch = Array.from(el.children).some(function(child) {
          return /(Selected Proteins|Selected Sides|Selected Salads|Add-ons|Starter Meal Breakdown):/i.test(child.textContent);
        });
        if (hasChildMatch) return;

        var parts = text.split(':');
        var key = parts[0].trim();
        var valString = parts.slice(1).join(':').trim();

        if (valString && valString.indexOf(',') !== -1) {
          var items = valString.split(',');
          var newHtml = '<strong style="color: #293f07; display: block; margin-top: 6px;">' + key + ':</strong>';
          
          items.forEach(function (item) {
            var cleanItem = item.trim();
            if (cleanItem) {
              newHtml += '<div style="padding-left: 14px; margin-top: 3px; font-size: 13px; color: #333;">• ' + cleanItem + '</div>';
            }
          });

          el.innerHTML = newHtml;
          el.dataset.cleaned = "true";
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', formatCartProperties);
  } else {
    formatCartProperties();
  }

  setInterval(formatCartProperties, 800); // Dynamic / AJAX cart handling
})();
</script>
{% endif %}











<!-- Fixed Position: Step 3 Notice Above Categories -->
<script>
(function() {
  // 1. Cart Interceptor (Add-ons ko recurring se hatane ke liye)
  const originalFetch = window.fetch;
  window.fetch = async function() {
    let response = await originalFetch.apply(this, arguments);
    let url = arguments[0] ? arguments[0].toString() : '';

    if (url.includes('/cart/add.js') || url.includes('/cart/add')) {
      setTimeout(fixCartSellingPlans, 500);
    }
    return response;
  };

  function fixCartSellingPlans() {
    fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {
        let updates = {};
        let needsUpdate = false;

        cart.items.forEach((item) => {
          const isAddon = item.properties && (item.properties['_is_addon'] || item.product_type !== 'Meal Plan');
          if (isAddon && item.selling_plan_allocation) {
            updates[item.key] = {
              quantity: item.quantity,
              selling_plan: '' 
            };
            needsUpdate = true;
          }
        });

        if (needsUpdate) {
          fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ updates: updates })
          });
        }
      });
  }

  // 2. Targeted Step Notices
  function injectNotices() {
    // Step 3 Notice - Main Header ke bilkul baad (Category se pehle)
    var step3Header = document.querySelector('.glow-mb-builder-header');
    if (step3Header && !document.getElementById('addon-step3-note')) {
      var n3 = document.createElement('div');
