     Subscription / One-Time Add-on Splitter v4
     (Fixes Double Charging & Cleans Main Box Props)
     ============================================
<script>
(function () {
  try {
    var originalFetch = window.fetch.bind(window);

    var ADDON_CATALOG = {
      // Bakery — $8.00 each
      "banana bread":             { id: 48852142686459, price: 8.00,  isJuice: false },
      "energy bites":              { id: 49089705115899, price: 8.00,  isJuice: false },
      "protein muffins":          { id: 49089702035707, price: 8.00,  isJuice: false },
      "seasonal bakery item":     { id: 49089706688763, price: 8.00,  isJuice: false },

      // Breakfast — $9.00 each
      "chia pudding":              { id: 49089692532987, price: 9.00,  isJuice: false },
      "egg bites":                 { id: 49089694761211, price: 9.00,  isJuice: false },
      "greek yogurt parfait":      { id: 49089698955515, price: 9.00,  isJuice: false },
      "overnight oats":            { id: 49089692139771, price: 9.00,  isJuice: false },

      // Fresh-Pressed Juice — $9.00 each, 3 for $24.00 bundle
      "beet boost":                { id: 49089738539259, price: 9.00,  isJuice: true },
      "citrus immunity":           { id: 49089716977915, price: 9.00,  isJuice: true },
      "green glow":                { id: 49089713996027, price: 9.00,  isJuice: true },
      "tropical greens":           { id: 49089747026171, price: 9.00,  isJuice: true },

      // Extra Protein — $20.00 each
      "turkey burgers":            { id: 49089659797755, price: 20.00, isJuice: false },
      "grass-fed bison patties":  { id: 49089661468923, price: 20.00, isJuice: false },
      "lemon herb tofu":          { id: 49089664647419, price: 20.00, isJuice: false },
      "spinach & feta veggie cakes": { id: 49089665433851, price: 20.00, isJuice: false }
    };

    var JUICE_BUNDLE_QTY = 3;
    var JUICE_BUNDLE_PRICE = 24.00;

    function toCents(n) { return Math.round(n * 100); }
    function fromCents(c) { return (c / 100).toFixed(2); }

    function normalizeName(name) {
      return name.trim().toLowerCase().replace(/\s+/g, ' ');
    }

    function parseAddonsText(text) {
      if (!text || typeof text !== 'string') return [];
      return text.split(',').map(function (chunk) {
        var m = chunk.trim().match(/^(\d+)\s*x\s*(.+)$/i);
        if (!m) return null;
        return { name: normalizeName(m[2]), qty: parseInt(m[1], 10) };
      }).filter(Boolean);
    }

    function buildAddonLines(entry, catalogEntry) {
      var lines = [];

      if (catalogEntry.isJuice) {
        var bundles = Math.floor(entry.qty / JUICE_BUNDLE_QTY);
        var remainder = entry.qty % JUICE_BUNDLE_QTY;

        if (bundles > 0) {
          lines.push({
            id: catalogEntry.id,
            quantity: bundles * JUICE_BUNDLE_QTY,
            properties: {
              "Note": "One-time add-on (3-pack bundle)"
            }
          });
        }
        if (remainder > 0) {
          lines.push({
            id: catalogEntry.id,
            quantity: remainder,
            properties: {
              "Note": "One-time add-on"
            }
          });
        }
      } else {
        lines.push({
          id: catalogEntry.id,
          quantity: entry.qty,
          properties: {
            "Note": "One-time add-on"
          }
        });
      }

      return lines;
    }

    function resolveAddons(parsedList) {
      var addonLineItems = [];
      var addonTotalCents = 0;

      parsedList.forEach(function (entry) {
        var catalogEntry = ADDON_CATALOG[entry.name];
        if (!catalogEntry) return;

        var unitCents = toCents(catalogEntry.price);
        var costCents = catalogEntry.isJuice
          ? (Math.floor(entry.qty / JUICE_BUNDLE_QTY) * toCents(JUICE_BUNDLE_PRICE) +
             (entry.qty % JUICE_BUNDLE_QTY) * unitCents)
          : unitCents * entry.qty;

        addonTotalCents += costCents;

        buildAddonLines(entry, catalogEntry).forEach(function (line) {
          addonLineItems.push(line);
        });
      });

      return { addonLineItems: addonLineItems, addonTotalCents: addonTotalCents };
    }

    function isCartAddRequest(url) {
      return typeof url === 'string' && /\/cart\/add(\.js)?(\?|$)/.test(url);
    }

    async function buildModifiedBody(originalBodyText) {
      var body;
      try {
        body = JSON.parse(originalBodyText);
      } catch (e) {
        return null;
      }

      if (!body || !Array.isArray(body.items) || body.items.length === 0) return null;

      var newItems = [];
      var didModify = false;

      body.items.forEach(function (item) {
        var props = item.properties || {};
        var addonsText = props["Add-ons"];
        var hasSellingPlan = !!item.selling_plan;

        if (!addonsText || !hasSellingPlan) {
          newItems.push(item);
          return;
        }

        var parsed = parseAddonsText(addonsText);
        if (parsed.length === 0) {
          newItems.push(item);
          return;
        }

        var resolved = resolveAddons(parsed);

        if (resolved.addonTotalCents <= 0) {
          newItems.push(item);
          return;
        }

        var newItem = JSON.parse(JSON.stringify(item));
        var newProps = newItem.properties;

        // 1. Remove Add-ons property from main box to prevent text listing in meal box
        delete newProps["Add-ons"];

        // 2. Adjust prices to base price by removing add-on cost
        var originalPriceCents = toCents(parseFloat(newProps["_price"] || "0"));
        if (originalPriceCents > 0) {
          var mealOnlyCents = Math.max(originalPriceCents - resolved.addonTotalCents, 0);
          newProps["_price"] = fromCents(mealOnlyCents);
          if (newProps["Weekly Price"]) {
            newProps["Weekly Price"] = "$" + fromCents(mealOnlyCents);
          }
        }

        // Push clean main box item (Subscription)
        newItems.push(newItem);

        // Push separated add-ons (One-Time)
        resolved.addonLineItems.forEach(function (li) { 
          newItems.push(li); 
        });

        didModify = true;
      });

      if (!didModify) return null;

      body.items = newItems;
      return JSON.stringify(body);
    }

    window.fetch = function (input, init) {
      try {
        var url = typeof input === 'string' ? input : (input && input.url);
        var method = (init && init.method) || (input && input.method) || 'GET';

        if (isCartAddRequest(url) && /post/i.test(method) && init && typeof init.body === 'string') {
          return buildModifiedBody(init.body).then(function (newBodyText) {
            if (!newBodyText) {
              return originalFetch(input, init);
            }
            var newInit = Object.assign({}, init, { body: newBodyText });
            console.log('PO Meal Box Intercepted:', JSON.parse(newBodyText));
            return originalFetch(input, newInit);
          }).catch(function (e) {
            return originalFetch(input, init);
          });
        }
      } catch (e) {
        console.warn('PO Meal Box Error:', e);
      }

      return originalFetch(input, init);
    };
  } catch (e) {
    console.warn('PO Meal Box Init Error:', e);
  }
})();
</script>


































