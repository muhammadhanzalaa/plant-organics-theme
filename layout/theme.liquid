<!-- Glow Builder Step 1 Privacy Notice Script -->
<script>
  (function() {
    function addPrivacyNotice() {
      const leadForm = document.querySelector('form[id*="glow-mb-lead-form"]');
      
      if (leadForm && !document.querySelector('.po-privacy-notice-text')) {
        const noticeWrapper = document.createElement('div');
        noticeWrapper.className = 'po-privacy-notice-text';
        noticeWrapper.innerHTML = `
          <p style="font-size: 11.5px; color: #444444; line-height: 1.45; margin-top: 15px; margin-bottom: 5px; text-align: center; width: 100%;">
            Your information is collected securely and used only to process your order, provide services, and communicate with you. By submitting your information, you agree to our <a href="/policies/privacy-policy" target="_blank" style="color: #293f07; text-decoration: underline; font-weight: 600;">Privacy Policy</a>.
          </p>
        `;
        
        leadForm.appendChild(noticeWrapper);
      }
    }

    const observer = new MutationObserver(addPrivacyNotice);
    observer.observe(document.body, { childList: true, subtree: true });
    
    document.addEventListener("DOMContentLoaded", addPrivacyNotice);
  })();
</script>



















<!-- ============================================
     PO Meal Box Builder — Complete Fix v13.0
     (v13 changes vs v12.1):
       1) ADDED: Native Fetch Interceptor for /cart/add.js
          - Strips selling_plan from Add-ons automatically.
          - Preserves main box recurring selling_plan.
          - Fixes Shopify Checkout Engine recurring mismatch.
       2) PRESERVED: 100% of v12.1 features byte-for-byte
          - Dietary Preferences, Allergy guards, weight caps, 
          - History tracking, back button guards, DOM overrides,
          - And debounced observers remain completely untouched.

     Paste in its OWN "Custom Liquid" section.
     Only runs on: /products/*?view=shoptrigger
     ============================================ -->
<script>
(function () {
  try {
    if (window.location.search.indexOf('view=shoptrigger') === -1) return;

    // =========================================================
    // 0. NATIVE FETCH INTERCEPTOR (v13 FIX FOR CHECKOUT ENGINE)
    // =========================================================
    var originalFetch = window.fetch;
    window.fetch = function () {
      var args = arguments;
      var url = args[0] ? (typeof args[0] === 'string' ? args[0] : args[0].url) : '';

      if (url && (url.indexOf('/cart/add.js') !== -1 || url.indexOf('/cart/add') !== -1)) {
        if (args[1] && args[1].body) {
          try {
            var payload = JSON.parse(args[1].body);

            if (payload.items && Array.isArray(payload.items)) {
              payload.items.forEach(function (item) {
                var title = (item.title || '').toLowerCase();
                var properties = item.properties || {};

                var isAddon = properties['_is_addon'] || 
                              properties['Item Type'] === 'Add-on' || 
                              title.indexOf('add-on') !== -1 || 
                              title.indexOf('addon') !== -1;

                if (isAddon) {
                  delete item.selling_plan;
                }
              });
              args[1].body = JSON.stringify(payload);
            } else if (payload.id) {
              var title = (payload.title || '').toLowerCase();
              var properties = payload.properties || {};
              var isAddon = properties['_is_addon'] || 
                            properties['Item Type'] === 'Add-on' || 
                            title.indexOf('add-on') !== -1 || 
                            title.indexOf('addon') !== -1;

              if (isAddon) {
                delete payload.selling_plan;
              }
              args[1].body = JSON.stringify(payload);
            }
          } catch (e) {
            console.warn('PO Meal Box: Interceptor JSON parse warning', e);
          }
        }
      }
      return originalFetch.apply(this, args);
    };

    // =========================================================
    // 1. PRESERVED V12.1 CORE LOGIC (UNTOUCHED)
    // =========================================================
    var observer = null;
    var isProcessing = false;
    var debounceTimer = null;
    var allergyGuardBound = false;
    var dietaryGuardBound = false; // v12
    var historyGuardBound = false;
    var backButtonGuardBound = false;
    var categoryCapGuardBound = false;
    var lastPushedStepKey = null;
    var isSyncingHistory = false;
    var DELIVERY_FEE = 10;
    var MONTHLY_DISCOUNT_RATE = 0.10;

    var STORAGE_KEY = 'po_mb_last_step';
    var restoreAttempted = false;
    var restorePollTimer = null;

    var addonPlanLabelFixed = false;
    var asideRefsCache = { subtotalLabel: null, deliveryLabel: null, addonsLabel: null, totalLabel: null };

    // ---------- generic helpers ----------
    function findByText(root, regex) {
      var all = root.querySelectorAll('*');
      for (var i = 0; i < all.length; i++) {
        var el = all[i];
        if (el.children.length === 0 && regex.test(el.textContent.trim())) return el;
      }
      return null;
    }

    function getAsideLabel(aside, key, regex) {
      var cached = asideRefsCache[key];
      if (cached && cached.isConnected && aside.contains(cached)) return cached;
      var found = findByText(aside, regex);
      asideRefsCache[key] = found;
      return found;
    }

    function parseMoney(text) {
      if (!text) return 0;
      var m = text.replace(/,/g, '').match(/[\d.]+/);
      return m ? parseFloat(m[0]) : 0;
    }

    function findMoneyLeaf(row, excludeEl) {
      if (!row) return null;
      var all = row.querySelectorAll('*');
      var found = null;
      for (var i = 0; i < all.length; i++) {
        var el = all[i];
        if (el.children.length === 0 && el !== excludeEl && /\$\s?[\d,]+(\.\d+)?/.test(el.textContent)) {
          found = el;
        }
      }
      return found;
    }

    function findSummaryAside() {
      return document.querySelector('.glow-mb-col-summary') ||
             document.querySelector('aside[class*="glow-mb-summary"]') ||
             document.querySelector('aside[id*="glow-mb-summary"]');
    }

    function findBuilderMain() {
      return document.querySelector('.glow-mb-family-builder') ||
             document.querySelector('.glow-mb-col-builder') ||
             document.querySelector('main[class*="glow-mb-builder"]') ||
             document.querySelector('[class*="builder"]');
    }

    // ---------- Subscription Frequency panel ----------
    function buildFrequencyPanel() {
      var panel = document.createElement('div');
      panel.id = 'po-mb-frequency-panel';
      panel.style.cssText =
        'margin:0 0 16px;padding:18px;border:1px solid rgba(41,63,7,0.15);' +
        'border-radius:16px;background:#fff;font-family:Montserrat,Arial,sans-serif;';

      panel.innerHTML =
        '<div style="font-weight:900;color:#293f07;font-size:13px;margin-bottom:10px;' +
        'text-transform:uppercase;letter-spacing:0.06em;">Subscription Frequency</div>' +

        '<label style="display:flex;align-items:center;gap:8px;margin-bottom:8px;font-size:14px;color:#293f07;cursor:pointer;">' +
        '<input type="radio" name="po-mb-frequency" value="Weekly" checked> <span>Weekly Subscription</span>' +
        '</label>' +

        '<label style="display:flex;align-items:center;gap:8px;margin-bottom:6px;font-size:14px;color:#293f07;cursor:pointer;">' +
        '<input type="radio" name="po-mb-frequency" value="Monthly"> ' +
        '<span>Monthly Subscription <span style="color:#e07a1f;font-weight:800;font-size:11px;">— 10% off (Ongoing)</span></span>' +
        '</label>' +

        '<p style="margin:10px 0 0;font-size:11px;color:rgba(41,63,7,0.6);line-height:1.4;">' +
        'Welcome offers cannot be combined with any ongoing offers.' +
        '</p>';

      return panel;
    }

    function getSelectedFrequency() {
      var checked = document.querySelector('input[name="po-mb-frequency"]:checked');
      return checked ? checked.value : 'Weekly';
    }

    function trySetNativeSellingPlan(freq) {
      try {
        document.querySelectorAll('select[name="selling_plan"], select[id*="selling-plan" i], select[id*="selling_plan" i]')
          .forEach(function (sel) {
            var opt = Array.prototype.filter.call(sel.options, function (o) {
              return new RegExp(freq, 'i').test(o.textContent);
            })[0];
            if (opt && sel.value !== opt.value) {
              sel.value = opt.value;
              sel.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });

        document.querySelectorAll('input[name*="selling_plan" i], input[data-selling-plan]')
          .forEach(function (r) {
            var label = r.closest('label') || r.parentElement;
            if (label && new RegExp(freq, 'i').test(label.textContent) && !r.checked) {
              r.checked = true;
              r.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
      } catch (e) {
        console.warn('PO Meal Box: trySetNativeSellingPlan error', e);
      }
    }

    function ensureFrequencyPanel(aside) {
      if (document.getElementById('po-mb-frequency-panel')) return;
      var panel = buildFrequencyPanel();
      aside.insertBefore(panel, aside.firstChild);

      panel.querySelectorAll('input[name="po-mb-frequency"]').forEach(function (r) {
        r.addEventListener('change', function () {
          trySetNativeSellingPlan(r.value);
          computeAndSetTotal(aside);
          syncCartAttributes();
        });
      });
    }

    function fixDeliveryLabel(aside) {
      var freeEl = findByText(aside, /^free$/i);
      if (freeEl) {
        var row = freeEl.closest('div,li,tr,p') || freeEl.parentElement;
        if (row && /delivery/i.test(row.textContent)) {
          freeEl.textContent = '$' + DELIVERY_FEE.toFixed(2);
        }
      }
    }

    function fixFamilyAddonDescOrange(builder) {
      if (!builder) return;
      var descs = builder.querySelectorAll('.glow-mb-plan-desc');
      if (!descs.length) {
        var all = builder.querySelectorAll('*');
        descs = [];
        for (var i = 0; i < all.length; i++) {
          if (all[i].children.length === 0 && /10%\s*off\s*add-ons/i.test(all[i].textContent)) {
            descs.push(all[i]);
          }
        }
      }
      descs.forEach(function (el) {
        if (el.querySelector && el.querySelector('.po-mb-addon-ongoing')) return;
        if (!/10%\s*off\s*add-ons/i.test(el.innerHTML)) return;
        if (/\(ongoing\)/i.test(el.innerHTML)) return;
        el.innerHTML = el.innerHTML.replace(
          /10%\s*off\s*add-ons/i,
          '<span class="po-mb-addon-ongoing" style="color:#e07a1f;font-weight:800;">10% off add-ons (ongoing)</span>'
        );
      });
    }

    function fixAddonPlanLabel(root) {
      if (addonPlanLabelFixed) return;
      if (!root) return;
      var all = root.querySelectorAll('*');
      for (var i = 0; i < all.length; i++) {
        var el = all[i];
        if (el.children.length === 0 && /^10%\s*off\s*with\s*your\s*plan$/i.test(el.textContent.trim())) {
          el.textContent = '10% off with your family plan';
          addonPlanLabelFixed = true;
          break;
        }
      }
    }

    function ensureDiscountRow(aside, subtotalRow) {
      var row = document.getElementById('po-mb-discount-row');
      if (!row) {
        row = document.createElement('div');
        row.id = 'po-mb-discount-row';
        row.style.cssText = 'display:flex;justify-content:space-between;align-items:center;' +
          'font-family:Montserrat,Arial,sans-serif;font-size:13px;color:#c0392b;font-weight:700;' +
          'padding:6px 0;';
        subtotalRow.parentNode.insertBefore(row, subtotalRow.nextSibling);
      }
      return row;
    }

    function computeDiscountAmount(subtotal, freq) {
      var rate = 0;
      var labels = [];
      if (freq === 'Monthly') {
        rate += MONTHLY_DISCOUNT_RATE;
        labels.push('Monthly 10% (Ongoing)');
      }
      return { amount: subtotal * rate, label: labels.join(' + ') };
    }

    function overrideShopifyRecurringText(amount, frequency) {
      var freqLabel = (frequency && frequency.toLowerCase().indexOf('month') !== -1) ? 'every month' : 'every week';
      var formattedAmount = '$' + amount.toFixed(2);

      var recurringEls = document.querySelectorAll('[class*="recurring"], [id*="recurring"], p, span');
      recurringEls.forEach(function(el) {
        if (el.children.length === 0 && el.textContent.toLowerCase().includes('recurring subtotal')) {
          el.textContent = 'Recurring total: ' + formattedAmount + ' ' + freqLabel;
        }
      });
    }

    function computeAndSetTotal(aside) {
      try {
        var subtotalLabel = getAsideLabel(aside, 'subtotalLabel', /^subtotal$/i);
        var deliveryLabel = getAsideLabel(aside, 'deliveryLabel', /^delivery$/i) ||
                            getAsideLabel(aside, 'shippingLabel', /^shipping$/i);
        var addonsLabel   = getAsideLabel(aside, 'addonsLabel', /^add-ons$/i);
        var totalLabel    = getAsideLabel(aside, 'totalLabel', /^total\s*\/\s*week$/i) ||
                            getAsideLabel(aside, 'totalLabel', /^total$/i);

        if (!subtotalLabel || !totalLabel) return;

        var subtotalRow = subtotalLabel.closest('div,li,tr,p') || subtotalLabel.parentElement;
        var totalRow    = totalLabel.closest('div,li,tr,p') || totalLabel.parentElement;

        var subtotalValueEl = findMoneyLeaf(subtotalRow, subtotalLabel);
        var totalValueEl    = findMoneyLeaf(totalRow, totalLabel);

        if (!subtotalValueEl || !totalValueEl) return;

        var subtotal = parseMoney(subtotalValueEl.textContent);
        
        var delivery = DELIVERY_FEE;
        if (deliveryLabel) {
          var deliveryRow = deliveryLabel.closest('div,li,tr,p') || deliveryLabel.parentElement;
          var deliveryValueEl = findMoneyLeaf(deliveryRow, deliveryLabel);
          if (deliveryValueEl) delivery = parseMoney(deliveryValueEl.textContent);
        }

        var addons = 0;
        if (addonsLabel) {
          var addonsRow = addonsLabel.closest('div,li,tr,p') || addonsLabel.parentElement;
          var addonsValueEl = findMoneyLeaf(addonsRow, addonsLabel);
          if (addonsValueEl) addons = parseMoney(addonsValueEl.textContent);
        }

        var freq = getSelectedFrequency();
        var discount = computeDiscountAmount(subtotal, freq);

        var discountRow = ensureDiscountRow(aside, subtotalRow);
        var discountText = discount.amount > 0
          ? '<span>Discount (' + discount.label + ')</span><span>-$' + discount.amount.toFixed(2) + '</span>'
          : '';
        if (discount.amount > 0) {
          discountRow.style.display = 'flex';
          if (discountRow.innerHTML !== discountText) discountRow.innerHTML = discountText;
        } else {
          if (discountRow.style.display !== 'none') discountRow.style.display = 'none';
        }

        var newTotal = (subtotal - discount.amount) + addons + delivery;
        var newText = '$' + newTotal.toFixed(2);
        if (totalValueEl.textContent.trim() !== newText) {
          totalValueEl.textContent = newText;
        }

        overrideShopifyRecurringText(newTotal, freq);

        var note = document.getElementById('po-mb-total-note');
        if (!note) {
          note = document.createElement('p');
          note.id = 'po-mb-total-note';
          note.style.cssText = 'margin:4px 0 0;font-size:10px;color:rgba(41,63,7,0.55);font-family:Montserrat,Arial,sans-serif;';
          totalRow.parentNode.insertBefore(note, totalRow.nextSibling);
        }
        var freqLabel = (freq && freq.toLowerCase().indexOf('month') !== -1) ? 'every month' : 'every week';
        note.textContent = 'Recurring total (incl. shipping & discounts): ' + newText + ' ' + freqLabel;

      } catch (e) {
        console.warn('PO Meal Box: computeAndSetTotal error', e);
      }
    }

    // ---------- Food Allergies panel ----------
    function buildAllergyPanel() {
      var panel = document.createElement('div');
      panel.id = 'po-mb-extra-panel';
      panel.style.cssText =
        'margin:16px 0;padding:18px;border:1px solid rgba(41,63,7,0.15);' +
        'border-radius:16px;background:#fff;font-family:Montserrat,Arial,sans-serif;';

      panel.innerHTML =
        '<div style="font-weight:900;color:#293f07;font-size:13px;margin-bottom:10px;' +
        'text-transform:uppercase;letter-spacing:0.06em;">Food Allergies</div>' +
        '<p style="margin:0 0 8px;font-size:13px;color:#293f07;font-weight:700;">Do you have any food allergies?</p>' +
        '<label style="display:flex;align-items:flex-start;gap:8px;margin-bottom:8px;font-size:14px;color:#293f07;cursor:pointer;">' +
        '<input type="radio" name="po-mb-has-allergies" value="No" style="margin-top:3px;"> <span>No food allergies</span>' +
        '</label>' +
        '<label style="display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;font-size:14px;color:#293f07;cursor:pointer;">' +
        '<input type="radio" name="po-mb-has-allergies" value="Yes" style="margin-top:3px;"> <span>Yes — please list your food allergies below:</span>' +
        '</label>' +
        '<div id="po-mb-allergy-detail-wrap" style="display:none;margin-bottom:14px;">' +
        '<label style="display:block;font-size:12px;font-weight:800;color:#293f07;margin-bottom:6px;">Allergies:</label>' +
        '<textarea id="po-mb-allergies" rows="3" placeholder="Please list your allergies..." ' +
        'style="width:100%;padding:10px;border:1px solid rgba(41,63,7,0.2);border-radius:10px;' +
        'font-family:inherit;font-size:13px;resize:vertical;box-sizing:border-box;"></textarea>' +
        '</div>' +
