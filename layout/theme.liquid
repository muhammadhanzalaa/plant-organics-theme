        '<option value="All" style="color:#293f07;">All</option>' +
        '</select>' +
        '</div>';

      return panel;
    }

    function addSubscriptionDisclaimer() {
      if (document.getElementById('po-mb-sub-disclaimer')) return;
      var builder = findBuilderMain();
      var addOnsHeading = builder && findByText(builder, /^add-ons$/i);
      if (!addOnsHeading) return;

      var box = document.createElement('p');
      box.id = 'po-mb-sub-disclaimer';
      box.style.cssText = 'margin:14px 0;font-size:11px;color:rgba(41,63,7,0.75);line-height:1.5;font-family:Montserrat,Arial,sans-serif;';
      box.innerHTML =
        'Your cart contains an automatically renewing subscription. By clicking "Pay now," you expressly and affirmatively agree ' +
        'that you will be automatically charged the recurring amount(s) shown in your cart (plus shipping and taxes) until the ' +
        'subscription(s) ends or you cancel. You may cancel anytime by going to your account or contacting the store at ' +
        '<a href="mailto:feedme@plant-organics.com" style="color:#293f07;">feedme@plant-organics.com</a>. Please see the ' +
        '<a href="/policies/subscription-policy" style="color:#293f07;text-decoration:underline;">cancellation policy</a>.';

      addOnsHeading.parentNode.insertBefore(box, addOnsHeading.nextSibling);
    }

    function insertAllergyPanel(aside, panel) {
      var orderHeading = findByText(aside, /^your order$/i);
      if (orderHeading) {
        aside.insertBefore(panel, orderHeading.closest('div') || orderHeading);
      } else {
        aside.appendChild(panel);
      }
    }

    // ---------- allergy-required gate ----------
    function bindAllergyGuard() {
      if (allergyGuardBound) return;
      allergyGuardBound = true;

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('button, a');
        if (!btn) return;
        var txt = (btn.textContent || '').trim();
        if (!/continue to add-ons|review\s*&\s*checkout/i.test(txt)) return;

        var hasAllergiesEl = document.querySelector('input[name="po-mb-has-allergies"]:checked');
        if (!hasAllergiesEl) {
          e.preventDefault();
          e.stopImmediatePropagation();
          e.stopPropagation();

          var panel = document.getElementById('po-mb-extra-panel');
          if (panel) {
            panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
            panel.style.outline = '2px solid #c0392b';
            setTimeout(function () { panel.style.outline = 'none'; }, 2500);
          }
          window.alert('Please select Yes or No for Food Allergies before continuing.');
        }
      }, true);
    }

    // ---------- v12: dietary-required gate ----------
    function bindDietaryGuard() {
      if (dietaryGuardBound) return;
      dietaryGuardBound = true;

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('button, a');
        if (!btn) return;
        var txt = (btn.textContent || '').trim();
        if (!/continue to add-ons|review\s*&\s*checkout/i.test(txt)) return;

        var dietarySelect = document.getElementById('po-mb-dietary-select');
        if (dietarySelect && (!dietarySelect.value || dietarySelect.value === '')) {
          e.preventDefault();
          e.stopImmediatePropagation();
          e.stopPropagation();

          dietarySelect.scrollIntoView({ behavior: 'smooth', block: 'center' });
          dietarySelect.style.outline = '2px solid #c0392b';
          dietarySelect.focus();
          setTimeout(function () { dietarySelect.style.outline = 'none'; }, 2500);

          window.alert('Please select your Dietary Preference before continuing.');
        }
      }, true);
    }

    // ---------- Per-category weight cap enforcement ----------
    function findQtyValueEl(stepper) {
      var kids = stepper.children;
      for (var i = 0; i < kids.length; i++) {
        if (kids[i].tagName !== 'BUTTON' && /^\d+$/.test(kids[i].textContent.trim())) {
          return kids[i];
        }
      }
      return null;
    }

    function getItemWeight(itemEl) {
      var m = itemEl.textContent.match(/([\d.]+)\s*lb/i);
      return m ? parseFloat(m[1]) : 1;
    }

    function getSectionCap(section) {
      var reqEl = section.querySelector('.glow-mb-family-required');
      var text = reqEl ? reqEl.textContent :
        ((section.querySelector('.glow-mb-family-section-title') || {}).textContent || '');
      var m = text.match(/([\d.]+)\s*lbs?/i);
      return m ? parseFloat(m[1]) : null;
    }

    function getSectionCurrentTotal(section) {
      var total = 0;
      var items = section.querySelectorAll('.glow-mb-family-item');
      items.forEach(function (item) {
        var stepper = item.querySelector('.glow-mb-qty-stepper');
        if (!stepper) return;
        var valEl = findQtyValueEl(stepper);
        var qty = valEl ? (parseInt(valEl.textContent.trim(), 10) || 0) : 0;
        total += qty * getItemWeight(item);
      });
      return total;
    }

    function bindCategoryCapGuard() {
      if (categoryCapGuardBound) return;
      categoryCapGuardBound = true;

      document.addEventListener('click', function (e) {
        var stepper = e.target.closest('.glow-mb-qty-stepper');
        if (!stepper) return;

        var buttons = stepper.querySelectorAll('button');
        if (!buttons.length) return;
        var plusBtn = buttons[buttons.length - 1];
        if (e.target !== plusBtn && !plusBtn.contains(e.target)) return;

        var section = stepper.closest('.glow-mb-family-section');
        if (!section) return;

        var cap = getSectionCap(section);
        if (cap === null) return;

        var currentTotal = getSectionCurrentTotal(section);
        var item = stepper.closest('.glow-mb-family-item');
        var weight = item ? getItemWeight(item) : 1;

        if (currentTotal + weight > cap + 0.001) {
          e.preventDefault();
          e.stopImmediatePropagation();
          e.stopPropagation();

          section.style.outline = '2px solid #c0392b';
          section.style.transition = 'outline-color 0.2s';
          setTimeout(function () { section.style.outline = 'none'; }, 900);
        }
      }, true);
    }

    // ---------- Modal step history & Navigation ----------
    function findStepsNav() {
      return document.querySelector('nav.glow-mb-steps') ||
             document.querySelector('nav[aria-label="Builder steps" i]');
    }

    function isModalOpen() {
      return !!findStepsNav();
    }

    function findModalWindow() {
      return document.querySelector('[class*="glow-mb-window"]');
    }

    function getActiveStepNumber() {
      var win = findModalWindow();
      if (win) {
        var m = win.className.match(/is-step-(\d+)/);
        if (m) return parseInt(m[1], 10);
      }
      var nav = findStepsNav();
      if (nav) {
        var activeBtn = nav.querySelector('.glow-mb-step.active, .glow-mb-step[aria-current="step"]');
        if (activeBtn && activeBtn.id) {
          var idMatch = activeBtn.id.match(/glow-mb-step(\d+)-/);
          if (idMatch) return parseInt(idMatch[1], 10);
        }
      }
      return null;
    }

    function findStepButton(stepNumber) {
      var nav = findStepsNav();
      if (!nav) return null;
      var btns = nav.querySelectorAll('.glow-mb-step');
      for (var i = 0; i < btns.length; i++) {
        if (btns[i].id && new RegExp('glow-mb-step' + stepNumber + '-').test(btns[i].id)) {
          return btns[i];
        }
      }
      return null;
    }

    function goToStep(stepNumber) {
      isSyncingHistory = true;
      try {
        var btn = findStepButton(stepNumber);
        if (btn) btn.click();
      } catch (e) {
        console.warn('PO Meal Box: goToStep error', e);
      } finally {
        setTimeout(function () { isSyncingHistory = false; }, 300);
      }
    }

    function saveStepToSession(step) {
      try { sessionStorage.setItem(STORAGE_KEY, String(step)); } catch (e) {}
    }

    function readStepFromSession() {
      try {
        var v = sessionStorage.getItem(STORAGE_KEY);
        var n = v ? parseInt(v, 10) : null;
        return (n && n >= 1 && n <= 4) ? n : null;
      } catch (e) {
        return null;
      }
    }

    function trackStepHistory() {
      if (isSyncingHistory) return;
      if (!isModalOpen()) return;

      var step = getActiveStepNumber();
      if (!step) return;

      if (step >= 2 && step <= 4 && step !== lastPushedStepKey) {
        try {
          window.history.pushState({ poMbStep: step }, '', window.location.href);
        } catch (e) {
          console.warn('PO Meal Box: pushState error', e);
        }
        lastPushedStepKey = step;
        saveStepToSession(step);
      } else if (step === 1) {
        lastPushedStepKey = 1;
        saveStepToSession(1);
      }
    }

    function bindHistoryGuard() {
      if (historyGuardBound) return;
      historyGuardBound = true;

      window.addEventListener('popstate', function (e) {
        if (!isModalOpen()) return;

        var targetStep = (e.state && e.state.poMbStep) ? e.state.poMbStep : 1;
        lastPushedStepKey = targetStep;
        goToStep(targetStep);
      });
    }

    function isBackForwardNavigation() {
      try {
        var navEntries = performance.getEntriesByType && performance.getEntriesByType('navigation');
        if (navEntries && navEntries[0] && navEntries[0].type) {
          return navEntries[0].type === 'back_forward';
        }
        if (performance.navigation) {
          return performance.navigation.type === 2;
        }
      } catch (e) {}
      return false;
    }

    function tryRestoreStepAfterBackNav() {
      if (restoreAttempted) return;
      if (!isBackForwardNavigation()) { restoreAttempted = true; return; }

      var savedStep = readStepFromSession();
      if (!savedStep || savedStep <= 1) { restoreAttempted = true; return; }

      var attempts = 0;
      restorePollTimer = setInterval(function () {
        attempts++;
        if (isModalOpen()) {
          clearInterval(restorePollTimer);
          restoreAttempted = true;
          lastPushedStepKey = savedStep;
          goToStep(savedStep);
        } else if (attempts > 40) {
          clearInterval(restorePollTimer);
          restoreAttempted = true;
        }
      }, 100);
    }

    function bindBackButtonGuard() {
      if (backButtonGuardBound) return;
      backButtonGuardBound = true;

      document.addEventListener('click', function (e) {
        if (!isModalOpen()) return;

        var btn = e.target.closest('button, a');
        if (!btn) return;
        var txt = (btn.textContent || '').trim();
        if (!/^back$/i.test(txt)) return;

        var current = getActiveStepNumber();
        if (!current || current <= 1) return;

        e.preventDefault();
        e.stopImmediatePropagation();
        e.stopPropagation();

        goToStep(current - 1);
      }, true);
    }

    // ---------- main init ----------
    function initGlowMbExtras() {
      try {
        var aside = findSummaryAside();
        var builder = findBuilderMain();
        if (!aside) return;

        ensureFrequencyPanel(aside);
        fixDeliveryLabel(aside);
        addSubscriptionDisclaimer();
        fixFamilyAddonDescOrange(document);
        fixAddonPlanLabel(document);

        if (!document.getElementById('po-mb-extra-panel')) {
          var panel = buildAllergyPanel();
          insertAllergyPanel(aside, panel);

          var detailWrap = document.getElementById('po-mb-allergy-detail-wrap');
          panel.querySelectorAll('input[name="po-mb-has-allergies"]').forEach(function (el) {
            el.addEventListener('change', function () {
              detailWrap.style.display = (el.value === 'Yes' && el.checked) ? 'block' : 'none';
              syncCartAttributes();
            });
          });

          var allergiesInput = document.getElementById('po-mb-allergies');
          if (allergiesInput) allergiesInput.addEventListener('blur', syncCartAttributes);

          var dietarySelect = document.getElementById('po-mb-dietary-select');
          if (dietarySelect) dietarySelect.addEventListener('change', syncCartAttributes);
        }

        computeAndSetTotal(aside);
        trackStepHistory();
        tryRestoreStepAfterBackNav();
        syncCartAttributes();
      } catch (e) {
        console.warn('PO Meal Box: initGlowMbExtras error', e);
      }
    }

    function syncCartAttributes() {
      try {
        var freq = getSelectedFrequency();
        var hasAllergiesEl = document.querySelector('input[name="po-mb-has-allergies"]:checked');
        var allergiesEl = document.getElementById('po-mb-allergies');
        var dietarySelectEl = document.getElementById('po-mb-dietary-select');

        originalFetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            attributes: {
              'Subscription Frequency': freq,
              'Food Allergies': hasAllergiesEl ? hasAllergiesEl.value : '',
              'Allergies List': (hasAllergiesEl && hasAllergiesEl.value === 'Yes' && allergiesEl) ? allergiesEl.value : '',
              'Dietary Preference': dietarySelectEl ? dietarySelectEl.value : ''
            }
          })
        }).catch(function (err) {
          console.warn('PO Meal Box: could not sync cart attributes', err);
        });
      } catch (e) {
        console.warn('PO Meal Box: syncCartAttributes error', e);
      }
    }

    // ---------- DEBOUNCED observer ----------
    function safeInit() {
      if (isProcessing) return;
      isProcessing = true;
      if (observer) observer.disconnect();
      try {
        initGlowMbExtras();
      } finally {
        isProcessing = false;
        if (observer) {
          observer.observe(document.body, { childList: true, subtree: true });
        }
      }
    }

    function scheduleInit() {
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(safeInit, 80);
    }

    function isRelevantMutationBatch(mutations) {
      var win = findModalWindow();
      if (!win) return true;
      for (var i = 0; i < mutations.length; i++) {
        if (win.contains(mutations[i].target)) return true;
      }
      return false;
    }

    bindAllergyGuard();
    bindDietaryGuard(); // v12
    bindHistoryGuard();
    bindBackButtonGuard();
    bindCategoryCapGuard();
    safeInit();
    observer = new MutationObserver(function (mutations) {
      if (!isRelevantMutationBatch(mutations)) return;
      scheduleInit();
    });
    observer.observe(document.body, { childList: true, subtree: true });
  } catch (e) {
    console.warn('PO Meal Box: script init error', e);
  }
})();
</script>








































