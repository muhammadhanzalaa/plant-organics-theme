    <span style="font-size: 16px; font-weight: bold;">✕</span>
  </button>
  <div id="wmModalContent"></div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const modal = document.getElementById("weeklyMenuModal");
    const closeBtn = document.getElementById("closeWmModal");
    const contentDiv = document.getElementById("wmModalContent");
    let cachedMenuHtml = ""; // Background pre-fetched content

    // STEP 1: Pre-fetch menu content instantly in background
    fetch("/collections/weekly-menu")
      .then(res => res.text())
      .then(html => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const mainContent = doc.querySelector('main') || doc.querySelector('#MainContent') || doc.body;
        cachedMenuHtml = mainContent.innerHTML;
      })
      .catch(err => console.log("Menu pre-fetch error:", err));

    // STEP 2: Instant click handler
    window.addEventListener("click", function(e) {
      const targetBtn = e.target.closest("a, button");
      
      if (targetBtn && targetBtn.textContent.trim().toLowerCase() === "view menu") {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();

        // If pre-fetched data ready, load instantly. Otherwise fetch live.
        if (cachedMenuHtml) {
          contentDiv.innerHTML = cachedMenuHtml;
        } else {
          contentDiv.innerHTML = "<div style='text-align:center; padding:100px;'>Loading menu...</div>";
          fetch(targetBtn.getAttribute("href") || "/collections/weekly-menu")
            .then(res => res.text())
            .then(html => {
              const parser = new DOMParser();
              const doc = parser.parseFromString(html, 'text/html');
              const mainContent = doc.querySelector('main') || doc.querySelector('#MainContent') || doc.body;
              contentDiv.innerHTML = mainContent.innerHTML;
            });
        }

        modal.style.display = "block";
        document.body.appendChild(modal);
        document.body.style.overflow = "hidden"; // Freeze background page

        return false;
      }
    }, true);

    // STEP 3: Close button handler
    closeBtn.addEventListener("click", function() {
      modal.style.display = "none";
      document.body.style.overflow = "auto";
    });
  });
</script>


















