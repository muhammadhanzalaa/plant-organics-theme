<!-- Permanent Cart Hide & Instant Redirect -->
<style>
  /* Page load hone se pehle hi Icon aur Cart Links permanent hide */
  a[href*="/cart"],
  .header__icon--cart,
  .site-header__cart,
  #cart-icon-bubble,
  cart-drawer,
  .cart-drawer,
  #CartDrawer,
  header .cart-link {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>

<script>
  // Page load hone se pehle hi redirect execution
  if (window.location.pathname.includes('/cart')) {
    window.location.replace('/');
  }
</script>















