        '<select id="po-mb-dietary-select" name="properties[Dietary Preference]" required style="width:100%;padding:10px;' +
        'border:1px solid #c0392b;border-radius:8px;font-family:inherit;font-size:13px;font-weight:700;' +
        'color:#c0392b;background:#fff;cursor:pointer;box-sizing:border-box;">' +
        '<option value="" disabled selected>PLEASE SELECT</option>' +
        '<option value="Vegan" style="color:#293f07;">Vegan</option>' +
        '<option value="Vegetarian" style="color:#293f07;">Vegetarian</option>' +
