{% doc %}
  @prompt
    I want you to create a new product grid. this product grid should be same as the existing one but i should have he control over the tag and i should be able to choose the tags/collection for the filter and then I need you to give the control for the cta button color and texts for all the buttons at once, it is missing the filter on the left side please add it in the left side
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    display: block;
  }

  .ai-product-grid__wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: 40px;
  }

  .ai-product-grid__sidebar-{{ ai_gen_id }} {
    width: {{ block.settings.sidebar_width }}px;
    flex-shrink: 0;
  }

  .ai-product-grid__main-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-product-grid__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-product-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
  }

  .ai-product-grid__filter-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.filter_title_size }}px;
    color: {{ block.settings.filter_title_color }};
    margin: 0 0 20px;
    font-weight: 600;
  }

  .ai-product-grid__filters-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-product-grid__filter-btn-{{ ai_gen_id }} {
    padding: 12px 20px;
    background-color: {{ block.settings.filter_bg_color }};
    color: {{ block.settings.filter_text_color }};
    border: 1px solid {{ block.settings.filter_border_color }};
    border-radius: {{ block.settings.filter_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
    text-align: left;
    width: 100%;
  }

  .ai-product-grid__filter-btn-{{ ai_gen_id }}:hover,
  .ai-product-grid__filter-btn-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.filter_active_bg_color }};
    color: {{ block.settings.filter_active_text_color }};
    border-color: {{ block.settings.filter_active_bg_color }};
  }

  .ai-product-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: 32px;
  }

  .ai-product-grid__item-{{ ai_gen_id }} {
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-product-grid__item-{{ ai_gen_id }}.visible {
    display: block;
    opacity: 1;
  }

  .ai-product-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: {{ block.settings.image_bg_color }};
    margin-bottom: 12px;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-grid__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-grid__info-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-product-grid__vendor-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.vendor_color }};
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .ai-product-grid__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 500;
  }

  .ai-product-grid__product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-grid__product-title-{{ ai_gen_id }} a:hover {
    opacity: 0.7;
  }

  .ai-product-grid__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin-bottom: 12px;
  }

  .ai-product-grid__price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 8px;
  }

  .ai-product-grid__cta-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.cta_bg_color }};
    color: {{ block.settings.cta_text_color }};
    border: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    cursor: pointer;
    font-size: {{ block.settings.cta_font_size }}px;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
    width: 100%;
  }

  .ai-product-grid__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_bg_color }};
    color: {{ block.settings.cta_hover_text_color }};
  }

  .ai-product-grid__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    display: none;
  }

  .ai-product-grid__empty-{{ ai_gen_id }}.visible {
    display: block;
  }

  @media screen and (max-width: 989px) {
    .ai-product-grid__wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 30px;
    }

    .ai-product-grid__sidebar-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-product-grid__filters-{{ ai_gen_id }} {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .ai-product-grid__filter-btn-{{ ai_gen_id }} {
      width: auto;
      flex: 1;
      min-width: 120px;
    }

    .ai-product-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.products_per_row_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-product-grid__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-product-grid__filter-btn-{{ ai_gen_id }} {
      min-width: 100px;
      font-size: 12px;
      padding: 10px 16px;
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_heading %}
    <div class="ai-product-grid__header-{{ ai_gen_id }}">
      <h2 class="ai-product-grid__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="ai-product-grid__wrapper-{{ ai_gen_id }}">
    {% if block.settings.enable_filtering %}
      <div class="ai-product-grid__sidebar-{{ ai_gen_id }}">
        <h3 class="ai-product-grid__filter-title-{{ ai_gen_id }}">{{ block.settings.filter_section_title }}</h3>
        <div class="ai-product-grid__filters-{{ ai_gen_id }}">
          <button class="ai-product-grid__filter-btn-{{ ai_gen_id }} active" data-filter="all">
            {{ block.settings.all_filter_text }}
          </button>
          {% if block.settings.filter_1_tag != blank %}
            <button class="ai-product-grid__filter-btn-{{ ai_gen_id }}" data-filter="{{ block.settings.filter_1_tag }}">
              {{ block.settings.filter_1_label }}
            </button>
          {% endif %}
          {% if block.settings.filter_2_tag != blank %}
            <button class="ai-product-grid__filter-btn-{{ ai_gen_id }}" data-filter="{{ block.settings.filter_2_tag }}">
              {{ block.settings.filter_2_label }}
            </button>
          {% endif %}
          {% if block.settings.filter_3_tag != blank %}
            <button class="ai-product-grid__filter-btn-{{ ai_gen_id }}" data-filter="{{ block.settings.filter_3_tag }}">
              {{ block.settings.filter_3_label }}
            </button>
          {% endif %}
          {% if block.settings.filter_4_tag != blank %}
            <button class="ai-product-grid__filter-btn-{{ ai_gen_id }}" data-filter="{{ block.settings.filter_4_tag }}">
              {{ block.settings.filter_4_label }}
            </button>
          {% endif %}
          {% if block.settings.filter_5_tag != blank %}
            <button class="ai-product-grid__filter-btn-{{ ai_gen_id }}" data-filter="{{ block.settings.filter_5_tag }}">
              {{ block.settings.filter_5_label }}
            </button>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="ai-product-grid__main-{{ ai_gen_id }}">
      <div class="ai-product-grid__container-{{ ai_gen_id }}">
        {% if block.settings.source_collection != blank %}
          {% assign source_products = block.settings.source_collection.products %}
        {% else %}
          {% assign source_products = collections.all.products %}
        {% endif %}

        {% for product in source_products limit: block.settings.products_limit %}
          {% assign product_tags = product.tags | join: ',' %}
          <div class="ai-product-grid__item-{{ ai_gen_id }} visible" data-tags="{{ product_tags }}">
            <div class="ai-product-grid__image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-grid__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-product-grid__image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-product-grid__info-{{ ai_gen_id }}">
              {% if block.settings.show_vendor and product.vendor != blank %}
                <div class="ai-product-grid__vendor-{{ ai_gen_id }}">{{ product.vendor }}</div>
              {% endif %}

              <h3 class="ai-product-grid__product-title-{{ ai_gen_id }}">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              {% if block.settings.show_price %}
                <div class="ai-product-grid__price-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-product-grid__price-compare-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                  <span>{{ product.price | money }}</span>
                </div>
              {% endif %}

              <a href="{{ product.url }}" class="ai-product-grid__cta-{{ ai_gen_id }}">
                {{ block.settings.cta_text }}
              </a>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="ai-product-grid__empty-{{ ai_gen_id }}">
        {{ block.settings.no_products_message }}
      </div>
    </div>
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.filterButtons = this.querySelectorAll('.ai-product-grid__filter-btn-{{ ai_gen_id }}');
        this.productItems = this.querySelectorAll('.ai-product-grid__item-{{ ai_gen_id }}');
        this.emptyState = this.querySelector('.ai-product-grid__empty-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupFilters();
      }

      setupFilters() {
        this.filterButtons.forEach(button => {
          button.addEventListener('click', () => {
            const filterValue = button.getAttribute('data-filter');
            
            this.filterButtons.forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');
            
            this.filterProducts(filterValue);
          });
        });
      }

      filterProducts(filterValue) {
        let visibleCount = 0;

        this.productItems.forEach(item => {
          const productTags = item.getAttribute('data-tags');
          
          if (filterValue === 'all' || productTags.includes(filterValue)) {
            item.classList.add('visible');
            visibleCount++;
          } else {
            item.classList.remove('visible');
          }
        });

        if (visibleCount === 0) {
          this.emptyState.classList.add('visible');
        } else {
          this.emptyState.classList.remove('visible');
        }
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

