    "custom_liquid_e7q6TE": {
      "type": "custom-liquid",
      "name": "Custom liquid",
      "settings": {
        "custom_liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n  .po-faq-luxe,\n  .po-faq-luxe * {\n    box-sizing: border-box;\n  }\n\n  .po-faq-luxe {\n    --po-page-width: 1280px;\n\n    /* Actual Brand Colors */\n    --po-pink: #fcb6eb;\n    --po-dark-green: #293f07;\n    --po-green: #95ad4f;\n    --po-orange: #ff960e;\n    --po-purple: #927ec3;\n    --po-white: #ffffff;\n\n    /* Brand Fonts */\n    --po-font-header-1: \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-header-2: \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-body: \"Montserrat\", Arial, sans-serif;\n\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    padding: 96px 0;\n    background:\n      radial-gradient(circle at 10% 8%, rgba(149, 173, 79, 0.18), transparent 30%),\n      radial-gradient(circle at 90% 12%, rgba(255, 150, 14, 0.1), transparent 28%),\n      radial-gradient(circle at 50% 100%, rgba(41, 63, 7, 0.045), transparent 34%),\n      var(--po-white);\n    color: var(--po-dark-green);\n    font-family: var(--po-font-body);\n  }\n\n  .po-faq-luxe::before {\n    content: \"\";\n    position: absolute;\n    inset: 24px;\n    border: 1px solid rgba(41, 63, 7, 0.1);\n    border-radius: 36px;\n    pointer-events: none;\n  }\n\n  .po-faq-luxe::after {\n    content: \"questions\";\n    position: absolute;\n    right: -18px;\n    bottom: -14px;\n    color: rgba(41, 63, 7, 0.045);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(76px, 11vw, 170px);\n    font-weight: 900;\n    line-height: 0.8;\n    letter-spacing: -0.07em;\n    white-space: nowrap;\n    pointer-events: none;\n  }\n\n  .po-faq-luxe__container {\n    width: min(var(--po-page-width), calc(100% - 32px));\n    margin: 0 auto;\n    position: relative;\n    z-index: 2;\n  }\n\n  .po-faq-luxe__head {\n    display: grid;\n    grid-template-columns: minmax(320px, 0.9fr) minmax(420px, 1.1fr);\n    gap: 64px;\n    align-items: end;\n    margin-bottom: 44px;\n  }\n\n  .po-faq-luxe__eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    width: fit-content;\n    background: rgba(149, 173, 79, 0.18);\n    color: var(--po-dark-green);\n    border: 1px solid rgba(149, 173, 79, 0.36);\n    border-radius: 999px;\n    padding: 10px 18px;\n    font-family: var(--po-font-header-2);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    margin-bottom: 18px;\n  }\n\n  .po-faq-luxe__eyebrow::before {\n    content: \"\";\n    width: 10px;\n    height: 10px;\n    border-radius: 999px;\n    background: var(--po-orange);\n    flex: 0 0 10px;\n  }\n\n  .po-faq-luxe__title {\n    margin: 0;\n    max-width: 760px;\n    color: var(--po-dark-green);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(44px, 5.2vw, 78px);\n    line-height: 0.94;\n    letter-spacing: -0.065em;\n    font-weight: 900;\n  }\n\n  .po-faq-luxe__title .accent {\n    color: var(--po-orange);\n    font-style: normal;\n    font-weight: 900;\n  }\n\n  .po-faq-luxe__intro {\n    margin: 0;\n    max-width: 650px;\n    color: rgba(41, 63, 7, 0.72);\n    font-family: var(--po-font-body);\n    font-size: clamp(16px, 1.35vw, 18px);\n    line-height: 1.68;\n    font-weight: 500;\n  }\n\n  .po-faq-luxe__layout {\n    display: grid;\n    grid-template-columns: minmax(270px, 0.34fr) minmax(0, 0.66fr);\n    gap: 24px;\n    align-items: start;\n  }\n\n  .po-faq-luxe__aside {\n    position: sticky;\n    top: 96px;\n    padding: 30px;\n    border-radius: 32px;\n    background:\n      radial-gradient(circle at top right, rgba(255, 150, 14, 0.18), transparent 38%),\n      linear-gradient(145deg, var(--po-dark-green) 0%, #203405 58%, #172603 100%);\n    color: var(--po-white);\n    box-shadow:\n      0 28px 70px rgba(41, 63, 7, 0.2),\n      inset 0 1px 0 rgba(255, 255, 255, 0.12);\n    overflow: hidden;\n  }\n\n  .po-faq-luxe__aside::after {\n    content: \"\";\n    position: absolute;\n    right: -70px;\n    bottom: -90px;\n    width: 210px;\n    height: 210px;\n    border-radius: 50%;\n    background: rgba(149, 173, 79, 0.16);\n    pointer-events: none;\n  }\n\n  .po-faq-luxe__aside h3 {\n    position: relative;\n    z-index: 1;\n    margin: 0;\n    color: var(--po-white);\n    font-family: var(--po-font-header-1);\n    font-size: 34px;\n    line-height: 0.98;\n    letter-spacing: -0.055em;\n    font-weight: 900;\n  }\n\n  .po-faq-luxe__aside h3 em {\n    color: var(--po-orange);\n    font-style: normal;\n    font-weight: 900;\n  }\n\n  .po-faq-luxe__aside p {\n    position: relative;\n    z-index: 1;\n    margin: 16px 0 0;\n    color: rgba(255, 255, 255, 0.74);\n    font-family: var(--po-font-body);\n    font-size: 15px;\n    line-height: 1.62;\n    font-weight: 500;\n  }\n\n  .po-faq-luxe__aside-list {\n    position: relative;\n    z-index: 1;\n    margin-top: 24px;\n    display: grid;\n    gap: 10px;\n  }\n\n  .po-faq-luxe__aside-pill {\n    min-height: 40px;\n    padding: 0 14px;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.085);\n    border: 1px solid rgba(255, 255, 255, 0.14);\n    color: rgba(255, 255, 255, 0.86);\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 800;\n  }\n\n  .po-faq-luxe__aside-pill::before {\n    content: \"✓\";\n    width: 18px;\n    height: 18px;\n    border-radius: 999px;\n    background: var(--po-orange);\n    color: var(--po-dark-green);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 11px;\n    font-weight: 950;\n    flex: 0 0 18px;\n  }\n\n  .po-faq-luxe__items {\n    display: grid;\n    gap: 12px;\n  }\n\n  .po-faq-luxe__item {\n    position: relative;\n    overflow: hidden;\n    border-radius: 24px;\n    background: var(--po-white);\n    border: 1px solid rgba(41, 63, 7, 0.12);\n    box-shadow:\n      inset 0 1px 0 rgba(255, 255, 255, 1),\n      0 18px 46px rgba(41, 63, 7, 0.08);\n    transition:\n      transform 0.28s ease,\n      border-color 0.28s ease,\n      box-shadow 0.28s ease;\n  }\n\n  .po-faq-luxe__item::before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    bottom: 0;\n    width: 5px;\n    background: var(--po-orange);\n    opacity: 0;\n    transition: opacity 0.28s ease;\n  }\n\n  .po-faq-luxe__item:nth-child(2n)::before {\n    background: var(--po-green);\n  }\n\n  .po-faq-luxe__item:nth-child(3n)::before {\n    background: var(--po-dark-green);\n  }\n\n  .po-faq-luxe__item:hover,\n  .po-faq-luxe__item.is-open {\n    transform: translateY(-3px);\n    border-color: rgba(149, 173, 79, 0.5);\n    box-shadow:\n      inset 0 1px 0 rgba(255, 255, 255, 1),\n      0 26px 64px rgba(41, 63, 7, 0.13);\n  }\n\n  .po-faq-luxe__item.is-open::before {\n    opacity: 1;\n  }\n\n  .po-faq-luxe__question {\n    width: 100%;\n    min-height: 72px;\n    padding: 22px 24px;\n    border: 0;\n    background: transparent;\n    color: var(--po-dark-green);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    text-align: left;\n    cursor: pointer;\n    font-family: var(--po-font-header-2);\n    font-size: clamp(18px, 2vw, 24px);\n    line-height: 1.16;\n    font-weight: 900;\n    letter-spacing: -0.04em;\n  }\n\n  .po-faq-luxe__icon {\n    width: 38px;\n    height: 38px;\n    border-radius: 999px;\n    background: var(--po-dark-green);\n    color: var(--po-white);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 38px;\n    transition:\n      background 0.24s ease,\n      color 0.24s ease,\n      transform 0.24s ease;\n  }\n\n  .po-faq-luxe__icon svg {\n    width: 18px;\n    height: 18px;\n    stroke-width: 2.4;\n    transition: transform 0.24s ease;\n  }\n\n  .po-faq-luxe__item.is-open .po-faq-luxe__icon {\n    background: var(--po-orange);\n    color: var(--po-dark-green);\n  }\n\n  .po-faq-luxe__item.is-open .po-faq-luxe__icon svg {\n    transform: rotate(180deg);\n  }\n\n  .po-faq-luxe__answer {\n    max-height: 0;\n    overflow: hidden;\n    padding: 0 24px;\n    color: rgba(41, 63, 7, 0.72);\n    font-family: var(--po-font-body);\n    font-size: 15.5px;\n    line-height: 1.68;\n    font-weight: 500;\n    transition:\n      max-height 0.32s ease,\n      padding 0.32s ease;\n  }\n\n  .po-faq-luxe__item.is-open .po-faq-luxe__answer {\n    max-height: 900px;\n    padding: 0 24px 24px;\n  }\n\n  .po-faq-luxe__answer ul {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: grid;\n    gap: 9px;\n  }\n\n  .po-faq-luxe__answer li {\n    position: relative;\n    padding-left: 24px;\n  }\n\n  .po-faq-luxe__answer li::before {\n    content: \"✓\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: var(--po-orange);\n    font-weight: 900;\n  }\n\n  .po-faq-luxe__answer p {\n    margin: 0 0 9px;\n  }\n\n  .po-faq-luxe__answer p:last-child {\n    margin-bottom: 0;\n  }\n\n  .po-faq-luxe__answer strong {\n    color: var(--po-dark-green);\n    font-weight: 900;\n  }\n\n  .po-faq-luxe__chips {\n    margin-top: 12px;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n\n  .po-faq-luxe__chip {\n    min-height: 32px;\n    display: inline-flex;\n    align-items: center;\n    padding: 0 12px;\n    border-radius: 999px;\n    background: rgba(149, 173, 79, 0.12);\n    border: 1px solid rgba(149, 173, 79, 0.22);\n    color: var(--po-dark-green);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 800;\n  }\n\n  .po-faq-luxe__timeline {\n    margin: 4px 0 0;\n    padding: 0;\n    list-style: none;\n    display: grid;\n    gap: 10px;\n  }\n\n  .po-faq-luxe__timeline li {\n    position: relative;\n    padding-left: 24px;\n  }\n\n  .po-faq-luxe__timeline li::before {\n    content: \"\";\n    position: absolute;\n    left: 6px;\n    top: 7px;\n    width: 8px;\n    height: 8px;\n    border-radius: 999px;\n    background: var(--po-green);\n  }\n\n  .po-faq-luxe__timeline strong {\n    display: block;\n    color: var(--po-dark-green);\n    font-weight: 900;\n  }\n\n  .po-faq-luxe__cta {\n    margin-top: 28px;\n    padding: 34px;\n    border-radius: 32px;\n    background: var(--po-white);\n    border: 1px solid rgba(41, 63, 7, 0.12);\n    box-shadow: 0 20px 52px rgba(41, 63, 7, 0.08);\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 18px;\n    align-items: center;\n  }\n\n  .po-faq-luxe__cta h3 {\n    margin: 0;\n    color: var(--po-dark-green);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(28px, 3vw, 42px);\n    line-height: 0.98;\n    letter-spacing: -0.055em;\n    font-weight: 900;\n  }\n\n  .po-faq-luxe__cta p {\n    margin: 10px 0 0;\n    max-width: 650px;\n    color: rgba(41, 63, 7, 0.72);\n    font-size: 15px;\n    line-height: 1.6;\n    font-weight: 500;\n  }\n\n  .po-faq-luxe__btn {\n    min-height: 52px;\n    padding: 0 24px;\n    border-radius: 999px;\n    background: var(--po-dark-green);\n    color: var(--po-white);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    text-decoration: none;\n    font-family: var(--po-font-header-2);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    white-space: nowrap;\n    box-shadow: 0 18px 38px rgba(41, 63, 7, 0.16);\n    transition:\n      transform 0.24s ease,\n      box-shadow 0.24s ease,\n      background 0.24s ease,\n      color 0.24s ease;\n  }\n\n  .po-faq-luxe__btn:hover {\n    transform: translateY(-2px);\n    background: var(--po-orange);\n    color: var(--po-dark-green);\n    box-shadow: 0 24px 48px rgba(255, 150, 14, 0.2);\n    text-decoration: none;\n  }\n\n  @media (max-width: 1080px) {\n    .po-faq-luxe {\n      padding: 76px 0;\n    }\n\n    .po-faq-luxe::before,\n    .po-faq-luxe::after {\n      display: none;\n    }\n\n    .po-faq-luxe__head {\n      grid-template-columns: 1fr;\n      gap: 20px;\n      margin-bottom: 34px;\n    }\n\n    .po-faq-luxe__title,\n    .po-faq-luxe__intro {\n      max-width: 780px;\n    }\n\n    .po-faq-luxe__layout {\n      grid-template-columns: 1fr;\n    }\n\n    .po-faq-luxe__aside {\n      position: relative;\n      top: auto;\n    }\n\n    .po-faq-luxe__aside-list {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n  }\n\n  @media (max-width: 720px) {\n    .po-faq-luxe {\n      padding: 62px 0;\n    }\n\n    .po-faq-luxe__container {\n      width: 100%;\n      padding: 0 16px;\n    }\n\n    .po-faq-luxe__eyebrow {\n      font-size: 10.5px;\n      margin-bottom: 14px;\n    }\n\n    .po-faq-luxe__title {\n      font-size: clamp(38px, 12vw, 52px);\n      line-height: 1;\n    }\n\n    .po-faq-luxe__intro {\n      font-size: 15.5px;\n      line-height: 1.58;\n    }\n\n    .po-faq-luxe__aside {\n      padding: 24px 20px;\n      border-radius: 26px;\n    }\n\n    .po-faq-luxe__aside h3 {\n      font-size: 30px;\n    }\n\n    .po-faq-luxe__aside-list {\n      grid-template-columns: 1fr;\n    }\n\n    .po-faq-luxe__item {\n      border-radius: 20px;\n    }\n\n    .po-faq-luxe__question {\n      min-height: 64px;\n      padding: 18px 16px;\n      font-size: 17px;\n    }\n\n    .po-faq-luxe__icon {\n      width: 34px;\n      height: 34px;\n      flex-basis: 34px;\n    }\n\n    .po-faq-luxe__answer {\n      padding: 0 16px;\n      font-size: 14.3px;\n      line-height: 1.58;\n    }\n\n    .po-faq-luxe__item.is-open .po-faq-luxe__answer {\n      padding: 0 16px 20px;\n      max-height: 1100px;\n    }\n\n    .po-faq-luxe__cta {\n      grid-template-columns: 1fr;\n      padding: 24px 20px;\n      border-radius: 24px;\n    }\n\n    .po-faq-luxe__btn {\n      width: 100%;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    function initPlantOrganicsFaqLuxe() {\n      var sections = document.querySelectorAll('.po-faq-luxe');\n\n      sections.forEach(function (section) {\n        if (!section || section.dataset.faqReady === 'true') return;\n\n        section.dataset.faqReady = 'true';\n\n        var items = section.querySelectorAll('.po-faq-luxe__item');\n\n        items.forEach(function (item) {\n          var button = item.querySelector('.po-faq-luxe__question');\n\n          if (!button) return;\n\n          button.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');\n\n          button.addEventListener('click', function (event) {\n            event.preventDefault();\n\n            var isOpen = item.classList.contains('is-open');\n\n            items.forEach(function (otherItem) {\n              var otherButton = otherItem.querySelector('.po-faq-luxe__question');\n\n              otherItem.classList.remove('is-open');\n\n              if (otherButton) {\n                otherButton.setAttribute('aria-expanded', 'false');\n              }\n            });\n\n            if (!isOpen) {\n              item.classList.add('is-open');\n              button.setAttribute('aria-expanded', 'true');\n            }\n          });\n        });\n      });\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initPlantOrganicsFaqLuxe);\n    } else {\n      initPlantOrganicsFaqLuxe();\n    }\n\n    document.addEventListener('shopify:section:load', initPlantOrganicsFaqLuxe);\n  })();\n</script>\n\n<section\n  class=\"po-faq-luxe po-split po-section\"\n  id=\"po-faq\"\n  style=\"\n    --po-page-width: 1280px;\n    --po-cream: #F7F1E4;\n    --po-cream-deep: #EEE1C9;\n    --po-forest: #2F7A4E;\n    --po-forest-deep: #073D27;\n    --po-terracotta: #C96E3C;\n    --po-honey: #F1C858;\n    --po-ink: #1E2B21;\n  \"\n>\n  <div class=\"po-faq-luxe__container\">\n    <div class=\"po-faq-luxe__head\">\n      <div>\n        <div class=\"po-faq-luxe__eyebrow\">Frequently Asked Questions</div>\n        <h2 class=\"po-faq-luxe__title\">\n          Everything you need to know before your <span class=\"accent\">first delivery.</span>\n        </h2>\n      </div>\n\n      <p class=\"po-faq-luxe__intro\">\n        From freshness and delivery timing to subscriptions, customization, packaging, and pricing —\n        here are the answers customers usually ask before ordering from Glow Meals.\n      </p>\n    </div>\n\n    <div class=\"po-faq-luxe__layout\">\n      <aside class=\"po-faq-luxe__aside\">\n        <h3>Simple answers. <em>Real clarity.</em></h3>\n        <p>\n          We keep our process transparent so your weekly meals feel easy from the first order to every Monday delivery.\n        </p>\n\n        <div class=\"po-faq-luxe__aside-list\">\n          <div class=\"po-faq-luxe__aside-pill\">Fresh weekly</div>\n          <div class=\"po-faq-luxe__aside-pill\">Pause anytime</div>\n          <div class=\"po-faq-luxe__aside-pill\">Monday delivery</div>\n        </div>\n      </aside>\n\n      <div>\n        <div class=\"po-faq-luxe__items\">\n\n          <div class=\"po-faq-luxe__item is-open\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>How does Glow Meals work?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Glow Meals is a weekly organic meal delivery service.</li>\n                <li>Choose a subscription plan and select meals from our rotating menu.</li>\n                <li>Fresh meals are delivered directly to your door each week, ready to enjoy.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>What makes Glow Meals different?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Organic ingredients whenever possible.</li>\n                <li>Responsibly sourced proteins.</li>\n                <li>No industrial seed oils.</li>\n                <li>Fresh, never frozen meals.</li>\n                <li>Seasonal ingredients and a rotating menu.</li>\n                <li>Locally sourced ingredients whenever available.</li>\n                <li>Flexible subscriptions with no long-term commitment.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>How fresh are the meals?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>All our meals are freshly prepared each week.</li>\n                <li>Never frozen — we never ship frozen entrées.</li>\n                <li>Designed to deliver the best taste and nutrition.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Are your meals organic?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>We prioritize organic produce and ingredients whenever possible.</li>\n                <li>We work with trusted suppliers who share our commitment to quality, transparency, and responsible sourcing.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Do you use seed oils?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>No. Glow Meals never uses industrial seed oils.</li>\n                <li>Meals are prepared using premium cooking fats and oils selected for quality and flavor.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Do you use artificial preservatives?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>No. We focus on fresh ingredients.</li>\n                <li>We never use artificial preservatives.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Where do your ingredients come from?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>We prioritize organic produce, responsibly sourced proteins, and local suppliers whenever possible.</li>\n                <li>This supports freshness, quality, and sustainability.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>How often does the menu change?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Our menu rotates every two weeks.</li>\n                <li>Each cycle includes customer favorites plus seasonal feature items.</li>\n                <li>Preview meals in advance and filter by dietary preference.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>When does the new menu become available?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>A new menu is released every other Sunday morning.</li>\n                <li>Browse upcoming proteins, sides, salads, seasonal features, and add-ons before placing or updating your order.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Can I choose and customize my meals?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Choose from available proteins, sides, salads, and seasonal features each week.</li>\n                <li>Mix and match to create meals that fit your lifestyle and dietary preferences.</li>\n                <li>Or stick with your default plan.</li>\n              </ul>\n              <div class=\"po-faq-luxe__chips\">\n                <span class=\"po-faq-luxe__chip\">Vegan (V)</span>\n                <span class=\"po-faq-luxe__chip\">Vegetarian (VG)</span>\n                <span class=\"po-faq-luxe__chip\">Gluten-Free (GF)</span>\n                <span class=\"po-faq-luxe__chip\">Dairy-Free (DF)</span>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Do you accommodate food allergies or special dietary needs?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Detailed ingredient information and dietary filters help you make informed choices.</li>\n                <li>Items may be labeled Vegan, Vegetarian, Gluten-Free, or Dairy-Free where applicable.</li>\n                <li>We do not currently offer customized meals, ingredient substitutions, or individualized allergy accommodations.</li>\n                <li>All meals are prepared in a kitchen that handles common allergens (dairy, eggs, nuts, soy, wheat, fish, shellfish); we cannot guarantee any meal is completely allergen-free.</li>\n                <li>Customers with severe allergies or medical dietary restrictions should contact us before ordering.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>What subscription plans do you offer?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li><strong>Starter</strong> — 6 individual meals; perfect for individuals and busy professionals.</li>\n                <li><strong>Most Loved</strong> — family-style meal prep, approximately 9 meals worth of food; ideal for couples and flexible weekly meal prep.</li>\n                <li><strong>Family</strong> — large family-style meal prep, approximately 12–14 meals worth of food; great for families and heavy meal-prep users.</li>\n                <li>All plans include access to Glow Society membership.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>What is Glow Society?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Glow Society is our exclusive member community included with every subscription at no additional cost.</li>\n                <li>Early access to seasonal menus.</li>\n                <li>Exclusive member offers.</li>\n                <li>Wellness tips and recipes.</li>\n                <li>Product announcements and seasonal ingredient spotlights.</li>\n                <li>Member-only updates.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>What add-ons are available?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Enhance your weekly order with optional add-ons.</li>\n                <li>Add-ons can be selected at checkout and updated before the weekly ordering deadline.</li>\n              </ul>\n              <div class=\"po-faq-luxe__chips\">\n                <span class=\"po-faq-luxe__chip\">Breakfast</span>\n                <span class=\"po-faq-luxe__chip\">Bakery</span>\n                <span class=\"po-faq-luxe__chip\">Fresh-Pressed Juices</span>\n                <span class=\"po-faq-luxe__chip\">Family-Style Protein Add-Ons</span>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Can I order extra protein?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Yes. Family-style protein add-ons are available each week.</li>\n                <li>Can be added to any subscription order.</li>\n                <li>Perfect for families, athletes, or anyone wanting extra meal flexibility.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>When is the ordering deadline?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Orders for the upcoming delivery week must be placed by <strong>Tuesday at 11:59 PM</strong>.</li>\n                <li>After the cutoff, our kitchen begins sourcing ingredients, production planning, and meal preparation to ensure every order is fresh and made to order.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Can I change my meal selections after placing my order?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Yes. Meal selections can be updated anytime before <strong>Tuesday at 11:59 PM</strong> for the upcoming delivery week.</li>\n                <li>Once the deadline passes, meal selections are locked and cannot be changed.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>When can I update my dietary preferences?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Dietary preferences can be updated through your account dashboard at any time.</li>\n                <li>To apply changes to an upcoming order, updates must be submitted before <strong>Tuesday at 11:59 PM</strong>.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Can I change my subscription plan?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Absolutely. Upgrade, downgrade, or switch plans anytime through your account dashboard.</li>\n                <li>Plan changes must be submitted by <strong>Tuesday at 11:59 PM</strong> to take effect for the upcoming delivery week.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Can I skip a week?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Yes — we understand schedules change.</li>\n                <li>Skip requests must be submitted by <strong>Tuesday at 11:59 PM</strong> before your next scheduled delivery.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Can I pause my subscription?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Yes. You can pause anytime and restart when you're ready, with no risk of losing your weekly delivery slot.</li>\n                <li>Pause requests must be submitted before <strong>Tuesday at 11:59 PM</strong> to avoid being charged for the upcoming week.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Can I cancel my subscription?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Yes. There are no contracts or long-term commitments.</li>\n                <li>Cancellations must be submitted by <strong>Tuesday at 11:59 PM</strong> before your next scheduled delivery week.</li>\n                <li>Orders already processed after the weekly cutoff will still be fulfilled.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Can I update my delivery address or payment info?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Yes. Updates can be made from your account dashboard.</li>\n                <li>Address changes must be submitted before <strong>Tuesday at 11:59 PM</strong> for the upcoming delivery week.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Why is there an ordering deadline?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Because every order is prepared fresh, we require a weekly deadline to source ingredients, plan production, and maintain quality standards.</li>\n                <li>This helps us deliver meals that are fresh, seasonal, and never frozen while minimizing food waste.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>When are deliveries made?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Deliveries occur weekly on Monday.</li>\n                <li>Delivery schedules and available days vary by location and will be provided inside your customer account.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Do you offer free delivery?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Yes.</li>\n                <li><strong>Starter Plan</strong> — free delivery on orders over $80.</li>\n                <li><strong>Most Loved Plan</strong> — free delivery included.</li>\n                <li><strong>Family Plan</strong> — free delivery included.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>How do I manage my subscription?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <p>Your customer dashboard allows you to:</p>\n              <ul>\n                <li>Skip weeks</li>\n                <li>Pause subscriptions</li>\n                <li>Change plans</li>\n                <li>Update payment information</li>\n                <li>Update delivery addresses</li>\n                <li>Manage dietary preferences</li>\n                <li>View upcoming orders</li>\n                <li>Review order history</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>How are meals packaged?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Delivered in insulated, temperature-controlled bags to keep meals fresh during transit.</li>\n                <li>We strive to use eco-conscious packaging whenever possible while ensuring food quality and freshness.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>How should I store my meals?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Store all meals refrigerated upon delivery.</li>\n                <li>Follow the storage instructions included with your order for the best quality and freshness.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Do you offer gift subscriptions?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Gift subscription options are coming soon.</li>\n                <li>Join Glow Society to receive announcements, special offers, and future gifting opportunities.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>What is the weekly ordering timeline?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul class=\"po-faq-luxe__timeline\">\n                <li><strong>Sunday Morning · 10:00 AM</strong> New menu released</li>\n                <li><strong>Sunday – Tuesday · 11:59 PM</strong> Order &amp; edit window open</li>\n                <li><strong>Tuesday · 11:59 PM</strong> Ordering &amp; subscription change deadline</li>\n                <li><strong>Wednesday – Saturday</strong> Ingredient sourcing &amp; production</li>\n                <li><strong>Delivery Week</strong> Fresh meals delivered</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Who is behind this service?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Meet the founder on the About or Our Mission page.</li>\n                <li>Learn the story and passion behind the brand.</li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"po-faq-luxe__item\">\n            <button class=\"po-faq-luxe__question\" type=\"button\">\n              <span>Need help?</span>\n              <span class=\"po-faq-luxe__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            </button>\n            <div class=\"po-faq-luxe__answer\">\n              <ul>\n                <li>Our support team is available to assist with subscriptions, deliveries, account updates, and menu questions.</li>\n                <li>Contact us through our Contact Form, email support, or phone support.</li>\n              </ul>\n            </div>\n          </div>\n\n        </div>\n\n        <div class=\"po-faq-luxe__cta\">\n          <div>\n            <h3>Still have a question?</h3>\n            <p>\n              Visit the menu, pricing, or account dashboard pages to learn more about plans, delivery, and weekly customization.\n            </p>\n          </div>\n\n          <a href=\"/pages/contact\" class=\"po-faq-luxe__btn\">Contact Us</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
