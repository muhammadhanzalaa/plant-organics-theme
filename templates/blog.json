{"sections":{"custom_liquid_qdxzyk":{"type":"custom-liquid","name":"Custom liquid","settings":{"custom_liquid":"<link rel=\"stylesheet\" href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.5.1\/css\/all.min.css\">\n\n<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n  #po-blog-head,\n  #po-blog-head * {\n    box-sizing: border-box;\n  }\n\n  #po-blog-head {\n    --po-dark-green: #293f07;\n    --po-green: #95ad4f;\n    --po-orange: #ff960e;\n    --po-white: #ffffff;\n    --po-cream: #fff4e7;\n\n    --po-font-header: \"Bricolage Grotesque\", \"Montserrat\", Arial, sans-serif;\n    --po-font-body: \"Montserrat\", Arial, sans-serif;\n\n    position: relative;\n    overflow: hidden;\n    width: 100%;\n    padding: 72px 20px 40px;\n    background:\n      radial-gradient(circle at 8% 10%, rgba(149, 173, 79, 0.16), transparent 28%),\n      radial-gradient(circle at 88% 12%, rgba(255, 150, 14, 0.16), transparent 28%),\n      linear-gradient(135deg, #fff4e7 0%, #fff0dc 48%, #fffaf3 100%);\n    color: var(--po-dark-green);\n    font-family: var(--po-font-body);\n  }\n\n  #po-blog-head .po-blog-container {\n    width: 100%;\n    max-width: 1280px;\n    margin: 0 auto;\n    position: relative;\n    z-index: 2;\n  }\n\n  #po-blog-head .po-blog-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    width: fit-content;\n    background: rgba(149, 173, 79, 0.18);\n    color: var(--po-dark-green);\n    border: 1px solid rgba(149, 173, 79, 0.36);\n    border-radius: 999px;\n    padding: 10px 18px;\n    font-family: var(--po-font-header);\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    margin-bottom: 18px;\n  }\n\n  #po-blog-head .po-blog-eyebrow::before {\n    content: \"\";\n    width: 10px;\n    height: 10px;\n    border-radius: 999px;\n    background: var(--po-orange);\n    flex: 0 0 10px;\n  }\n\n  #po-blog-head .po-blog-title {\n    margin: 0 0 18px;\n    max-width: 760px;\n    color: var(--po-dark-green);\n    font-family: var(--po-font-header);\n    font-size: clamp(38px, 5vw, 72px);\n    line-height: 0.96;\n    letter-spacing: -0.05em;\n    font-weight: 900;\n  }\n\n  #po-blog-head .po-blog-title .accent {\n    color: var(--po-orange);\n  }\n\n  #po-blog-head .po-blog-text {\n    margin: 0;\n    max-width: 640px;\n    color: rgba(41, 63, 7, 0.72);\n    font-size: 16px;\n    line-height: 1.65;\n    font-weight: 500;\n  }\n\n  @media (max-width: 640px) {\n    #po-blog-head {\n      padding: 56px 16px 28px;\n    }\n\n    #po-blog-head .po-blog-title {\n      font-size: clamp(32px, 10vw, 44px);\n    }\n\n    #po-blog-head .po-blog-text {\n      font-size: 15px;\n    }\n  }\n<\/style>\n\n<section id=\"po-blog-head\">\n  <div class=\"po-blog-container\">\n    <div class=\"po-blog-eyebrow\">Recipes &amp; Wellness<\/div>\n    <h1 class=\"po-blog-title\">\n      Stories to <span class=\"accent\">Keep You Glowing.<\/span>\n    <\/h1>\n    <p class=\"po-blog-text\">\n      Fresh recipes, wellness tips, and behind-the-scenes stories from the Glow Meals kitchen.\n    <\/p>\n  <\/div>\n<\/section>\n\n<!-- ============================================\n     Global overrides: match the default blog\n     listing (title, article cards) to the rest\n     of the site's fonts and colors.\n     ============================================ -->\n<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n  \/* Hide the default \"All Stories\" blog title (kept in DOM for SEO, just visually removed) *\/\n  .title-wrapper-with-link .title--primary,\n  .title-wrapper .title--primary,\n  #MainContent .title--primary,\n  #MainContent h1.title,\n  .main-blog__title {\n    display: none !important;\n  }\n\n  \/* Article card titles *\/\n  #MainContent .card__heading,\n  #MainContent .card__heading a,\n  #MainContent .article-card__title,\n  #MainContent .blog-articles h3 {\n    font-family: \"Bricolage Grotesque\", \"Montserrat\", Arial, sans-serif !important;\n    color: #293f07 !important;\n    font-weight: 900 !important;\n    letter-spacing: -0.02em !important;\n  }\n\n  #MainContent .card__heading a:hover {\n    color: #ff960e !important;\n  }\n\n  \/* Article card meta (date \/ tag \/ author) *\/\n  #MainContent .article-card__info,\n  #MainContent .card-information,\n  #MainContent .blog-post-meta,\n  #MainContent .article-card time,\n  #MainContent .card-information .caption {\n    font-family: \"Montserrat\", Arial, sans-serif !important;\n    color: rgba(41, 63, 7, 0.65) !important;\n  }\n\n  \/* General body text on the blog template *\/\n  #MainContent.template-blog,\n  #MainContent .blog-articles {\n    font-family: \"Montserrat\", Arial, sans-serif !important;\n  }\n\n  \/* Section background to match the rest of the site *\/\n  #MainContent .blog-articles,\n  #MainContent .template-blog {\n    background: #fffaf3;\n  }\n<\/style>","custom_class":""}},"main":{"type":"blog-template","custom_css":[".section-header__title,header.section-header{display:none}","[data-section-type=blog]{background:linear-gradient(135deg,#fff4e7,#fff0dc 48%,#fffaf3)!important}","[data-section-type=blog] .grid__item{background:#fff!important;border-radius:24px;box-shadow:0 20px 52px rgba(41,63,7,.09);overflow:hidden;margin-bottom:24px}","[data-section-type=blog] .grid__item>*:last-child{padding:12px}","[data-section-type=blog] h3{font-weight:900;text-transform:uppercase;color:#293f07!important}"],"settings":{"blog_show_tag_filter":false,"blog_show_rss":false,"blog_show_tags":true,"blog_show_date":true,"blog_show_comments":true,"blog_show_author":true,"blog_show_excerpt":false,"blog_image_size":"wide"}},"featured-collections":{"type":"featured-collections","blocks":{"collection1":{"type":"colle