po-cream: #F7F1E4; --po-cream-deep: #EEE1C9; --po-forest: #2F7A4E; --po-forest-deep: #073D27; --po-terracotta: #C96E3C; --po-honey: #F1C858; --po-ink: #1E2B21;\"\n>\n  <div class=\"po-container po-glow-grid\">\n    <div class=\"po-image-card\">\n      <div class=\"po-glow-card\">\n        <img\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0787\/2761\/0619\/files\/glow-plan.jpg?v=1780297792\"\n          alt=\"Glow Plan\"\n          loading=\"lazy\"\n        >\n\n        <div class=\"po-glow-quote\">\n          <div class=\"po-script\">\n            &quot;My skin has never looked better.&quot;\n          <\/div>\n\n          <div style=\"font-size: 11px; letter-spacing: .15em; text-transform: uppercase; margin-top: 8px;\">\n            — Layla, 7-day Glow member\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"po-glow-badge\">\n        <div class=\"po-display\" style=\"font-size: 38px; line-height: 1;\">\n          7 Days\n        <\/div>\n\n        <div style=\"font-size: 10px; letter-spacing: .13em; text-transform: uppercase;\">\n          to glow from within\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <div>\n      <div class=\"po-eyebrow\">The Glow Plan<\/div>\n\n      <h2 class=\"po-title\" style=\"margin-top: 18px;\">\n        A week of meals built to make you <span class=\"accent\">glow.<\/span>\n      <\/h2>\n\n      <p class=\"po-soft\">\n        Our most radiant reset: chef-crafted meals designed around hydration,\n        antioxidants, fiber, and plant-powered protein.\n      <\/p>\n\n      <ul class=\"po-benefits\">\n        <li>21 chef-crafted glow meals — breakfast, lunch, dinner<\/li>\n        <li>High-antioxidant produce: berries, leafy greens, turmeric<\/li>\n        <li>Collagen-supporting plant proteins + omega-3 boosters<\/li>\n        <li>Hydration-rich soups, smoothies & herbal infusions<\/li>\n        <li>Personalized notes from our in-house nutritionist<\/li>\n      <\/ul>\n\n      <a href=\"#po-plans\" class=\"po-btn po-btn-primary\">\n        Start the glow plan →\n      <\/a>\n    <\/div>\n  <\/div>\n<\/section>","custom_class":""}},"testimonials":{"type":"testimonials","blocks":{"testimonials-0":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}},"testimonials-1":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}},"testimonials-2":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}}},"block_order":["testimonials-0","testimonials-1","testimonials-2"],"settings":{"title":"Testimonials","align_text":"center","round_images":true,"color_background":"#f9f9f9","color_text":"#1c1d1d"}},"custom_liquid_Rxhpja":{"type":"custom-liquid","name":"faq","settings":{"custom_liquid":"<section\n  class=\"po-split po-section po-faq-section\"\n  style=\"--po-page-width: 1280px; --po-cream: #F7F1E4; --po-cream-deep: #EEE1C9; --po-forest: #2F7A4E; --po-forest-deep: #073D27; --po-terracotta: #C96E3C; --po-honey: #F1C858; --po-ink: #1E2B21; background: color-mix(in srgb, var(--po-cream-deep) 40%, transparent);\"\n>\n  <div class=\"po-container\">\n    <div class=\"po-center\">\n      <div class=\"po-eyebrow\">FAQ<\/div>\n\n      <h2 class=\"po-title\" style=\"margin-top: 18px;\">\n        Everything you <span class=\"accent\">might be wondering.<\/span>\n      <\/h2>\n    <\/div>\n\n    <div class=\"po-faq-list\">\n      <div class=\"po-faq-item is-open\">\n        <button class=\"po-faq-q\">\n          Where do you deliver?\n          <span class=\"po-plus\">+<\/span>\n        <\/button>\n\n        <div class=\"po-faq-a\">\n          We deliver fresh every Monday across Southern California and South Florida.\n          Free pickup is available in select CA and Fort Lauderdale locations.\n        <\/div>\n      <\/div>\n\n      <div class=\"po-faq-item\">\n        <button class=\"po-faq-q\">\n          Can I skip or pause my subscription?\n          <span class=\"po-plus\">+<\/span>\n        <\/button>\n\n        <div class=\"po-faq-a\">\n          Absolutely. Manage your plan from your account — skip a week, pause for a\n          month, or cancel anytime. No fees, no questions.\n        <\/div>\n      <\/div>\n\n      <div class=\"po-faq-item\">\n        <button class=\"po-faq-q\">\n          Are the meals really seed-oil free?\n          <span class=\"po-plus\">+<\/span>\n        <\/button>\n\n        <div class=\"po-faq-a\">\n          Yes. We cook exclusively with extra-virgin olive oil, avocado oil, and\n          cold-pressed coconut oil. No canola, soy, or sunflower oils, ever.\n        <\/div>\n      <\/div>\n\n      <div class=\"po-faq-item\">\n        <button class=\"po-faq-q\">\n          How long do the meals stay fresh?\n          <span class=\"po-plus\">+<\/span>\n        <\/button>\n\n        <div class=\"po-faq-a\">\n          Sealed in our compostable trays, meals stay fresh for 5–7 days\n          refrigerated. Most members eat through their box by Friday.\n        <\/div>\n      <\/div>\n\n      <div class=\"po-faq-item\">\n        <button class=\"po-faq-q\">\n          What if I have allergies?\n          <span class=\"po-plus\">+<\/span>\n        <\/button>\n\n        <div class=\"po-faq-a\">\n          All meals are 100% plant-based and gluten-free. You can filter by\n          nut-free, soy-free, and low-FODMAP when building your box.\n        <\/div>\n      <\/div>\n\n      <div class=\"po-faq-item\">\n        <button class=\"po-faq-q\">\n          Is the packaging recyclable?\n          <span class=\"po-plus\">+<\/span>\n        <\/button>\n\n        <div class=\"po-faq-a\">\n          Our trays are home-compostable plant-fiber. Outer insulation is curbside\n          recyclable. Less than 2% of the box goes to landfill.\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>","custom_class":""}},"recently-viewed":{"type":"recently-viewed","settings":{"recent_count":5}},"collection-return":{"type":"collection-return","settings":{}}},"order":["custom_liquid_e4XrXa","main","178047281169ac7156","sub","product-recommendations","custom_liquid_afw3hJ","testimonials","custom_liquid_Rxhpja","recently-viewed","collection-return"]}