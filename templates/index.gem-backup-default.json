      "settings": {
        "custom_liquid": "<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n  #po-about,\n  #po-about * {\n    box-sizing: border-box;\n  }\n\n  #po-about {\n    --po-page-width: 1280px;\n\n    \/* Actual Brand Colors *\/\n    --po-pink: #fcb6eb;\n    --po-purple: #917EC3;\n    --po-dark-green: #293f07;\n    --po-green: #95ad4f;\n    --po-orange: #ff960e;\n    --po-white: #ffffff;\n\n    \/* Soft Shades *\/\n    --po-pink-soft: #fff0fb;\n    --po-purple-soft: #f3efff;\n    --po-purple-mid: #d9cff4;\n    --po-pink-mid: #ffd4f4;\n\n    \/* Brand Fonts *\/\n    --po-font-header-1: \"Degular Demo Black\", \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-header-2: \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-body: \"Montserrat Classic\", \"Montserrat\", Arial, sans-serif;\n\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    padding: 96px 0;\n    color: var(--po-dark-green);\n    background:\n      radial-gradient(circle at 7% 10%, rgba(252, 182, 235, 0.42), transparent 30%),\n      radial-gradient(circle at 88% 12%, rgba(145, 126, 195, 0.34), transparent 30%),\n      radial-gradient(circle at 12% 86%, rgba(149, 173, 79, 0.16), transparent 32%),\n      radial-gradient(circle at 86% 86%, rgba(255, 150, 14, 0.12), transparent 30%),\n      linear-gradient(135deg, #fff4e7 0%, #fff0dc 48%, #fffaf3 100%);\n    font-family: var(--po-font-body);\n  }\n\n  #po-about::before {\n    content: \"\";\n    position: absolute;\n    inset: 24px;\n    border: 1px solid rgba(145, 126, 195, 0.22);\n    border-radius: 36px;\n    pointer-events: none;\n  }\n\n  #po-about::after {\n    content: \"plant story\";\n    position: absolute;\n    right: -18px;\n    bottom: -16px;\n    color: rgba(145, 126, 195, 0.12);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(72px, 11vw, 160px);\n    line-h