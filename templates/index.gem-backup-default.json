      "name": "subscription",
      "settings": {
        "custom_liquid": "<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n  #po-plans-{{ section.id }},\n  #po-plans-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #po-plans-{{ section.id }} {\n    --po-page-width: 1280px;\n\n    --po-pink: #fcb6eb;\n    --po-dark-green: #293f07;\n    --po-green: #95ad4f;\n    --po-orange: #ff960e;\n    --po-purple: #927ec3;\n    --po-white: #ffffff;\n\n    --po-font-header-1: \"Degular Demo Black\", \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-header-2: \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-body: \"Montserrat Classic\", \"Montserrat\", Arial, sans-serif;\n\n    position: relative;\n    overflow: hidden;\n    color: var(--po-dark-green);\n   background:\n  radial-gradient(circle at 8% 10%, rgba(149, 173, 79, 0.16), transparent 30%),\n  radial-gradient(circle at 90% 14%, rgba(255, 150, 14, 0.16), transparent 28%),\n  radial-gradient(circle at 50% 100%, rgba(252, 182, 235, 0.10), transparent 34%),\n  linear-gradient(135deg, #fff4e7 0%, #fff0dc 48%, #fffaf3 100%);\n    font-family: var(--po-font-body);\n  }\n\n  #po-plans-{{ section.id }}::before {\n    content: \"\";\n    position: absolute;\n    inset: 24px;\n    border: 1px solid rgba(41, 63, 7, 0.1);\n    border-radius: 36px;\n    pointer-events: none;\n  }\n\n  #po-plans-{{ section.id }}::after {\n    content: \"weekly plans\";\n    position: absolute;\n    right: -18px;\n    bottom: -18px;\n    color: rgba(41, 63, 7, 0.045);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(76px, 12vw, 170px);\n    font-weight: 900;\n    line-height: 0.8;\n    letter-spacing: -0.07em;\n    pointer-events: none;\n    white-space: nowrap;\n  }\n\n  #po-plans-{{ section.id }} .po-container {\n    width: min(var(--po-page-width), calc(100% - 32px));\n    margin: 0 auto;\n    position: relative;\n    z-index: 2;\n  }\n\n  #po-plans-{{ section.id }}.po-section {\n    padding: 96px 0;\n  }\n\n  #po-plans-{{ section.id }} .po-center {\n    max-width: 780px;\n    margin: 0 auto 48px;\n    text-align: center;\n  }\n\n  #po-plans-{{ section.id }} .po-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    background: rgba(149, 173, 79, 0.18);\n    color: var(--po-dark-green);\n    border: 1px solid rgba(149, 173, 79, 0.36);\n    border-radius: 999px;\n    padding: 10px 18px;\n    font-family: var(--po-font-header-2);\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n\n  #po-plans-{{ section.id }} .po-eyebrow::before {\n    content: \"\";\n    width: 10px;\n    height: 10px;\n    background: var(--po-orange);\n    border-radius: 50%;\n  }\n\n  #po-plans-{{ section.id }} .po-title {\n    margin: 18px 0 14px;\n    color: var(--po-dark-green);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(44px, 5.2vw, 76px);\n    line-height: 0.94;\n    letter-spacing: -0.06em;\n    font-weight: 900;\n  }\n\n  #po-plans-{{ section.id }} .po-title .accent {\n    color: var(--po-orange);\n  }\n\n  #po-plans-{{ section.id }} .po-soft {\n    max-width: 600px;\n    margin: 18px auto 0;\n    color: rgba(41, 63, 7, 0.72);\n    font-family: var(--po-font-body);\n    font-size: 17px;\n    line-height: 1.7;\n    font-weight: 500;\n  }\n\n  #po-plans-{{ section.id }} .po-plan-grid-clean {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 24px;\n    max-width: 1180px;\n    margin: 0 auto;\n    align-items: stretch;\n  }\n\n  #po-plans-{{ section.id }} .po-plan-clean-card {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    padding: 28px;\n    border-radius: 34px;\n    background: var(--po-white);\n    border: 1px solid rgba(41, 63, 7, 0.12);\n    box-shadow:\n      inset 0 1px 0 rgba(255, 255, 255, 0.9),\n      0 24px 60px 