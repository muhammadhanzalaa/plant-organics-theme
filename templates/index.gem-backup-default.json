umns: 1fr;\n      gap: 48px;\n      max-width: 720px;\n      margin: 0 auto;\n    }\n\n    #po-glow .po-title,\n    #po-glow .po-soft,\n    #po-glow .po-benefits {\n      max-width: 100%;\n    }\n\n    #po-glow .po-glow-card img {\n      height: 480px;\n    }\n\n    #po-glow .po-glow-badge {\n      right: 18px;\n      top: 22px;\n      width: 142px;\n      height: 142px;\n    }\n  }\n\n\n\n  @media (max-width: 700px) {\n    #po-glow {\n      padding: 66px 14px;\n    }\n\n    #po-glow .po-glow-grid {\n      gap: 36px;\n    }\n\n    #po-glow .po-eyebrow {\n      font-size: 11px;\n      padding: 9px 14px;\n      letter-spacing: 0.13em;\n    }\n\n    #po-glow .po-glow-card img {\n      height: clamp(360px, 70vw, 460px);\n    }\n\n    #po-glow .po-benefits {\n      margin: 26px 0 30px;\n      gap: 10px;\n    }\n\n    #po-glow .po-btn {\n      min-height: 54px;\n      white-space: normal;\n      text-align: center;\n      line-height: 1.18;\n      padding: 14px 22px;\n    }\n  }\n\n  @media (max-width: 560px) {\n    #po-glow {\n      padding: 60px 14px;\n    }\n\n    #po-glow .po-glow-card {\n      border-width: 8px;\n      border-radius: 28px;\n      box-shadow:\n        0 24px 60px rgba(41, 63, 7, 0.14),\n        8px 8px 0 rgba(149, 173, 79, 0.14);\n    }\n\n    #po-glow .po-glow-card img {\n      height: clamp(330px, 96vw, 410px);\n    }\n\n    #po-glow .po-glow-quote {\n      left: 14px;\n      right: 14px;\n      bottom: 14px;\n      padding: 18px;\n      border-radius: 20px;\n    }\n\n    #po-glow .po-glow-badge {\n      width: 116px;\n      height: 116px;\n      right: 12px;\n      top: 12px;\n      border-width: 4px;\n    }\n\n    #po-glow .po-display {\n      font-size: 28px !important;\n    }\n\n    #po-glow .po-title {\n      font-size: clamp(38px, 11vw, 52px);\n    }\n\n    #po-glow .po-soft {\n      font-size: 15.5px;\n      line-height: 1.62;\n    }\n\n    #po-glow .po-benefits li {\n      padding: 14px 14px 14px 44px;\n      font-size: 14px;\n      line-hei