        "custom_liquid": "<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n  #po-food-gallery-{{ section.id }},\n  #po-food-gallery-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #po-food-gallery-{{ section.id }} {\n    --po-page-width: 1280px;\n\n    --po-pink: #fcb6eb;\n    --po-purple: #917EC3;\n    --po-dark-green: #293f07;\n    --po-green: #95ad4f;\n    --po-orange: #ff960e;\n    --po-white: #ffffff;\n\n    --po-pink-soft: rgba(252, 182, 235, 0.24);\n    --po-purple-soft: rgba(145, 126, 195, 0.2);\n    --po-green-soft: rgba(149, 173, 79, 0.15);\n    --po-orange-soft: rgba(255, 150, 14, 0.12);\n\n    --po-font-header-1: \"Degular Demo Black\", \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-header-2: \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-body: \"Montserrat Classic\", \"Montserrat\", Arial, sans-serif;\n\n    position: relative;\n    overflow: hidden;\n    padding: 104px 0;\n    color: var(--po-dark-green);\n    background:\n      radial-gradient(circle at 7% 9%, rgba(252, 182, 235, 0.36), transparent 30%),\n      radial-gradient(circle at 92% 10%, rgba(145, 126, 195, 0.32), transparent 30%),\n      radial-gradient(circle at 12% 92%, rgba(149, 173, 79, 0.16), transparent 32%),\n      radial-gradient(circle at 88% 88%, rgba(255, 150, 14, 0.11), transparent 30%),\n      linear-gradient(135deg, #ffffff 0%, #fff8fd 38%, #f7f3ff 70%, #ffffff 100%);\n    font-family: var(--po-font-body);\n  }\n\n  #po-food-gallery-{{ section.id }}::before {\n    content: \"\";\n    position: absolute;\n    inset: 24px;\n    border: 1px solid rgba(145, 126, 195, 0.22);\n    border-radius: 38px;\n    pointer-events: none;\n  }\n\n  #po-food-gallery-{{ section.id }}::after {\n    content: \"fresh plates\";\n    position: absolute;\n    right: -22px;\n    bottom: -18px;\n    color: rgba(145, 126, 195, 0.1);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(78px, 12vw, 172px);\n    line-height: 0.8;\n    font-weight: 900;\n    letter-spacing: -0.075em;\n    white-space: nowrap;\n    pointer-events: none;\n  }\n\n  #po-food-gallery-{{ section.id }} .po-gallery-container {\n    width: min(var(--po-page-width), calc(100% - 32px));\n    margin: 0 auto;\n    position: relative;\n    z-index: 2;\n  }\n\n  #po-food-gallery-{{ section.id }} .po-gallery-head {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.52fr);\n    gap: 48px;\n    align-items: end;\n    margin-bottom: 46px;\n  }\n\n  #po-food-gallery-{{ section.id }} .po-gallery-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    width: fit-content;\n    min-height: 38px;\n    padding: 0 18px;\n    border-radius: 999px;\n    background:\n      linear-gradient(135deg, rgba(252, 182, 235, 0.42), rgba(145, 126, 195, 0.2));\n    border: 1px solid rgba(145, 126, 195, 0.3);\n    color: var(--po-dark-green);\n    font-family: var(--po-font-header-2);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    box-shadow: 0 14px 34px rgba(145, 126, 195, 0.1);\n  }\n\n  #po-food-gallery-{{ section.id }} .po-gallery-eyebrow::before {\n    content: \"\";\n    width: 10px;\n    height: 10px;\n    border-radius: 999px;\n    background: var(--po-purple);\n    box-shadow: 0 0 0 6px rgba(145, 126, 195, 0.16);\n  }\n\n  #po-food-gallery-{{ section.id }} .po-gallery-title {\n    max-width: 880px;\n    margin: 18px 0 0;\n    color: var(--po-dark-green);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(46px, 5.8vw, 88px);\n    line-height: 0.9;\n    letter-spacing: -0.07em;\n    font-weight: 900;\n  }\n\n  #po-food-gallery-{{ section.id }} .po-gallery-title span {\n    background: linear-gradient(90deg, var(--po-purple), #b96bda, var(--po-pink), var(--po-orange));\n    -web