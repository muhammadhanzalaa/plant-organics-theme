=\"po-modal-price\">$286 <span>\/ week<\/span><\/p>\n\n      <div class=\"po-modal-grid\">\n        <div>\n          <strong>Approx. Yield<\/strong>\n          <p>12–14 meals for families or heavy weekly meal-prep users.<\/p>\n        <\/div>\n        <div>\n          <strong>Best For<\/strong>\n          <p>Families, couples, and customers who want more weekly value.<\/p>\n        <\/div>\n      <\/div>\n\n      <ul class=\"po-modal-points\">\n        <li>4 lbs total protein<\/li>\n        <li>3 lbs total sides<\/li>\n        <li>2 lbs total salads<\/li>\n        <li>15% off add-ons and skip anytime<\/li>\n        <li>Packaged in larger family size containers to mix and match throughout the week<\/li>\n      <\/ul>\n\n      <a href=\"\/products\/large-family-style-box\" class=\"po-modal-btn\">\n        Choose Family\n      <\/a>\n    <\/div>\n  <\/div>\n<\/section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var section = document.querySelector('#po-plans-{{ section.id }}');\n    if (!section || section.dataset.poPopupReady === 'true') return;\n\n    section.dataset.poPopupReady = 'true';\n\n    var wrap = section.querySelector('[data-po-modal-wrap]');\n    var modals = section.querySelectorAll('[data-po-modal]');\n    var openButtons = section.querySelectorAll('[data-po-modal-open]');\n    var closeButtons = section.querySelectorAll('[data-po-modal-close]');\n    var bodyClass = 'po-plan-modal-open-{{ section.id }}';\n\n    function closeModal() {\n      if (!wrap) return;\n\n      wrap.setAttribute('hidden', '');\n\n      modals.forEach(function (modal) {\n        modal.setAttribute('hidden', '');\n      });\n\n      document.body.classList.remove(bodyClass);\n    }\n\n    function openModal(name) {\n      if (!wrap) return;\n\n      var target = section.querySelector('[data-po-modal=\"' + name + '\"]');\n      if (!target) return;\n\n      modals.forEach(function (modal) {\n        modal.setAttribute('hidden', '');\n      });\n\n      wrap.removeAttribute('hidden');\n      target.removeAttribute('hidden');\n      document.body.classList.add(bodyClass);\n\n      var closeBtn = target.querySelector('.po-modal-close');\n      if (closeBtn) closeBtn.focus();\n    }\n\n    openButtons.forEach(function (button) {\n      button.addEventListener('click', function () {\n        openModal(button.getAttribute('data-po-modal-open'));\n      });\n    });\n\n    closeButtons.forEach(function (button) {\n      button.addEventListener('click', closeModal);\n    });\n\n    document.addEventListener('keydown', function (event) {\n      if (event.key === 'Escape') {\n        closeModal();\n      }\n    });\n  });\n<\/script>",
