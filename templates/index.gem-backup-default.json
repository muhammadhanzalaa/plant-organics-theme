      "name": "glow plan",
      "settings": {
        "custom_liquid": "<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n  #po-glow,\n  #po-glow * {\n    box-sizing: border-box;\n  }\n\n  #po-glow {\n    --po-page-width: 1280px;\n\n    \/* Actual Brand Colors *\/\n    --po-pink: #fcb6eb;\n    --po-dark-green: #293f07;\n    --po-green: #95ad4f;\n    --po-orange: #ff960e;\n    --po-purple: #927ec3;\n    --po-white: #ffffff;\n\n    \/* Brand Fonts *\/\n    --po-font-header-1: \"Degular Demo Black\", \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-header-2: \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-body: \"Montserrat Classic\", \"Montserrat\", Arial, sans-serif;\n\n    position: relative;\n    overflow: hidden;\n    padding: 96px 20px;\n    color: var(--po-dark-green);\n   background:\n  radial-gradient(circle at 10% 12%, rgba(149, 173, 79, 0.16), transparent 30%),\n  radial-gradient(circle at 88% 18%, rgba(255, 150, 14, 0.16), transparent 28%),\n  radial-gradient(circle at 78% 86%, rgba(252, 182, 235, 0.14), transparent 34%),\n  linear-gradient(135deg, #fff4e7 0%, #fff0dc 48%, #fffaf3 100%);\n    font-family: var(--po-font-body);\n  }\n\n  #po-glow::before {\n    content: \"\";\n    position: absolute;\n    inset: 24px;\n    border: 1px solid rgba(41, 63, 7, 0.1);\n    border-radius: 36px;\n    pointer-events: none;\n  }\n\n  #po-glow::after {\n    content: \"glow from within\";\n    position: absolute;\n    right: -24px;\n    bottom: -18px;\n    color: rgba(41, 63, 7, 0.045);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(66px, 10vw, 150px);\n    font-weight: 900;\n    line-height: 0.8;\n    letter-spacing: -0.07em;\n    white-space: nowrap;\n    pointer-events: none;\n  }\n\n  #po-glow .po-container {\n    width: min(var(--po-page-width), calc(100% - 32px));\n    margin: 0 auto;\n    position: relative;\n    z-index: 2;\n  }\n\n  #po-glow .po-glow-grid {\n    display: grid;\n    grid-template-columns: 0.95fr 1.05fr;\n    gap: 72px;\n    align-items: center;\n  }\n\n  #po-glow .po-image-card {\n    position: relative;\n    isolation: isolate;\n  }\n\n  #po-glow .po-image-card::before {\n    content: \"\";\n    position: absolute;\n    width: 72%;\n    height: 72%;\n    left: -22px;\n    top: -22px;\n    background: var(--po-green);\n    border-radius: 42% 58% 50% 50%;\n    opacity: 0.32;\n    z-index: -1;\n  }\n\n  #po-glow .po-image-card::after {\n    content: \"\";\n    position: absolute;\n    width: 44%;\n    height: 44%;\n    right: -16px;\n    bottom: -18px;\n    background: var(--po-orange);\n    border-radius: 999px;\n    opacity: 0.22;\n    z-index: -1;\n  }\n\n  #po-glow .po-glow-card {\n    position: relative;\n    overflow: hidden;\n    background: var(--po-white);\n    border: 10px solid var(--po-white);\n    border-radius: 38px;\n    box-shadow:\n      0 30px 78px rgba(41, 63, 7, 0.15),\n      12px 12px 0 rgba(149, 173, 79, 0.16);\n  }\n\n  #po-glow .po-glow-card img {\n    width: 100%;\n    height: 590px;\n    object-fit: cover;\n    display: block;\n    filter: saturate(1.04) contrast(1.02);\n    transition: transform 0.55s ease, filter 0.55s ease;\n  }\n\n  #po-glow .po-glow-card:hover img {\n    transform: scale(1.045);\n    filter: saturate(1.1) contrast(1.04);\n  }\n\n  #po-glow .po-glow-quote {\n    position: absolute;\n    left: 24px;\n    right: 24px;\n    bottom: 24px;\n    padding: 24px 24px 22px;\n    border-radius: 26px;\n    background: rgba(255, 255, 255, 0.9);\n    border: 1px solid rgba(41, 63, 7, 0.12);\n    box-shadow: 0 18px 44px rgba(41, 63, 7, 0.14);\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n    color: var(--po-dark-green);\n  }\n\n  #po-glow .po-script {\n    font-family: var(--po-font-header-1);\n    font-size: clamp(24px, 2.4vw, 34px);\n    line-height: 1.02;\n    letter-spacing: -0.045em;\n    font-weight: 900