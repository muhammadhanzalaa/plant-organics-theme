    "custom_liquid_rtdttB": {
      "type": "custom-liquid",
      "disabled": true,
      "custom_css": [],
      "name": "hero",
      "settings": {
        "custom_liquid": "<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n  .po-independent-hero-section,\n  .po-independent-hero-section * {\n    box-sizing: border-box;\n  }\n\n  .po-independent-hero-section {\n    --po-page-width: 1320px;\n\n    \/* Actual Brand Colors *\/\n    --po-pink: #fcb6eb;\n    --po-dark-green: #293f07;\n    --po-green: #95ad4f;\n    --po-orange: #ff960e;\n    --po-purple: #927ec3;\n    --po-white: #ffffff;\n\n    \/* Brand Fonts *\/\n    --po-font-header-1: \"Degular Demo Black\", \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-header-2: \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-body: \"Montserrat Classic\", \"Montserrat\", Arial, sans-serif;\n\n    --po-hero-height: 720px;\n\n    width: 100%;\n    font-family: var(--po-font-body);\n    color: var(--po-white);\n    overflow: hidden;\n    background: var(--po-dark-green);\n  }\n\n  .po-independent-container {\n    width: 100%;\n    max-width: var(--po-page-width);\n    margin: 0 auto;\n    padding-left: 22px;\n    padding-right: 22px;\n  }\n\n  .po-independent-hero {\n    position: relative;\n    min-height: var(--po-hero-height);\n    overflow: hidden;\n    isolation: isolate;\n    background: var(--po-dark-green);\n  }\n\n  .po-independent-hero::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n    background:\n      linear-gradient(\n        90deg,\n        rgba(41, 63, 7, 0.96) 0%,\n        rgba(41, 63, 7, 0.84) 35%,\n        rgba(41, 63, 7, 0.46) 66%,\n        rgba(41, 63, 7, 0.18) 100%\n      );\n    pointer-events: none;\n  }\n\n  .po-independent-hero::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 3;\n    background:\n      radial-gradient(circle at 18% 34%, rgba(149, 173, 79, 0.2), transparent 32%),\n      radial-gradient(circle at 54% 18%, rgba(255, 150, 14, 0.16), transparent 30%),\n      linear-gradient(180deg, rgba(41, 63, 7, 0.02), rgba(41, 63, 7, 0.28));\n    pointer-events: none;\n  }\n\n  .po-independent-hero-slide {\n    position: absolute;\n    inset: 0;\n    opacity: 0;\n    transform: scale(1.04);\n    transition: opacity 900ms ease, transform 1800ms ease;\n    z-index: 1;\n  }\n\n  .po-independent-hero-slide.is-active {\n    opacity: 1;\n    transform: scale(1);\n  }\n\n  .po-independent-hero-slide img {\n    width: 100%;\n    height: 100%;\n    min-height: var(--po-hero-height);\n    display: block;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .po-independent-hero-content {\n    position: relative;\n    z-index: 5;\n    min-height: var(--po-hero-height);\n    display: flex;\n    align-items: center;\n  }\n\n  .po-independent-hero-box {\n    max-width: 780px;\n    padding: 76px 0;\n  }\n\n  .po-independent-hero-kicker {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    min-height: 38px;\n    padding: 0 17px;\n    border-radius: 999px;\n    background: rgba(149, 173, 79, 0.2);\n    border: 1px solid rgba(149, 173, 79, 0.4);\n    color: var(--po-white);\n    font-family: var(--po-font-header-2);\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    margin-bottom: 24px;\n    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.16);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n  }\n\n  .po-independent-hero-kicker::before {\n    content: \"\";\n    width: 10px;\n    height: 10px;\n    border-radius: 999px;\n    background: var(--po-orange);\n  }\n\n  .po-independent-hero-title {\n    margin: 0;\n    color: var(--po-white);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(54px, 7.4vw, 104px);\n    line-height: 0.9;\n    letter-spacing: -0.065em;\n    font-weight: 900;\n    font-style: normal;\n    text-transform: none;\n  }\n\n  .po-independent-hero-title em {\n    color: var(--po-orange);\n    font-family: var(--po-font-header-1);\n    font-weight: 900;\n    font-style: normal;\n    text-shadow: 0 18px 40px rgba(255, 150, 14, 0.18);\n  }\n\n  .po-independent-hero-text {\n    margin: 26px 0 0;\n    max-width: 650px;\n    color: rgba(255, 255, 255, 0.86);\n    font-family: var(--po-font-body);\n    font-size: clamp(16px, 1.42vw, 20px);\n    line-height: 1.7;\n    font-weight: 500;\n  }\n\n  .po-independent-hero-actions {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 14px;\n    margin-top: 34px;\n  }\n\n  .po-independent-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 54px;\n    padding: 0 25px;\n    border-radius: 999px;\n    text-decoration: none;\n    font-family: var(--po-font-header-2);\n    font-size: 15px;\n    font-weight: 900;\n    line-height: 1;\n    transition:\n      transform 0.25s ease,\n      box-shadow 0.25s ease,\n      background 0.25s ease,\n      color 0.25s ease,\n      border-color 0.25s ease;\n    white-space: nowrap;\n  }\n\n  .po-independent-btn:hover,\n  .po-independent-btn:focus {\n    text-decoration: none;\n  }\n\n  .po-independent-btn-accent {\n    background: var(--po-orange);\n    color: var(--po-dark-green);\n    border: 2px solid var(--po-orange);\n    box-shadow:\n      0 18px 38px rgba(0, 0, 0, 0.22),\n      0 0 0 7px rgba(255, 150, 14, 0.08);\n  }\n\n  .po-independent-btn-accent:hover,\n  .po-independent-btn-accent:focus {\n    transform: translateY(-2px);\n    background: var(--po-green);\n    color: var(--po-dark-green);\n    border-color: var(--po-green);\n    box-shadow:\n      0 24px 48px rgba(0, 0, 0, 0.26),\n      0 0 0 9px rgba(149, 173, 79, 0.1);\n  }\n\n  .po-independent-btn-outline {\n    border: 2px solid rgba(255, 255, 255, 0.72);\n    color: var(--po-white);\n    background: rgba(255, 255, 255, 0.05);\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n  }\n\n  .po-independent-btn-outline:hover,\n  .po-independent-btn-outline:focus {\n    transform: translateY(-2px);\n    background: var(--po-white);\n    color: var(--po-dark-green);\n    border-color: var(--po-white);\n    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.18);\n  }\n\n  .po-independent-hero-benefits {\n    margin-top: 32px;\n    max-width: 830px;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n\n  .po-independent-hero-benefit {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    min-height: 38px;\n    padding: 0 14px;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.11);\n    border: 1px solid rgba(149, 173, 79, 0.34);\n    color: rgba(255, 255, 255, 0.94);\n    font-family: var(--po-font-body);\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 700;\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n  }\n\n  .po-independent-hero-benefit svg {\n    width: 15px;\n    height: 15px;\n    flex: 0 0 15px;\n    color: var(--po-orange);\n    stroke-width: 2.7;\n  }\n\n  .po-independent-dots {\n    position: absolute;\n    z-index: 7;\n    left: 50%;\n    bottom: 32px;\n    transform: translateX(-50%);\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .po-independent-dot {\n    width: 10px;\n    height: 10px;\n    padding: 0;\n    border-radius: 999px;\n    border: 1px solid rgba(255, 255, 255, 0.72);\n    background: rgba(255, 255, 255, 0.32);\n    cursor: pointer;\n    transition:\n      width 0.25s ease,\n      background 0.25s ease,\n      border-color 0.25s ease;\n  }\n\n  .po-independent-dot.is-active {\n    width: 30px;\n    background: var(--po-orange);\n    border-color: var(--po-orange);\n  }\n\n  @media (max-width: 990px) {\n    .po-independent-hero-section {\n      --po-hero-height: 660px;\n    }\n\n    .po-independent-hero::before {\n      background:\n        linear-gradient(\n          90deg,\n          rgba(41, 63, 7, 0.96) 0%,\n          rgba(41, 63, 7, 0.76) 54%,\n          rgba(41, 63, 7, 0.34) 100%\n        );\n    }\n\n    .po-independent-hero-box {\n      max-width: 650px;\n    }\n  }\n\n  @media (max-width: 640px) {\n    .po-independent-hero-section {\n      --po-hero-height: auto;\n      background: var(--po-white);\n      color: var(--po-dark-green);\n    }\n\n    .po-independent-container {\n      padding-left: 14px;\n      padding-right: 14px;\n    }\n\n    .po-independent-hero {\n      min-height: auto;\n      display: flex;\n      flex-direction: column;\n      background:\n        radial-gradient(circle at 18% 0%, rgba(149, 173, 79, 0.18), transparent 32%),\n        radial-gradient(circle at 88% 18%, rgba(255, 150, 14, 0.12), transparent 34%),\n        var(--po-white);\n      padding: 16px 0 24px;\n    }\n\n    .po-independent-hero::before,\n    .po-independent-hero::after {\n      display: none;\n    }\n\n    .po-independent-hero-slide {\n      position: relative;\n      inset: auto;\n      order: 1;\n      display: none;\n      width: calc(100% - 28px);\n      height: 390px;\n      margin: 0 auto;\n      opacity: 1;\n      transform: none;\n      overflow: hidden;\n      border-radius: 28px;\n      box-shadow: 0 22px 55px rgba(41, 63, 7, 0.14);\n    }\n\n    .po-independent-hero-slide.is-active {\n      display: block;\n      opacity: 1;\n      transform: none;\n    }\n\n    .po-independent-hero-slide::before {\n      content: \"\";\n      position: absolute;\n      inset: 10px;\n      z-index: 2;\n      border: 1px solid rgba(255, 255, 255, 0.52);\n      border-radius: 22px;\n      pointer-events: none;\n    }\n\n    .po-independent-hero-slide::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      z-index: 1;\n      background:\n        linear-gradient(180deg, rgba(41, 63, 7, 0.02) 0%, rgba(41, 63, 7, 0.34) 100%),\n        radial-gradient(circle at 50% 18%, rgba(255, 150, 14, 0.16), transparent 34%);\n      pointer-events: none;\n    }\n\n    .po-independent-hero-slide img {\n      width: 100%;\n      height: 100%;\n      min-height: 0;\n      object-fit: cover;\n      object-position: center;\n    }\n\n    .po-independent-hero-content {\n      order: 2;\n      min-height: auto;\n      display: block;\n      padding-top: 16px;\n    }\n\n    .po-independent-hero-box {\n      max-width: none;\n      width: 100%;\n      padding: 30px 20px 24px;\n      border-radius: 28px;\n      background: var(--po-white);\n      border: 1px solid rgba(41, 63, 7, 0.12);\n      box-shadow: 0 18px 48px rgba(41, 63, 7, 0.1);\n    }\n\n    .po-independent-hero-kicker {\n      min-height: 36px;\n      padding: 0 14px;\n      background: rgba(149, 173, 79, 0.16);\n      border-color: rgba(149, 173, 79, 0.34);\n      color: var(--po-dark-green);\n      box-shadow: none;\n      font-size: 10.5px;\n      letter-spacing: 0.13em;\n      margin-bottom: 18px;\n    }\n\n    .po-independent-hero-title {\n      color: var(--po-dark-green);\n      font-size: clamp(42px, 13vw, 58px);\n      line-height: 0.92;\n      letter-spacing: -0.055em;\n    }\n\n    .po-independent-hero-title em {\n      color: var(--po-orange);\n      text-shadow: none;\n    }\n\n    .po-independent-hero-text {\n      margin-top: 20px;\n      color: rgba(41, 63, 7, 0.76);\n      font-size: 15.5px;\n      line-height: 1.65;\n    }\n\n    .po-independent-hero-actions {\n      flex-direction: column;\n      align-items: stretch;\n      gap: 12px;\n      margin-top: 26px;\n    }\n\n    .po-independent-btn {\n      width: 100%;\n      min-height: 52px;\n      font-size: 13px;\n    }\n\n    .po-independent-btn-accent {\n      background: var(--po-orange);\n      color: var(--po-dark-green);\n      border-color: var(--po-orange);\n      box-shadow: 0 18px 40px rgba(255, 150, 14, 0.18);\n    }\n\n    .po-independent-btn-accent:hover,\n    .po-independent-btn-accent:focus {\n      background: var(--po-green);\n      color: var(--po-dark-green);\n      border-color: var(--po-green);\n    }\n\n    .po-independent-btn-outline {\n      background: transparent;\n      color: var(--po-dark-green);\n      border-color: var(--po-dark-green);\n      backdrop-filter: none;\n      -webkit-backdrop-filter: none;\n    }\n\n    .po-independent-btn-outline:hover,\n    .po-independent-btn-outline:focus {\n      background: var(--po-dark-green);\n      color: var(--po-white);\n      border-color: var(--po-dark-green);\n    }\n\n    .po-independent-hero-benefits {\n      display: grid;\n      grid-template-columns: 1fr;\n      margin-top: 24px;\n      gap: 8px;\n    }\n\n    .po-independent-hero-benefit {\n      min-height: 39px;\n      padding: 10px 13px;\n      border-radius: 18px;\n      background: rgba(149, 173, 79, 0.08);\n      border: 1px solid rgba(149, 173, 79, 0.2);\n      color: rgba(41, 63, 7, 0.86);\n      font-size: 12.5px;\n      line-height: 1.2;\n      backdrop-filter: none;\n      -webkit-backdrop-filter: none;\n    }\n\n    .po-independent-hero-benefit svg {\n      color: var(--po-orange);\n    }\n\n    .po-independent-dots {\n      position: relative;\n      order: 3;\n      left: auto;\n      bottom: auto;\n      transform: none;\n      justify-content: center;\n      margin-top: 16px;\n    }\n\n    .po-independent-dot {\n      border-color: rgba(41, 63, 7, 0.28);\n      background: rgba(41, 63, 7, 0.16);\n    }\n\n    .po-independent-dot.is-active {\n      background: var(--po-orange);\n      border-color: var(--po-orange);\n    }\n  }\n\n  @media (max-width: 390px) {\n    .po-independent-hero-slide {\n      height: 350px;\n      border-radius: 24px;\n    }\n\n    .po-independent-hero-box {\n      padding: 25px 17px 20px;\n      border-radius: 24px;\n    }\n\n    .po-independent-hero-title {\n      font-size: 39px;\n    }\n\n    .po-independent-hero-text {\n      font-size: 14.5px;\n    }\n\n    .po-independent-hero-benefit {\n      font-size: 11.5px;\n    }\n  }\n<\/style>\n\n<section class=\"po-independent-hero-section\">\n  <div class=\"po-independent-hero\" aria-label=\"Fresh organic meals hero\">\n\n    <div class=\"po-independent-hero-slide is-active\">\n      <img\n        src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0787\/2761\/0619\/files\/hero-bowl.jpg?v=1780297792\"\n        alt=\"Vibrant fresh meals with organic ingredients and produce\"\n      >\n    <\/div>\n\n    <div class=\"po-independent-hero-slide\">\n      <img\n        src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0787\/2761\/0619\/files\/hero-meals.jpg?v=1780297793\"\n        alt=\"Fresh organic weekly meals with responsibly sourced ingredients\"\n      >\n    <\/div>\n\n    <div class=\"po-independent-hero-slide\">\n      <img\n        src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0787\/2761\/0619\/files\/hero-ingredients.jpg?v=1780297792\"\n        alt=\"Organic seasonal produce and locally sourced ingredients\"\n      >\n    <\/div>\n\n    <div class=\"po-independent-container po-independent-hero-content\">\n      <div class=\"po-independent-hero-box\">\n\n        <div class=\"po-independent-hero-kicker\">\n          Fresh Weekly Organic Meals\n        <\/div>\n\n        <h1 class=\"po-independent-hero-title\">\n          Eat Fresh. Feel Good. <em>Glow More.<\/em>\n        <\/h1>\n\n        <p class=\"po-independent-hero-text\">\n          Fresh organic meals delivered weekly featuring responsibly sourced proteins,\n          seasonal ingredients, no seed oils, and locally sourced ingredients whenever possible.\n        <\/p>\n\n        <div class=\"po-independent-hero-actions\">\n          <a href=\"\/pages\/delivery-and-pricing\" class=\"po-independent-btn po-independent-btn-accent\">\n           Check Delivery Zone →\n          <\/a>\n\n          <a href=\"\/products\/balanced-family-style-box?view=shoptrigger\" class=\"po-independent-btn po-independent-btn-outline\">\n            View This Week's Menu\n          <\/a>\n        <\/div>\n\n        <div class=\"po-independent-hero-benefits\">\n          <div class=\"po-independent-hero-benefit\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M5 12.5l4.2 4L19 7\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\n            <\/svg>\n            Organic Ingredients\n          <\/div>\n\n          <div class=\"po-independent-hero-benefit\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M5 12.5l4.2 4L19 7\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\n            <\/svg>\n            No Seed Oils\n          <\/div>\n\n          <div class=\"po-independent-hero-benefit\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M5 12.5l4.2 4L19 7\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\n            <\/svg>\n            Seasonal Menus\n          <\/div>\n\n          <div class=\"po-independent-hero-benefit\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M5 12.5l4.2 4L19 7\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\n            <\/svg>\n            Fresh, Never Frozen\n          <\/div>\n\n          <div class=\"po-independent-hero-benefit\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M5 12.5l4.2 4L19 7\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\n            <\/svg>\n            Locally Sourced Whenever Possible\n          <\/div>\n\n          <div class=\"po-independent-hero-benefit\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M5 12.5l4.2 4L19 7\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\n            <\/svg>\n            Flexible Subscriptions\n          <\/div>\n        <\/div>\n\n      <\/div>\n    <\/div>\n\n    <div class=\"po-independent-dots\">\n      <button class=\"po-independent-dot is-active\" type=\"button\" data-po-slide-dot=\"0\" aria-label=\"Go to slide 1\"><\/button>\n      <button class=\"po-independent-dot\" type=\"button\" data-po-slide-dot=\"1\" aria-label=\"Go to slide 2\"><\/button>\n      <button class=\"po-independent-dot\" type=\"button\" data-po-slide-dot=\"2\" aria-label=\"Go to slide 3\"><\/button>\n    <\/div>\n\n  <\/div>\n<\/section>\n\n<script>\n  (function () {\n    function initPlantOrganicsHero() {\n      var sections = document.querySelectorAll('.po-independent-hero-section');\n\n      sections.forEach(function (section) {\n        if (!section || section.dataset.heroReady === 'true') return;\n\n        var hero = section.querySelector('.po-independent-hero');\n        if (!hero) return;\n\n        section.dataset.heroReady = 'true';\n\n        var slides = hero.querySelectorAll('.po-independent-hero-slide');\n        var dots = hero.querySelectorAll('.po-independent-dot');\n        var currentIndex = 0;\n        var intervalTime = 4500;\n        var timer;\n\n        function showSlide(index) {\n          if (!slides.length) return;\n\n          currentIndex = index;\n\n          slides.forEach(function (slide, slideIndex) {\n            slide.classList.toggle('is-active', slideIndex === currentIndex);\n          });\n\n          dots.forEach(function (dot, dotIndex) {\n            dot.classList.toggle('is-active', dotIndex === currentIndex);\n          });\n        }\n\n        function nextSlide() {\n          showSlide((currentIndex + 1) % slides.length);\n        }\n\n        function startSlider() {\n          stopSlider();\n          timer = setInterval(nextSlide, intervalTime);\n        }\n\n        function stopSlider() {\n          if (timer) clearInterval(timer);\n        }\n\n        dots.forEach(function (dot) {\n          dot.addEventListener('click', function () {\n            var index = parseInt(dot.getAttribute('data-po-slide-dot'), 10);\n\n            if (isNaN(index)) return;\n\n            showSlide(index);\n            startSlider();\n          });\n        });\n\n        hero.addEventListener('mouseenter', stopSlider);\n        hero.addEventListener('mouseleave', startSlider);\n\n        showSlide(0);\n        startSlider();\n      });\n    }\n\n    initPlantOrganicsHero();\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initPlantOrganicsHero);\n    }\n\n    document.addEventListener('shopify:section:load', initPlantOrganicsHero);\n  })();\n<\/script>",
        "custom_class": ""
      }
    },
