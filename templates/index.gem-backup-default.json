        "custom_liquid": "<!-- Font Awesome CDN -->\n<link rel=\"stylesheet\" href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.5.1\/css\/all.min.css\">\n\n<section\n  class=\"po-split po-section po-dark po-mission-section\"\n  style=\"\n    --po-page-width: 1320px;\n    --po-sand: #F6C071;\n    --po-orange: #FF9C00;\n    --po-olive: #94AD4E;\n    --po-deep-green: #1E4000;\n    --po-pink: #F0A5D8;\n    --po-lavender: #D1ADCD;\n    --po-cream: #EFE7DA;\n    --po-white: #FFFFFF;\n    --po-charcoal: #494949;\n  \"\n>\n  <style>\n    .po-mission-section,\n    .po-mission-section * {\n      box-sizing: border-box;\n    }\n\n    .po-mission-section {\n      background:\n        radial-gradient(circle at 16% 8%, rgba(255, 156, 0, 0.16), transparent 26%),\n        radial-gradient(circle at 84% 18%, rgba(240, 165, 216, 0.12), transparent 28%),\n        radial-gradient(circle at 50% 100%, rgba(148, 173, 78, 0.16), transparent 34%),\n        linear-gradient(135deg, var(--po-deep-green) 0%, #173900 48%, #102500 100%);\n      color: var(--po-cream);\n      overflow: hidden;\n      position: relative;\n      font-family: \"Montserrat Classic\", Montserrat, Arial, sans-serif;\n    }\n\n    .po-mission-section::before {\n      content: \"\";\n      position: absolute;\n      inset: 22px;\n      border: 1px solid rgba(239, 231, 218, 0.12);\n      border-radius: 30px;\n      pointer-events: none;\n    }\n\n    .po-mission-section::after {\n      content: \"plant organics\";\n      position: absolute;\n      right: 34px;\n      bottom: -18px;\n      color: rgba(255, 255, 255, 0.035);\n      font-family: \"Degular Demo Black\", Georgia, serif;\n      font-size: clamp(64px, 12vw, 160px);\n      line-height: 0.8;\n      letter-spacing: -0.06em;\n      pointer-events: none;\n      white-space: nowrap;\n    }\n\n    .po-mission-section .po-container {\n      width: 100%;\n      max-width: var(--po-page-width);\n      margin: 0 auto;\n      padding: 72px 22px 76px;\n      position: relative;\n      z-index: 2;\n    }\n\n    .po-mission-section .po-center {\n      max-width: 850px;\n      margin: 0 auto;\n      text-align: center;\n    }\n\n    .po-mission-section .po-eyebrow {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      font-size: 12px;\n      font-weight: 850;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      color: var(--po-orange);\n    }\n\n    .po-mission-section .po-eyebrow::before,\n    .po-mission-section .po-eyebrow::after {\n      content: \"\";\n      width: 30px;\n      height: 1px;\n      background: rgba(255, 156, 0, 0.58);\n    }\n\n    .po-mission-section .po-title {\n      margin: 16px 0 0;\n      color: var(--po-white);\n      font-family: \"Degular Demo Black\", Georgia, serif;\n      font-size: clamp(38px, 4.8vw, 68px);\n      line-height: 0.96;\n      letter-spacing: -0.055em;\n      font-weight: 900;\n    }\n\n    .po-mission-section .po-title .accent {\n      color: var(--po-sand);\n    }\n\n    .po-mission-section .po-soft {\n      max-width: 700px;\n      margin: 20px auto 0;\n      color: rgba(239, 231, 218, 0.78);\n      font-size: 17px;\n      line-height: 1.68;\n      font-weight: 500;\n    }\n\n    .po-mission-section .po-pillars {\n      display: grid;\n      grid-template-columns: repeat(4, minmax(0, 1fr));\n      gap: 16px;\n      margin-top: 44px;\n    }\n\n    .po-mission-section .po-pillar {\n      position: relative;\n      min-height: 238px;\n      padding: 26px 22px 24px;\n      border-radius: 24px;\n      background: rgba(255, 255, 255, 0.075);\n      border: 1px solid rgba(239, 231, 218, 0.14);\n      box-shadow: 0 18px 54px rgba(0, 0, 0, 0.14);\n      backdrop-filter: blur(12px);\n      -webkit-backdrop-filter: blur(12px);\n      overflow: hidden;\n      transition:\n        transform 0.28s ease,\n        background 0.28s ease,\n        border-color 0.28s ease,\n        box-shadow 0.28s ease;\n    }\n\n    .po-mission-section .po-pillar::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background:\n        radial-gradient(circle at 22% 14%, rgba(255, 156, 0, 0.15), transparent 30%),\n        linear-gradient(180deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.018));\n      opacity: 0;\n      transition: opacity 0.28s ease;\n      pointer-events: none;\n    }\n\n    .po-mission-section .po-pillar::after {\n      content: \"\";\n      position: absolute;\n      left: 22px;\n      right: 22px;\n      bottom: 0;\n      height: 3px;\n      border-radius: 999px 999px 0 0;\n      background: linear-gradient(90deg, var(--po-orange), var(--po-sand));\n      transform: scaleX(0);\n      transform-origin: left;\n      transition: transform 0.28s ease;\n    }\n\n    .po-mission-section .po-pillar:nth-child(2)::after {\n      background: linear-gradient(90deg, var(--po-olive), var(--po-sand));\n    }\n\n    .po-mission-section .po-pillar:nth-child(3)::after {\n      background: linear-gradient(90deg, var(--po-lavender), var(--po-pink));\n    }\n\n    .po-mission-section .po-pillar:nth-child(4)::after {\n      background: linear-gradient(90deg, var(--po-sand), var(--po-orange));\n    }\n\n    .po-mission-section .po-pillar:hover {\n      transform: translateY(-6px);\n      background: rgba(255, 255, 255, 0.105);\n      border-color: rgba(246, 192, 113, 0.38);\n      box-shadow: 0 26px 74px rgba(0, 0, 0, 0.22);\n    }\n\n    .po-mission-section .po-pillar:hover::before {\n      opacity: 1;\n    }\n\n    .po-mission-section .po-pillar:hover::after {\n      transform: scaleX(1);\n    }\n\n    .po-mission-section .po-pillar-top {\n      position: relative;\n      z-index: 2;\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      gap: 14px;\n      margin-bottom: 22px;\n    }\n\n    .po-mission-section .po-pillar-number {\n      color: rgba(239, 231, 218, 0.38);\n      font-size: 13px;\n      line-height: 1;\n      font-weight: 850;\n      letter-spacing: 0.12em;\n    }\n\n    .po-mission-section .po-pillar-icon {\n      width: 48px;\n      height: 48px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      border-radius: 16px;\n      background: rgba(255, 156, 0, 0.14);\n      border: 1px solid rgba(255, 156, 0, 0.26);\n      color: var(--po-sand);\n      font-size: 20px;\n      transition:\n        transform 0.28s ease,\n        background 0.28s ease,\n        color 0.28s ease;\n    }\n\n    .po-mission-section .po-pillar:nth-child(2) .po-pillar-icon {\n      background: rgba(148, 173, 78, 0.16);\n      border-color: rgba(148, 173, 78, 0.3);\n      color: #C8DB7A;\n    }\n\n    .po-mission-section .po-pillar:nth-child(3) .po-pillar-icon {\n      background: rgba(209, 173, 205, 0.14);\n      border-color: rgba(209, 173, 205, 0.28);\n      color: var(--po-lavender);\n    }\n\n    .po-mission-section .po-pillar:nth-child(4) .po-pillar-icon {\n      background: rgba(246, 192, 113, 0.14);\n      border-color: rgba(246, 192, 113, 0.3);\n      color: var(--po-sand);\n    }\n\n    .po-mission-section .po-pillar:hover .po-pillar-icon {\n      transform: translateY(-2px) scale(1.04);\n      background: var(--po-sand);\n      color: var(--po-deep-green);\n    }\n\n    .po-mission-section .po-pillar h3 {\n      position: relative;\n      z-index: 2;\n      margin: 0;\n      color: var(--po-white);\n      font-family: \"Bricolage Grotesque\", Arial, sans-serif;\n      font-size: 20px;\n      line-height: 1.18;\n      letter-spacing: -0.025em;\n      font-weight: 850;\n    }\n\n    .po-mission-section .po-pillar p {\n      position: relative;\n      z-index: 2;\n      margin: 12px 0 0;\n      color: rgba(239, 231, 218, 0.72);\n      font-size: 14.5px;\n      line-height: 1.62;\n      font-weight: 500;\n    }\n\n    .po-mission-section .po-pillar:hover p {\n      color: rgba(239, 231, 218, 0.88);\n    }\n\n    @media (max-width: 990px) {\n      .po-mission-section .po-container {\n        padding: 66px 20px 70px;\n      }\n\n      .po-mission-section .po-pillars {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: 15px;\n      }\n\n      .po-mission-section .po-pillar {\n        min-height: 220px;\n      }\n    }\n\n    @media (max-width: 640px) {\n      .po-mission-section::before,\n      .po-mission-section::after {\n        display: none;\n      }\n\n      .po-mission-section .po-container {\n        padding: 52px 14px 56px;\n      }\n\n      .po-mission-section .po-eyebrow {\n        font-size: 11px;\n        gap: 8px;\n      }\n\n      .po-mission-section .po-eyebrow::before,\n      .po-mission-section .po-eyebrow::after {\n        width: 22px;\n      }\n\n      .po-mission-section .po-title {\n        margin-top: 14px;\n        font-size: clamp(31px, 9vw, 44px);\n        line-height: 1.06;\n      }\n\n      .po-mission-section .po-soft {\n        margin-top: 16px;\n        font-size: 15.5px;\n        line-height: 1.62;\n      }\n\n      .po-mission-section .po-pillars {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: 10px;\n        margin-top: 32px;\n      }\n\n      .po-mission-section .po-pillar {\n        min-height: 188px;\n        padding: 18px 14px 16px;\n        border-radius: 18px;\n      }\n\n      .po-mission-section .po-pillar-top {\n        margin-bottom: 16px;\n      }\n\n      .po-mission-section .po-pillar-number {\n        font-size: 11px;\n      }\n\n      .po-mission-section .po-pillar-icon {\n        width: 38px;\n        height: 38px;\n        font-size: 16px;\n        border-radius: 13px;\n      }\n\n      .po-mission-section .po-pillar h3 {\n        font-size: 15.5px;\n        line-height: 1.18;\n      }\n\n      .po-mission-section .po-pillar p {\n        margin-top: 9px;\n        font-size: 12.5px;\n        line-height: 1.45;\n      }\n    }\n\n    @media (max-width: 390px) {\n      .po-mission-section .po-container {\n        padding-left: 12px;\n        padding-right: 12px;\n      }\n\n      .po-mission-section .po-pillars {\n        gap: 9px;\n      }\n\n      .po-mission-section .po-pillar {\n        padding: 16px 12px 15px;\n      }\n\n      .po-mission-section .po-pillar h3 {\n        font-size: 14.5px;\n      }\n\n      .po-mission-section .po-pillar p {\n        font-size: 12px;\n      }\n    }\n@import url('https:\/\/fonts.googleapis.com\/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n.po-mission-section {\n  --po-font-header-1: \"Degular Demo Black\", \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n  --po-font-header-2: \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n  --po-font-body: \"Montserrat Classic\", \"Montserrat\", Arial, sans-serif;\n\n  font-family: var(--po-font-body);\n}\n\n.po-mission-section::after,\n.po-mission-section .po-title {\n  font-family: var(--po-font-header-1);\n}\n\n.po-mission-section .po-eyebrow,\n.po-mission-section .po-pillar-number,\n.po-mission-section .po-pillar h3 {\n  font-family: var(--po-font-header-2);\n}\n\n.po-mission-section .po-soft,\n.po-mission-section .po-pillar p {\n  font-family: var(--po-font-body);\n}\n  <\/style>\n\n  <div class=\"po-container\">\n    <div class=\"po-center\">\n      <div class=\"po-eyebrow\">Our Mission<\/div>\n\n      <h2 class=\"po-title\">\n        Make plant-based the <span class=\"accent\">easiest, most delicious<\/span> choice on your plate.\n      <\/h2>\n\n      <p class=\"po-soft\">\n        We're proving that real wellness doesn't require willpower — only better food, made with intention, delivered with love.\n      <\/p>\n    <\/div>\n\n    <div class=\"po-pillars\">\n      <div class=\"po-pillar\">\n        <div class=\"po-pillar-top\">\n          <span class=\"po-pillar-number\">01<\/span>\n          <div class=\"po-pillar-icon\">\n            <i class=\"fa-solid fa-seedling\"><\/i>\n          <\/div>\n        <\/div>\n        <h3>Regeneratively Grown<\/h3>\n        <p>We source only from farms that nurture the soil they grow in.<\/p>\n      <\/div>\n\n      <div class=\"po-pillar\">\n        <div class=\"po-pillar-top\">\n          <span class=\"po-pillar-number\">02<\/span>\n          <div class=\"po-pillar-icon\">\n            <i class=\"fa-solid fa-heart-pulse\"><\/i>\n          <\/div>\n        <\/div>\n        <h3>Made to Heal<\/h3>\n        <p>Anti-inflammatory ingredients chosen by chefs.<\/p>\n      <\/div>\n\n      <div class=\"po-pillar\">\n        <div class=\"po-pillar-top\">\n          <span class=\"po-pillar-number\">03<\/span>\n          <div class=\"po-pillar-icon\">\n            <i class=\"fa-solid fa-earth-americas\"><\/i>\n          <\/div>\n        <\/div>\n        <h3>Lower Footprint<\/h3>\n        <p>Plant-based, locally sourced, compostable packaging — by default.<\/p>\n      <\/div>\n\n      <div class=\"po-pillar\">\n        <div class=\"po-pillar-top\">\n          <span class=\"po-pillar-number\">04<\/span>\n          <div class=\"po-pillar-icon\">\n            <i class=\"fa-solid fa-handshake-angle\"><\/i>\n          <\/div>\n        <\/div>\n        <h3>Truly Honest<\/h3>\n        <p>If it's not on the label, it's not in the food. Ever.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>",
