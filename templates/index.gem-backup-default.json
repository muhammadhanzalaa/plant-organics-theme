        "custom_liquid": "<section class=\"po-split po-featured\" style=\"--po-page-width: 1280px; --po-cream: #f8f4ec; --po-cream-deep: #EEE1C9; --po-forest: #2F7A4E; --po-forest-deep: #073D27; --po-terracotta: #C96E3C; --po-honey: #F1C858; --po-ink: #1E2B21;\">\n  <div class=\"po-featured-label\">As featured in<\/div><div class=\"po-logo-track\">{% assign logos = \"Vogue|Goop|Well+Good|Forbes|BonAppétit|MindBodyGreen|Refinery29|The Cut|Vogue|Goop|Well+Good|Forbes|BonAppétit|MindBodyGreen|Refinery29|The Cut\" | split: \"|\" %}{% for logo in logos %}<span>{{ logo }}<\/span>{% endfor %}<\/div>\n<\/section>",
