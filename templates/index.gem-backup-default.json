    "custom_liquid_wiChMc": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "why glow meals",
      "settings": {
        "custom_liquid": "<style>\n  .po-why-glow,\n  .po-why-glow * {\n    box-sizing: border-box;\n  }\n\n  .po-why-glow {\n    --po-page-width: 1280px;\n    --po-cream: #F7F1E4;\n    --po-cream-deep: #EEE1C9;\n    --po-forest: #2F7A4E;\n    --po-forest-deep: #073D27;\n    --po-terracotta: #C96E3C;\n    --po-honey: #F1C858;\n    --po-ink: #1E2B21;\n\n    width: 100%;\n    background:\n      radial-gradient(circle at 8% 8%, rgba(241, 200, 88, 0.2), transparent 30%),\n      linear-gradient(180deg, var(--po-cream) 0%, var(--po-cream-deep) 100%);\n    color: var(--po-ink);\n    font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    padding: 86px 0;\n    overflow: hidden;\n  }\n\n  .po-why-glow__container {\n    width: 100%;\n    max-width: var(--po-page-width);\n    margin: 0 auto;\n    padding: 0 24px;\n  }\n\n  .po-why-glow__head {\n    display: grid;\n    grid-template-columns: minmax(320px, 0.9fr) minmax(420px, 1.1fr);\n    align-items: end;\n    gap: 64px;\n    margin-bottom: 44px;\n  }\n\n  .po-why-glow__eyebrow {\n    width: fit-content;\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    color: var(--po-terracotta);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    margin-bottom: 18px;\n  }\n\n  .po-why-glow__eyebrow::before {\n    content: \"\";\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: var(--po-terracotta);\n    box-shadow: 0 0 0 6px rgba(201, 110, 60, 0.13);\n    flex: 0 0 9px;\n  }\n\n  .po-why-glow__title {\n    margin: 0;\n    max-width: 560px;\n    color: var(--po-forest-deep);\n    font-family: Fraunces, Georgia, serif;\n    font-size: clamp(44px, 5vw, 74px);\n    line-height: 0.98;\n    letter-spacing: -0.055em;\n    font-weight: 650;\n  }\n\n  .po-why-glow__title span {\n    color: var(--po-terracotta);\n    font-style: italic;\n    font-weight: 520;\n  }\n\n  .po-why-glow__intro {\n    margin: 0;\n    max-width: 640px;\n    color: rgba(30, 43, 33, 0.72);\n    font-size: clamp(16px, 1.35vw, 19px);\n    line-height: 1.65;\n    font-weight: 500;\n  }\n\n  .po-why-glow__grid {\n    display: grid;\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n    gap: 16px;\n  }\n\n  .po-why-glow__card {\n    position: relative;\n    min-height: 286px;\n    padding: 25px 20px 24px;\n    border-radius: 28px;\n    background: rgba(255, 255, 255, 0.52);\n    border: 1px solid rgba(7, 61, 39, 0.1);\n    box-shadow:\n      0 22px 50px rgba(7, 61, 39, 0.08),\n      inset 0 1px 0 rgba(255, 255, 255, 0.64);\n    overflow: hidden;\n    transition:\n      transform 0.28s ease,\n      box-shadow 0.28s ease,\n      border-color 0.28s ease,\n      background 0.28s ease;\n  }\n\n  .po-why-glow__card::before {\n    content: \"\";\n    position: absolute;\n    right: -38px;\n    bottom: -56px;\n    width: 130px;\n    height: 130px;\n    border-radius: 50%;\n    background: rgba(47, 122, 78, 0.08);\n    transition: transform 0.28s ease, background 0.28s ease;\n  }\n\n  .po-why-glow__card:hover {\n    transform: translateY(-5px);\n    background: rgba(255, 255, 255, 0.7);\n    border-color: rgba(7, 61, 39, 0.16);\n    box-shadow:\n      0 28px 62px rgba(7, 61, 39, 0.12),\n      inset 0 1px 0 rgba(255, 255, 255, 0.72);\n  }\n\n  .po-why-glow__card:hover::before {\n    transform: scale(1.15);\n    background: rgba(201, 110, 60, 0.1);\n  }\n\n  .po-why-glow__icon {\n    position: relative;\n    z-index: 1;\n    width: 50px;\n    height: 50px;\n    border-radius: 999px;\n    background: var(--po-forest-deep);\n    color: var(--po-cream);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 20px;\n    box-shadow: 0 14px 30px rgba(7, 61, 39, 0.18);\n  }\n\n  .po-why-glow__icon svg {\n    width: 24px;\n    height: 24px;\n    stroke-width: 2;\n  }\n\n  .po-why-glow__card-title {\n    position: relative;\n    z-index: 1;\n    margin: 0 0 11px;\n    color: var(--po-forest-deep);\n    font-size: 19px;\n    line-height: 1.15;\n    font-weight: 900;\n    letter-spacing: -0.035em;\n  }\n\n  .po-why-glow__text {\n    position: relative;\n    z-index: 1;\n    margin: 0;\n    color: rgba(30, 43, 33, 0.7);\n    font-size: 14.5px;\n    line-height: 1.56;\n    font-weight: 500;\n  }\n\n  @media (max-width: 1180px) {\n    .po-why-glow {\n      padding: 76px 0;\n    }\n\n    .po-why-glow__head {\n      grid-template-columns: 1fr;\n      gap: 20px;\n      margin-bottom: 36px;\n    }\n\n    .po-why-glow__title,\n    .po-why-glow__intro {\n      max-width: 760px;\n    }\n\n    .po-why-glow__grid {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      gap: 16px;\n    }\n\n    .po-why-glow__card {\n      min-height: 245px;\n      padding: 24px 22px;\n    }\n\n    .po-why-glow__card-title {\n      font-size: 19px;\n    }\n\n    .po-why-glow__text {\n      font-size: 14.5px;\n    }\n  }\n\n  @media (max-width: 760px) {\n    .po-why-glow {\n      padding: 62px 0;\n    }\n\n    .po-why-glow__container {\n      padding: 0 16px;\n    }\n\n    .po-why-glow__head {\n      margin-bottom: 30px;\n    }\n\n    .po-why-glow__eyebrow {\n      font-size: 10.5px;\n      margin-bottom: 14px;\n    }\n\n    .po-why-glow__title {\n      font-size: clamp(36px, 11vw, 50px);\n      line-height: 1;\n      letter-spacing: -0.05em;\n    }\n\n    .po-why-glow__intro {\n      font-size: 15.5px;\n      line-height: 1.58;\n    }\n\n    .po-why-glow__grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 10px;\n    }\n\n    .po-why-glow__card {\n      min-height: auto;\n      border-radius: 20px;\n      padding: 16px 13px 18px;\n    }\n\n    .po-why-glow__icon {\n      width: 40px;\n      height: 40px;\n      margin-bottom: 14px;\n    }\n\n    .po-why-glow__icon svg {\n      width: 20px;\n      height: 20px;\n    }\n\n    .po-why-glow__card-title {\n      font-size: 16px;\n      line-height: 1.15;\n      margin-bottom: 8px;\n      letter-spacing: -0.03em;\n    }\n\n    .po-why-glow__text {\n      font-size: 12.8px;\n      line-height: 1.45;\n    }\n  }\n\n  @media (max-width: 390px) {\n    .po-why-glow__container {\n      padding: 0 12px;\n    }\n\n    .po-why-glow__grid {\n      gap: 8px;\n    }\n\n    .po-why-glow__card {\n      padding: 14px 11px 16px;\n      border-radius: 18px;\n    }\n\n    .po-why-glow__card-title {\n      font-size: 15px;\n    }\n\n    .po-why-glow__text {\n      font-size: 12px;\n    }\n  }\n<\/style>\n\n<section class=\"po-why-glow po-split po-section\" id=\"po-why-glow\">\n  <div class=\"po-why-glow__container po-container\">\n    <div class=\"po-why-glow__head\">\n      <div>\n        <div class=\"po-why-glow__eyebrow po-eyebrow\">Why Glow Meals<\/div>\n        <h2 class=\"po-why-glow__title po-title\">\n          Real Food. <span>Made Simple.<\/span>\n        <\/h2>\n      <\/div>\n\n      <p class=\"po-why-glow__intro po-soft\">\n        Clean, fresh, chef-crafted meals made with thoughtful ingredients — prepared weekly to help you eat better without overthinking it.\n      <\/p>\n    <\/div>\n\n    <div class=\"po-why-glow__grid\">\n      <div class=\"po-why-glow__card\">\n        <div class=\"po-why-glow__icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M19.5 4.5C11.7 4.8 6.3 8.8 5.3 15.2C4.9 17.9 6.7 20.1 9.2 20.1C14.8 20.1 18.3 13.3 19.5 4.5Z\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\n            <path d=\"M5.6 18.5C8.3 14.5 11.8 11.8 15.8 10.3\" stroke=\"currentColor\" stroke-linecap=\"round\"\/>\n          <\/svg>\n        <\/div>\n        <h3 class=\"po-why-glow__card-title\">Organic First<\/h3>\n        <p class=\"po-why-glow__text\">\n          We prioritize organic produce and high-quality ingredients whenever possible.\n        <\/p>\n      <\/div>\n\n      <div class=\"po-why-glow__card\">\n        <div class=\"po-why-glow__icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M7.2 14.2C7.2 10.6 12 4.7 12 4.7s4.8 5.9 4.8 9.5A4.8 4.8 0 0 1 7.2 14.2Z\" stroke=\"currentColor\" stroke-linejoin=\"round\"\/>\n            <path d=\"M9.4 14.5C9.4 16 10.6 17.2 12 17.2\" stroke=\"currentColor\" stroke-linecap=\"round\"\/>\n          <\/svg>\n        <\/div>\n        <h3 class=\"po-why-glow__card-title\">No Seed Oils<\/h3>\n        <p class=\"po-why-glow__text\">\n          Our meals are prepared using premium cooking fats and oils—never industrial seed oils.\n        <\/p>\n      <\/div>\n\n      <div class=\"po-why-glow__card\">\n        <div class=\"po-why-glow__icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M7 7.5h10M7 12h10M7 16.5h6\" stroke=\"currentColor\" stroke-linecap=\"round\"\/>\n            <path d=\"M5.4 3.8h13.2c.8 0 1.4.6 1.4 1.4v13.6c0 .8-.6 1.4-1.4 1.4H5.4c-.8 0-1.4-.6-1.4-1.4V5.2c0-.8.6-1.4 1.4-1.4Z\" stroke=\"currentColor\"\/>\n          <\/svg>\n        <\/div>\n        <h3 class=\"po-why-glow__card-title\">Seasonal Variety<\/h3>\n        <p class=\"po-why-glow__text\">\n          Our menu rotates every two weeks to showcase fresh seasonal ingredients and keep meals exciting.\n        <\/p>\n      <\/div>\n\n      <div class=\"po-why-glow__card\">\n        <div class=\"po-why-glow__icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M12 21s7-5.1 7-11.2A7 7 0 0 0 5 9.8C5 15.9 12 21 12 21Z\" stroke=\"currentColor\" stroke-linejoin=\"round\"\/>\n            <circle cx=\"12\" cy=\"9.8\" r=\"2.2\" stroke=\"currentColor\"\/>\n          <\/svg>\n        <\/div>\n        <h3 class=\"po-why-glow__card-title\">Local When Available<\/h3>\n        <p class=\"po-why-glow__text\">\n          We source from local farms and producers whenever possible to support our community and deliver peak freshness.\n        <\/p>\n      <\/div>\n\n      <div class=\"po-why-glow__card\">\n        <div class=\"po-why-glow__icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M6.5 8.2h11l-.7 11H7.2l-.7-11Z\" stroke=\"currentColor\" stroke-linejoin=\"round\"\/>\n            <path d=\"M9 8.2c0-2.3 1.1-3.5 3-3.5s3 1.2 3 3.5\" stroke=\"currentColor\" stroke-linecap=\"round\"\/>\n            <path d=\"M9.5 13h5\" stroke=\"currentColor\" stroke-linecap=\"round\"\/>\n          <\/svg>\n        <\/div>\n        <h3 class=\"po-why-glow__card-title\">Fresh, Never Frozen<\/h3>\n        <p class=\"po-why-glow__text\">\n          Meals are prepared fresh each week and delivered ready to enjoy.\n        <\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>",
