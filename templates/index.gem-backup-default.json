    "custom_liquid_K4rC4D": {
      "type": "custom-liquid",
      "name": "faq",
      "settings": {
        "custom_liquid": "<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n  #po-faq-native,\n  #po-faq-native * {\n    box-sizing: border-box;\n  }\n\n  #po-faq-native {\n    --po-page-width: 1280px;\n\n    --po-pink: #fcb6eb;\n    --po-dark-green: #293f07;\n    --po-green: #95ad4f;\n    --po-orange: #ff960e;\n    --po-purple: #927ec3;\n    --po-white: #ffffff;\n\n    --po-font-header-1: \"Degular Demo Black\", \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-header-2: \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-body: \"Montserrat Classic\", \"Montserrat\", Arial, sans-serif;\n\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    padding: 96px 20px;\n    color: var(--po-dark-green);\n    background:\n      radial-gradient(circle at 10% 8%, rgba(149, 173, 79, 0.18), transparent 30%),\n      radial-gradient(circle at 90% 12%, rgba(255, 150, 14, 0.1), transparent 28%),\n      radial-gradient(circle at 50% 100%, rgba(41, 63, 7, 0.045), transparent 34%),\n      var(--po-white);\n    font-family: var(--po-font-body);\n  }\n\n  #po-faq-native::before {\n    content: \"\";\n    position: absolute;\n    inset: 24px;\n    border: 1px solid rgba(41, 63, 7, 0.1);\n    border-radius: 36px;\n    pointer-events: none;\n  }\n\n  #po-faq-native::after {\n    content: \"questions\";\n    position: absolute;\n    right: -18px;\n    bottom: -14px;\n    color: rgba(41, 63, 7, 0.045);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(76px, 11vw, 170px);\n    font-weight: 900;\n    line-height: 0.8;\n    letter-spacing: -0.07em;\n    white-space: nowrap;\n    pointer-events: none;\n  }\n\n  #po-faq-native .po-container {\n    width: min(var(--po-page-width), calc(100% - 32px));\n    margin: 0 auto;\n    position: relative;\n    z-index: 2;\n  }\n\n  #po-faq-native .po-center {\n    max-width: 820px;\n    margin: 0 auto 42px;\n    text-align: center;\n  }\n\n  #po-faq-native .po-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    background: rgba(149, 173, 79, 0.18);\n    color: var(--po-dark-green);\n    border: 1px solid rgba(149, 173, 79, 0.36);\n    border-radius: 999px;\n    padding: 10px 18px;\n    font-family: var(--po-font-header-2);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n\n  #po-faq-native .po-eyebrow::before {\n    content: \"\";\n    width: 10px;\n    height: 10px;\n    background: var(--po-orange);\n    border-radius: 50%;\n    flex: 0 0 10px;\n  }\n\n  #po-faq-native .po-title {\n    margin: 18px 0 0;\n    color: var(--po-dark-green);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(44px, 5.2vw, 78px);\n    line-height: 0.94;\n    letter-spacing: -0.065em;\n    font-weight: 900;\n  }\n\n  #po-faq-native .po-title .accent {\n    color: var(--po-orange);\n  }\n\n  #po-faq-native .po-soft {\n    max-width: 680px;\n    margin: 18px auto 0;\n    color: rgba(41, 63, 7, 0.72);\n    font-family: var(--po-font-body);\n    font-size: 16.5px;\n    line-height: 1.7;\n    font-weight: 500;\n  }\n\n  #po-faq-native .po-faq-list {\n    max-width: 980px;\n    margin: 0 auto;\n    display: grid;\n    gap: 14px;\n  }\n\n  #po-faq-native .po-faq-item {\n    position: relative;\n    overflow: hidden;\n    border-radius: 24px;\n    background: var(--po-white);\n    border: 1px solid rgba(41, 63, 7, 0.12);\n    box-shadow:\n      inset 0 1px 0 rgba(255, 255, 255, 1),\n      0 18px 46px rgba(41, 63, 7, 0.08);\n    transition:\n      transform 0.28s ease,\n      border-color 0.28s ease,\n      box-shadow 0.28s ease;\n  }\n\n  #po-faq-native .po-faq-item::before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    bottom: 0;\n    width: 5px;\n    background: var(--po-orange);\n    opacity: 0;\n    transition: opacity 0.28s ease;\n  }\n\n  #po-faq-native .po-faq-item:nth-child(2)::before,\n  #po-faq-native .po-faq-item:nth-child(5)::before {\n    background: var(--po-green);\n  }\n\n  #po-faq-native .po-faq-item:nth-child(3)::before,\n  #po-faq-native .po-faq-item:nth-child(6)::before {\n    background: var(--po-dark-green);\n  }\n\n  #po-faq-native .po-faq-item:hover,\n  #po-faq-native .po-faq-item[open] {\n    transform: translateY(-3px);\n    border-color: rgba(149, 173, 79, 0.5);\n    box-shadow:\n      inset 0 1px 0 rgba(255, 255, 255, 1),\n      0 26px 64px rgba(41, 63, 7, 0.13);\n  }\n\n  #po-faq-native .po-faq-item[open]::before {\n    opacity: 1;\n  }\n\n  #po-faq-native .po-faq-q {\n    width: 100%;\n    list-style: none;\n    padding: 24px 26px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    text-align: left;\n    color: var(--po-dark-green);\n    font-family: var(--po-font-header-2);\n    font-size: clamp(20px, 2.2vw, 28px);\n    line-height: 1.12;\n    letter-spacing: -0.045em;\n    font-weight: 900;\n    cursor: pointer;\n    overflow-wrap: anywhere;\n  }\n\n  #po-faq-native .po-faq-q::-webkit-details-marker {\n    display: none;\n  }\n\n  #po-faq-native .po-faq-q::marker {\n    display: none;\n    content: \"\";\n  }\n\n  #po-faq-native .po-faq-q span:first-child {\n    min-width: 0;\n  }\n\n  #po-faq-native .po-plus {\n    width: 38px;\n    height: 38px;\n    border-radius: 999px;\n    background: var(--po-dark-green);\n    color: var(--po-white);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 38px;\n    font-size: 24px;\n    line-height: 1;\n    font-family: Arial, sans-serif;\n    transition:\n      transform 0.25s ease,\n      background 0.25s ease,\n      color 0.25s ease;\n  }\n\n  #po-faq-native .po-faq-item[open] .po-plus {\n    background: var(--po-orange);\n    color: var(--po-dark-green);\n    transform: rotate(45deg);\n  }\n\n  #po-faq-native .po-faq-a {\n    padding: 0 26px 24px;\n    color: rgba(41, 63, 7, 0.72);\n    font-family: var(--po-font-body);\n    font-size: 16px;\n    line-height: 1.72;\n    font-weight: 500;\n  }\n\n  #po-faq-native .po-faq-a p {\n    margin: 0;\n  }\n\n  #po-faq-native .po-faq-a ul {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: grid;\n    gap: 9px;\n  }\n\n  #po-faq-native .po-faq-a li {\n    position: relative;\n    padding-left: 24px;\n  }\n\n  #po-faq-native .po-faq-a li::before {\n    content: \"✓\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: var(--po-orange);\n    font-weight: 900;\n  }\n\n  #po-faq-native .po-faq-a strong {\n    color: var(--po-dark-green);\n    font-weight: 900;\n  }\n\n  #po-faq-native .po-faq-chips {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n    margin-top: 14px;\n  }\n\n  #po-faq-native .po-faq-chip {\n    min-height: 32px;\n    display: inline-flex;\n    align-items: center;\n    padding: 0 12px;\n    border-radius: 999px;\n    background: rgba(149, 173, 79, 0.12);\n    border: 1px solid rgba(149, 173, 79, 0.22);\n    color: var(--po-dark-green);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 800;\n  }\n\n  @media (max-width: 990px) {\n    #po-faq-native {\n      padding: 76px 18px;\n    }\n\n    #po-faq-native::before,\n    #po-faq-native::after {\n      display: none;\n    }\n\n    #po-faq-native .po-container {\n      width: 100%;\n    }\n\n    #po-faq-native .po-center {\n      margin-bottom: 34px;\n    }\n\n    #po-faq-native .po-faq-list {\n      max-width: 760px;\n    }\n  }\n\n  @media (max-width: 640px) {\n    #po-faq-native {\n      padding: 62px 14px;\n    }\n\n    #po-faq-native .po-center {\n      margin-bottom: 30px;\n    }\n\n    #po-faq-native .po-eyebrow {\n      padding: 9px 14px;\n      font-size: 10.5px;\n      letter-spacing: 0.12em;\n    }\n\n    #po-faq-native .po-title {\n      font-size: clamp(38px, 10.5vw, 52px);\n      line-height: 1;\n      letter-spacing: -0.055em;\n    }\n\n    #po-faq-native .po-soft {\n      margin-top: 14px;\n      font-size: 15px;\n      line-height: 1.58;\n    }\n\n    #po-faq-native .po-faq-list {\n      gap: 12px;\n    }\n\n    #po-faq-native .po-faq-item {\n      border-radius: 20px;\n    }\n\n    #po-faq-native .po-faq-q {\n      padding: 19px 16px;\n      font-size: 19px;\n      line-height: 1.16;\n      gap: 12px;\n    }\n\n    #po-faq-native .po-plus {\n      width: 34px;\n      height: 34px;\n      flex-basis: 34px;\n      font-size: 22px;\n    }\n\n    #po-faq-native .po-faq-a {\n      padding: 0 16px 20px;\n      font-size: 14.4px;\n      line-height: 1.58;\n    }\n\n    #po-faq-native .po-faq-a li {\n      padding-left: 21px;\n    }\n\n    #po-faq-native .po-faq-chip {\n      width: fit-content;\n      min-height: 30px;\n      font-size: 11.5px;\n    }\n  }\n\n  @media (max-width: 430px) {\n    #po-faq-native {\n      padding: 54px 12px;\n    }\n\n    #po-faq-native .po-title {\n      font-size: clamp(34px, 11vw, 46px);\n    }\n\n    #po-faq-native .po-faq-q {\n      padding: 17px 14px;\n      font-size: 17.5px;\n    }\n\n    #po-faq-native .po-plus {\n      width: 31px;\n      height: 31px;\n      flex-basis: 31px;\n      font-size: 20px;\n    }\n\n    #po-faq-native .po-faq-a {\n      padding: 0 14px 18px;\n      font-size: 13.8px;\n    }\n  }\n\n  @media (hover: none) {\n    #po-faq-native .po-faq-item:hover {\n      transform: none;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #po-faq-native .po-faq-item,\n    #po-faq-native .po-faq-item::before,\n    #po-faq-native .po-plus {\n      transition: none !important;\n    }\n  }\n<\/style>\n\n<section class=\"po-split po-section po-faq-section\" id=\"po-faq-native\">\n  <div class=\"po-container\">\n    <div class=\"po-center\">\n      <div class=\"po-eyebrow\">Frequently Asked Questions<\/div>\n\n      <h2 class=\"po-title\">\n        Everything you need to know before your <span class=\"accent\">first delivery.<\/span>\n      <\/h2>\n\n     <p class=\"po-soft\">\n  From how Glow Meals works to menu updates, meal choices, dietary notes, subscriptions, and weekly order deadlines — here are the key things customers should know before ordering.\n<\/p>\n<\/div>\n\n<div class=\"po-faq-list\">\n  <details class=\"po-faq-item\" open>\n    <summary class=\"po-faq-q\">\n      <span>How does Glow Meals work?<\/span>\n      <span class=\"po-plus\">+<\/span>\n    <\/summary>\n\n    <div class=\"po-faq-a\">\n      <ul>\n        <li>Glow Meals is a weekly organic meal delivery service designed to make healthy eating simple and convenient.<\/li>\n        <li>Choose a subscription plan, select your meals from the rotating menu, and receive fresh meals at your door each week.<\/li>\n        <li>Every order is prepared fresh using high-quality ingredients and arrives ready to enjoy.<\/li>\n      <\/ul>\n    <\/div>\n  <\/details>\n\n  <details class=\"po-faq-item\">\n    <summary class=\"po-faq-q\">\n      <span>What makes Glow Meals different?<\/span>\n      <span class=\"po-plus\">+<\/span>\n    <\/summary>\n\n    <div class=\"po-faq-a\">\n      <ul>\n        <li>Real food made with ingredients you can feel good about.<\/li>\n        <li>Organic ingredients whenever possible and responsibly sourced proteins.<\/li>\n        <li>No industrial seed oils, no artificial preservatives, and fresh meals that are never frozen.<\/li>\n        <li>Seasonal ingredients, rotating menu features, and local suppliers whenever available.<\/li>\n      <\/ul>\n    <\/div>\n  <\/details>\n\n  <details class=\"po-faq-item\">\n    <summary class=\"po-faq-q\">\n      <span>How often does the menu change?<\/span>\n      <span class=\"po-plus\">+<\/span>\n    <\/summary>\n\n    <div class=\"po-faq-a\">\n      <ul>\n        <li>The Glow Meals menu rotates every two weeks.<\/li>\n        <li>A new menu is released every other Sunday morning.<\/li>\n        <li>Customers can browse upcoming proteins, sides, salads, seasonal features, and add-ons before placing or updating orders.<\/li>\n      <\/ul>\n    <\/div>\n  <\/details>\n\n  <details class=\"po-faq-item\">\n    <summary class=\"po-faq-q\">\n      <span>Can I choose or customize my meals?<\/span>\n      <span class=\"po-plus\">+<\/span>\n    <\/summary>\n\n    <div class=\"po-faq-a\">\n      <ul>\n        <li>Yes. You can select from available proteins, sides, salads, and seasonal features each week.<\/li>\n        <li>You can mix and match items to create meals that fit your lifestyle and dietary preferences.<\/li>\n        <li>Menu items may be labeled so customers can filter based on their preferences while ordering.<\/li>\n      <\/ul>\n\n      <div class=\"po-faq-chips\">\n        <span class=\"po-faq-chip\">Vegan (V)<\/span>\n        <span class=\"po-faq-chip\">Vegetarian (VG)<\/span>\n        <span class=\"po-faq-chip\">Gluten-Free (GF)<\/span>\n        <span class=\"po-faq-chip\">Dairy-Free when applicable<\/span>\n      <\/div>\n    <\/div>\n  <\/details>\n\n  <details class=\"po-faq-item\">\n    <summary class=\"po-faq-q\">\n      <span>Do you accommodate food allergies or special dietary needs?<\/span>\n      <span class=\"po-plus\">+<\/span>\n    <\/summary>\n\n    <div class=\"po-faq-a\">\n      <ul>\n        <li>Glow Meals provides detailed ingredient information and dietary filters to help customers make informed choices.<\/li>\n        <li>We do not currently offer customized meals, ingredient substitutions, or individualized allergy accommodations.<\/li>\n        <li>Meals are prepared in a kitchen that handles common allergens including dairy, eggs, nuts, soy, wheat, fish, and shellfish.<\/li>\n        <li>Because cross-contact is possible, we cannot guarantee that any meal is completely allergen-free.<\/li>\n      <\/ul>\n    <\/div>\n  <\/details>\n\n  <details class=\"po-faq-item\">\n    <summary class=\"po-faq-q\">\n      <span>What subscription plans and add-ons are available?<\/span>\n      <span class=\"po-plus\">+<\/span>\n    <\/summary>\n\n    <div class=\"po-faq-a\">\n      <ul>\n        <li><strong>Starter<\/strong> — 6 individual meals, perfect for individuals and busy professionals.<\/li>\n        <li><strong>Most Loved<\/strong> — family-style meal prep with approximately 9 meals worth of food.<\/li>\n        <li><strong>Family<\/strong> — large family-style meal prep with approximately 12–14 meals worth of food.<\/li>\n        <li>Optional add-ons include breakfast, bakery, fresh-pressed juices, and family-style protein add-ons.<\/li>\n        <li>Every subscription includes Glow Society membership at no additional cost.<\/li>\n      <\/ul>\n    <\/div>\n  <\/details>\n\n  <details class=\"po-faq-item\">\n    <summary class=\"po-faq-q\">\n      <span>When is the ordering deadline?<\/span>\n      <span class=\"po-plus\">+<\/span>\n    <\/summary>\n\n    <div class=\"po-faq-a\">\n      <ul>\n        <li>Orders and meal updates for the upcoming delivery week must be submitted by Tuesday at 11:59 PM.<\/li>\n        <li>After the cutoff, meal selections are locked so the kitchen can source ingredients and begin production.<\/li>\n        <li>Plan changes, skips, pauses, cancellations, dietary preference updates, and delivery address changes must also be submitted before the Tuesday cutoff.<\/li>\n      <\/ul>\n    <\/div>\n  <\/details>\n<\/div>\n  <\/div>\n<\/section>\n\n<script>\n  (function () {\n    function initNativeFaqSingleOpen() {\n      var section = document.querySelector('#po-faq-native');\n      if (!section || section.dataset.singleOpenReady === 'true') return;\n\n      section.dataset.singleOpenReady = 'true';\n\n      var items = section.querySelectorAll('details.po-faq-item');\n\n      items.forEach(function (item) {\n        item.addEventListener('toggle', function () {\n          if (!item.open) return;\n\n          items.forEach(function (otherItem) {\n            if (otherItem !== item) {\n              otherItem.removeAttribute('open');\n            }\n          });\n        });\n      });\n    }\n\n    initNativeFaqSingleOpen();\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initNativeFaqSingleOpen);\n    }\n\n    document.addEventListener('shopify:section:load', initNativeFaqSingleOpen);\n  })();\n<\/script>",
        "custom_class": ""
      }
    },
    "custom_liquid_mGnmLQ": {
      "type": "custom-liquid",
      "name": "final cta",
      "settings": {
        "custom_liquid": "<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n  .po-emotive-upgrade,\n  .po-emotive-upgrade * {\n    box-sizing: border-box;\n  }\n\n  .po-emotive-upgrade {\n    --po-page-width: 1280px;\n\n    \/* Actual Brand Colors *\/\n    --po-pink: #fcb6eb;\n    --po-dark-green: #293f07;\n    --po-green: #95ad4f;\n    --po-orange: #ff960e;\n    --po-purple: #927ec3;\n    --po-white: #ffffff;\n\n    \/* Brand Fonts *\/\n    --po-font-header-1: \"Degular Demo Black\", \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-header-2: \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-body: \"Montserrat Classic\", \"Montserrat\", Arial, sans-serif;\n\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    isolation: isolate;\n    padding: 104px 0;\n    background:\n      radial-gradient(circle at 18% 18%, rgba(149, 173, 79, 0.22), transparent 30%),\n      radial-gradient(circle at 82% 72%, rgba(255, 150, 14, 0.16), transparent 32%),\n      radial-gradient(circle at 50% 110%, rgba(255, 255, 255, 0.07), transparent 36%),\n      linear-gradient(135deg, var(--po-dark-green) 0%, #203405 58%, #172603 100%);\n    color: var(--po-white);\n    font-family: var(--po-font-body);\n  }\n\n  .po-emotive-upgrade::before {\n    content: \"\";\n    position: absolute;\n    inset: 18px;\n    border: 1px solid rgba(255, 255, 255, 0.12);\n    border-radius: 44px;\n    pointer-events: none;\n    z-index: 1;\n  }\n\n  .po-emotive-upgrade::after {\n    content: \"real food\";\n    position: absolute;\n    right: -16px;\n    bottom: -18px;\n    z-index: 0;\n    color: rgba(255, 255, 255, 0.04);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(72px, 12vw, 170px);\n    line-height: 0.8;\n    font-weight: 900;\n    letter-spacing: -0.07em;\n    white-space: nowrap;\n    pointer-events: none;\n  }\n\n  .po-emotive-upgrade__container {\n    position: relative;\n    z-index: 3;\n    width: 100%;\n    max-width: var(--po-page-width);\n    margin: 0 auto;\n    padding: 0 24px;\n    text-align: center;\n  }\n\n  .po-emotive-upgrade__pill {\n    width: fit-content;\n    margin: 0 auto 24px;\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    min-height: 38px;\n    padding: 0 16px;\n    border-radius: 999px;\n    background: rgba(149, 173, 79, 0.14);\n    border: 1px solid rgba(149, 173, 79, 0.34);\n    color: rgba(255, 255, 255, 0.88);\n    font-family: var(--po-font-header-2);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n  }\n\n  .po-emotive-upgrade__pill span {\n    width: 8px;\n    height: 8px;\n    border-radius: 999px;\n    background: var(--po-orange);\n    box-shadow: 0 0 0 6px rgba(255, 150, 14, 0.12);\n  }\n\n  .po-emotive-upgrade__script {\n    margin-bottom: 18px;\n    color: var(--po-orange);\n    font-family: var(--po-font-header-2);\n    font-size: clamp(20px, 2.2vw, 32px);\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: -0.035em;\n    transform: rotate(-1deg);\n  }\n\n  .po-emotive-upgrade__title {\n    margin: 0 auto;\n    max-width: 940px;\n    color: var(--po-white);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(48px, 7vw, 96px);\n    line-height: 0.95;\n    letter-spacing: -0.065em;\n    font-weight: 900;\n  }\n\n  .po-emotive-upgrade__title em {\n    color: var(--po-orange);\n    font-style: normal;\n    font-weight: 900;\n    text-shadow: 0 18px 40px rgba(255, 150, 14, 0.16);\n  }\n\n  .po-emotive-upgrade__text {\n    max-width: 650px;\n    margin: 28px auto 0;\n    color: rgba(255, 255, 255, 0.78);\n    font-family: var(--po-font-body);\n    font-size: clamp(16px, 1.45vw, 19px);\n    line-height: 1.65;\n    font-weight: 500;\n  }\n\n  .po-emotive-upgrade__actions {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n    flex-wrap: wrap;\n    margin-top: 36px;\n  }\n\n  .po-emotive-upgrade__btn {\n    min-height: 56px;\n    padding: 0 28px;\n    border-radius: 999px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    text-decoration: none;\n    font-family: var(--po-font-header-2);\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    transition:\n      transform 0.25s ease,\n      box-shadow 0.25s ease,\n      background 0.25s ease,\n      color 0.25s ease,\n      border-color 0.25s ease;\n  }\n\n  .po-emotive-upgrade__btn svg {\n    width: 16px;\n    height: 16px;\n    stroke-width: 2.4;\n  }\n\n  .po-emotive-upgrade__btn--accent {\n    background: var(--po-orange);\n    color: var(--po-dark-green);\n    border: 2px solid var(--po-orange);\n    box-shadow:\n      0 18px 42px rgba(0, 0, 0, 0.24),\n      0 0 0 7px rgba(255, 150, 14, 0.08);\n  }\n\n  .po-emotive-upgrade__btn--accent:hover,\n  .po-emotive-upgrade__btn--accent:focus {\n    transform: translateY(-2px);\n    background: var(--po-green);\n    border-color: var(--po-green);\n    color: var(--po-dark-green);\n    box-shadow:\n      0 24px 54px rgba(0, 0, 0, 0.3),\n      0 0 0 9px rgba(149, 173, 79, 0.1);\n    text-decoration: none;\n  }\n\n  .po-emotive-upgrade__btn--outline {\n    background: rgba(255, 255, 255, 0.06);\n    color: var(--po-white);\n    border: 2px solid rgba(255, 255, 255, 0.52);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n  }\n\n  .po-emotive-upgrade__btn--outline:hover,\n  .po-emotive-upgrade__btn--outline:focus {\n    transform: translateY(-2px);\n    background: var(--po-white);\n    color: var(--po-dark-green);\n    border-color: var(--po-white);\n    text-decoration: none;\n  }\n\n  .po-emotive-upgrade__