s: 30px;\n    pointer-events: none;\n  }\n\n  #po-about .po-round-img::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    background:\n      linear-gradient(180deg, rgba(41, 63, 7, 0.02), rgba(41, 63, 7, 0.22)),\n      radial-gradient(circle at 18% 16%, rgba(252, 182, 235, 0.26), transparent 32%),\n      radial-gradient(circle at 84% 20%, rgba(145, 126, 195, 0.24), transparent 30%);\n    pointer-events: none;\n  }\n\n  #po-about .po-round-img img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    transition: transform 0.5s ease, filter 0.5s ease;\n  }\n\n  #po-about .po-round-img:hover img {\n    transform: scale(1.045);\n    filter: saturate(1.08) contrast(1.03);\n  }\n\n  #po-about .po-sticker {\n    position: absolute;\n    right: 6px;\n    bottom: 78px;\n    z-index: 4;\n    width: 220px;\n    padding: 24px 22px;\n    border-radius: 28px;\n    background:\n      radial-gradient(circle at 16% 10%, rgba(252, 182, 235, 0.28), transparent 32%),\n      linear-gradient(135deg, var(--po-dark-green) 0%, #382a62 100%);\n    color: var(--po-white);\n    border: 2px solid var(--po-pink);\n    box-shadow:\n      0 24px 58px rgba(41, 63, 7, 0.22),\n      0 0 0 8px rgba(252, 182, 235, 0.12);\n    transform: rotate(-3deg);\n  }\n\n  #po-about .po-sticker::before {\n    content: \"\";\n    position: absolute;\n    width: 58px;\n    height: 58px;\n    right: -18px;\n    top: -18px;\n    border-radius: 999px;\n    background: var(--po-purple);\n    box-shadow: 0 0 0 10px rgba(145, 126, 195, 0.16);\n    z-index: -1;\n  }\n\n  #po-about .po-script {\n    color: var(--po-white);\n    font-family: var(--po-font-header-1);\n    font-size: 25px;\n    line-height: 0.98;\n    letter-spacing: -0.045em;\n    font-weight: 900;\n  }\n\n  #po-about .po-founder-caption {\n    margin-top: 10px;\n    color: rgba(255, 255, 255, 0.76);\n    font-family: var(--po-font-body);\n    font-size: 11px;\n    line-height: 1.2;\n    font-weight: 900;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n  }\n\n  #po-about .po-spin {\n    position: absolute;\n    left: -20px;\n    bottom: 18px;\n    z-index: 3;\n    width: 118px;\n    height: 118px;\n    border-radius: 999px;\n    display: grid;\n    place-items: center;\n    text-align: center;\n    background:\n      radial-gradient(circle at 30% 26%, rgba(255, 255, 255, 0.45), transparent 34%),\n      linear-gradient(135deg, var(--po-pink), var(--po-purple));\n    color: var(--po-dark-green);\n    border: 7px solid var(--po-white);\n    box-shadow:\n      0 18px 45px rgba(41, 63, 7, 0.2),\n      0 0 0 8px rgba(145, 126, 195, 0.12);\n    font-family: var(--po-font-header-2);\n    font-size: 13px;\n    line-height: 1.2;\n    font-weight: 900;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n  }\n\n  #po-about .po-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    background: linear-gradient(135deg, rgba(252, 182, 235, 0.34), rgba(145, 126, 195, 0.18));\n    color: var(--po-dark-green);\n    border: 1px solid rgba(145, 126, 195, 0.32);\n    border-radius: 999px;\n    padding: 10px 18px;\n    font-family: var(--po-font-header-2);\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    box-shadow: 0 12px 30px rgba(145, 126, 195, 0.09);\n  }\n\n  #po-about .po-eyebrow::before {\n    content: \"\";\n    width: 10px;\n    height: 10px;\n    border-radius: 999px;\n    background: var(--po-purple);\n    box-shadow: 0 0 0 5px rgba(145, 126, 195, 0.15);\n  }\n\n  #po-about .po-title {\n    margin: 18px 0 0;\n    max-width: 780px;\n    color: var(--po-dark-green);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(42px, 5.2vw, 78px);\n    line-height: 0.92;\n    letter-spacing: -0.06em;\n    font-weight: 900;\n  }\n\n  #po-about .po-title .accent {\n    color: var(--po-purple);\n    background: linear-gradient(90deg, var(--po-purple), #b976d7, var(--po-pink), var(--po-orange));\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n\n  #po-about .po-two-col-text {\n    margin-top: 30px;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 22px;\n  }\n\n  #po-about .po-soft {\n    padding: 28px;\n    border-radius: 30px;\n    background:\n      linear-gradient(135deg, rgba(255, 240, 251, 0.88), rgba(243, 239, 255, 0.8)),\n      var(--po-white);\n    border: 1px solid rgba(145, 126, 195, 0.2);\n    box-shadow:\n      0 22px 58px rgba(41, 63, 7, 0.08),\n      inset 0 1px 0 rgba(255, 255, 255, 0.85);\n  }\n\n  #po-about .po-two-col-text p {\n    margin: 0;\n    color: rgba(41, 63, 7, 0.78);\n    font-family: var(--po-font-body);\n    font-size: 15.5px;\n    line-height: 1.75;\n    font-weight: 500;\n  }\n\n  #po-about .po-two-col-text strong {\n    color: var(--po-dark-green) !important;\n    font-weight: 900;\n  }\n\n  #po-about .po-stats {\n    margin-top: 28px;\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 14px;\n  }\n\n  #po-about .po-stats > div {\n    position: relative;\n    overflow: hidden;\n    padding: 24px 20px;\n    border-radius: 26px;\n    background: var(--po-white);\n    border: 1px solid rgba(145, 126, 195, 0.18);\n    box-shadow: 0 18px 48px rgba(41, 63, 7, 0.08);\n    transition:\n      transform 0.25s ease,\n      box-shadow 0.25s ease,\n      border-color 0.25s ease;\n  }\n\n  #po-about .po-stats > div:nth-child(1) {\n    background: linear-gradient(135deg, #ffffff, rgba(255, 240, 251, 0.9));\n  }\n\n  #po-about .po-stats > div:nth-child(2) {\n    background: linear-gradient(135deg, #ffffff, rgba(243, 239, 255, 0.92));\n  }\n\n  #po-about .po-stats > div:nth-child(3) {\n    background: linear-gradient(135deg, #ffffff, rgba(255, 244, 229, 0.88));\n  }\n\n  #po-about .po-stats > div::before {\n    content: \"\";\n    position: absolute;\n    width: 72px;\n    height: 72px;\n    right: -26px;\n    top: -28px;\n    border-radius: 999px;\n    background: rgba(252, 182, 235, 0.36);\n    pointer-events: none;\n  }\n\n  #po-about .po-stats > div:nth-child(2)::before {\n    background: rgba(145, 126, 195, 0.3);\n  }\n\n  #po-about .po-stats > div:nth-child(3)::before {\n    background: rgba(255, 150, 14, 0.2);\n  }\n\n  #po-about .po-stats > div::after {\n    content: \"\";\n    position: absolute;\n    left: 22px;\n    right: 22px;\n    bottom: 0;\n    height: 4px;\n    background: linear-gradient(90deg, var(--po-pink), var(--po-purple), var(--po-orange));\n    border-radius: 999px 999px 0 0;\n    transform: scaleX(0);\n    transform-origin: center;\n    transition: transform 0.25s ease;\n  }\n\n  #po-about .po-stats > div:hover {\n    transform: translateY(-3px);\n    border-color: rgba(145, 126, 195, 0.38);\n    box-shadow: 0 24px 58px rgba(41, 63, 7, 0.14);\n  }\n\n  #po-about .po-stats > div:hover::after {\n    transform: scaleX(1);\n  }\n\n  #po-about .po-stat-num {\n    position: relative;\n    z-index: 1;\n    color: var(--po-dark-green);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(34px, 3.2vw, 50px);\n    line-height: 0.95;\n    letter-spacing: -0.055em;\n    font-weight: 900;\n  }\n\n  #po-about .po-stat-label {\n    position: relative;\n    z-index: 1;\n    margin-top: 8px;\n    color: rgba(41, 63, 7, 0.68);\n    font-family: var(--po-font-body);\n    font-size: 12px;\n    line-height: 1.35;\n    font-weight: 900;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n\n  @media (max-width: 990px) {\n    #po-about {\n      padding: 76px 0;\n    }\n\n    #po-about::before,\n    #po-about::after {\n      display: none;\n    }\n\n    #po-about .po-about-grid {\n      grid-template-columns: 1fr;\n      gap: 44px;\n    }\n\n    #po-about .po-image-card {\n      min-height: auto;\n      max-width: 560px;\n      margin: 0 auto;\n      width: 100%;\n      padding-bottom: 70px;\n    }\n\n    #po-about .po-round-img {\n      width: 100%;\n    }\n\n    #po-about .po-sticker {\n      right: 14px;\n      bottom: 34px;\n    }\n\n    #po-about .po-spin {\n      left: 14px;\n      bottom: 20px;\n    }\n  }\n\n  @media (max-width: 640px) {\n    #po-about {\n      padding: 64px 0;\n    }\n\n    #po-about .po-container {\n      padding-left: 14px;\n      padding-right: 14px;\n    }\n\n    #po-about .po-image-card {\n      padding-bottom: 96px;\n    }\n\n    #po-about .po-round-img {\n      border-radius: 30px;\n      box-shadow:\n        0 24px 58px rgba(41, 63, 7, 0.13),\n        10px 10px 0 rgba(252, 182, 235, 0.24),\n        -8px -8px 0 rgba(145, 126, 195, 0.12);\n    }\n\n    #po-about .po-round-img::before {\n      inset: 10px;\n      border-radius: 22px;\n    }\n\n    #po-about .po-sticker {\n      width: calc(100% - 42px);\n      right: 21px;\n      bottom: 28px;\n      padding: 20px;\n      border-radius: 24px;\n      transform: rotate(-1.5deg);\n    }\n\n    #po-about .po-script {\n      font-size: 23px;\n    }\n\n    #po-about .po-spin {\n      width: 92px;\n      height: 92px;\n      left: 20px;\n      bottom: 128px;\n      border-width: 5px;\n      font-size: 10.5px;\n    }\n\n    #po-about .po-title {\n      font-size: clamp(38px, 12vw, 54px);\n    }\n\n    #po-about .po-two-col-text {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n\n    #po-about .po-soft {\n      padding: 22px;\n      border-radius: 24px;\n    }\n\n    #po-about .po-two-col-text p {\n      font-size: 14.5px;\n    }\n\n    #po-about .po-stats {\n      grid-template-columns: 1fr;\n      gap: 10px;\n    }\n\n    #po-about .po-stats > div {\n      padding: 22px 18px;\n      border-radius: 22px;\n    }\n  }\n<\/style>\n\n<section class=\"po-split po-section\" id=\"po-about\">\n  <div class=\"po-container po-about-grid\">\n    <div class=\"po-image-card\">\n      <div class=\"po-round-img\">\n        <img\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0787\/2761\/0619\/files\/width533.png?v=1782631093\"\n          alt=\"Plant Organics founder in kitchen\"\n          loading=\"lazy\">\n      <\/div>\n\n      <div class=\"po-sticker\">\n        <div class=\"po-script\">&quot;Made with LOVE always&quot;<\/div>\n        <div class=\"po-founder-caption\">— Chef Bachi, Founder<\/div>\n      <\/div>\n\n      <div class=\"po-spin\">Real food<br>· real fast ·<\/div>\n    <\/div>\n\n    <div>\n      <div class=\"po-eyebrow\">About Plant Organics<\/div>\n\n      <h2 class=\"po-title\">\n        Ten years ago we started cooking\n        <span class=\"accent\">the food we wished existed.<\/span>\n      <\/h2>\n\n      <div class=\"po-two-col-text po-soft\">\n        <p>\n          Plant Organics was born in a small Brooklyn kitchen in 2017, driven by a passion for plants, wellness, and clean eating. What started as homemade meals crafted with care quickly grew into a mission to make organic, nourishing food more accessible.\n        <\/p>\n\n        <p>\n          Today, we deliver thousands of meals across South Florida — still handcrafted, still rooted in the same belief:\n          <strong>food should fuel, heal, and inspire.<\/strong>\n        <\/p>\n      <\/div>\n\n      <div class=\"po-stats\">\n        <div>\n          <div class=\"po-stat-num\">12k+<\/div>\n          <div class=\"po-stat-label\">Happy members<\/div>\n        <\/div>\n\n        <div>\n          <div class=\"po-stat-num\">1.4M<\/div>\n          <div class=\"po-stat-label\">Meals delivered<\/div>\n        <\/div>\n\n        <div>\n          <div class=\"po-stat-num\">48<\/div>\n          <div class=\"po-stat-label\">Local farm partners<\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>",
