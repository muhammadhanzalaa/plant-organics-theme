tor('[data-hero-cta]');var cur=0;function set(i){cur=i;imgs.forEach(function(s,idx){s.classList.toggle('is-active',idx===i)});dots.forEach(function(d,idx){d.classList.toggle('is-active',idx===i)});if(e)e.textContent=slides[i].eyebrow;if(t)t.innerHTML=slides[i].title;if(b)b.textContent=slides[i].body;if(c)c.textContent=slides[i].cta}dots.forEach(function(d,i){d.addEventListener('click',function(){set(i)})});setInterval(function(){set((cur+1)%slides.length)},6000);});\n document.querySelectorAll('.po-faq-section .po-faq-q').forEach(function(btn){btn.addEventListener('click',function(){var root=btn.closest('.po-faq-section'),item=btn.closest('.po-faq-item');root.querySelectorAll('.po-faq-item').forEach(function(el){if(el!==item)el.classList.remove('is-open')});item.classList.toggle('is-open');});});\n document.querySelectorAll('.po-plans-section').forEach(function(root){root.querySelectorAll('[data-plan-tab]').forEach(function(tab){tab.addEventListener('click',function(){var target=tab.dataset.planTab;root.querySelectorAll('[data-plan-tab]').forEach(function(t){t.classList.toggle('is-active',t===tab)});root.querySelectorAll('[data-plan-panel]').forEach(function(panel){panel.style.display=panel.dataset.planPanel===target?'grid':'none'});});});});\n});}\n\n<\/script>",
