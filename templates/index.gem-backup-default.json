        "custom_liquid": "<!-- Font Awesome CDN -->\n<link rel=\"stylesheet\" href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.5.1\/css\/all.min.css\">\n\n<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n\n  .po-how-luxury,\n  .po-how-luxury * {\n    box-sizing: border-box;\n  }\n\n  .po-how-luxury {\n    --po-page-width: 1280px;\n\n    \/* Actual Brand Colors *\/\n    --po-pink: #fcb6eb;\n    --po-dark-green: #293f07;\n    --po-green: #95ad4f;\n    --po-orange: #ff960e;\n    --po-purple: #927ec3;\n    --po-white: #ffffff;\n\n    \/* Brand Fonts *\/\n    --po-font-header-1: \"Degular Demo Black\", \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-header-2: \"Bricolage Grotesque\", \"Montserrat\", sans-serif;\n    --po-font-body: \"Montserrat Classic\", \"Montserrat\", Arial, sans-serif;\n\n    position: relative;\n    overflow: hidden;\n    width: 100%;\n   background:\n  radial-gradient(circle at 10% 12%, rgba(149, 173, 79, 0.16), transparent 30%),\n  radial-gradient(circle at 88% 18%, rgba(255, 150, 14, 0.16), transparent 28%),\n  radial-gradient(circle at 78% 86%, rgba(252, 182, 235, 0.14), transparent 34%),\n  linear-gradient(135deg, #fff4e7 0%, #fff0dc 48%, #fffaf3 100%);\n    color: var(--po-dark-green);\n    font-family: var(--po-font-body);\n  }\n\n  .po-how-luxury::before {\n    content: \"\";\n    position: absolute;\n    inset: 24px;\n    border: 1px solid rgba(41, 63, 7, 0.1);\n    border-radius: 36px;\n    pointer-events: none;\n  }\n\n  .po-how-luxury::after {\n    content: \"three steps\";\n    position: absolute;\n    right: -18px;\n    bottom: -16px;\n    color: rgba(41, 63, 7, 0.045);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(72px, 11vw, 160px);\n    line-height: 0.8;\n    font-weight: 900;\n    letter-spacing: -0.07em;\n    white-space: nowrap;\n    pointer-events: none;\n  }\n\n  .po-how-luxury .po-container {\n    width: 100%;\n    max-width: var(--po-page-width);\n    margin: 0 auto;\n    padding: 88px 22px 92px;\n    position: relative;\n    z-index: 2;\n  }\n\n  .po-how-luxury .po-step-head {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 28px;\n    margin-bottom: 42px;\n  }\n\n  .po-how-luxury .po-step-head .po-btn {\n    flex: 0 0 auto;\n  }\n\n  .po-how-luxury .po-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    background: rgba(149, 173, 79, 0.18);\n    color: var(--po-dark-green);\n    border: 1px solid rgba(149, 173, 79, 0.36);\n    border-radius: 999px;\n    padding: 10px 18px;\n    font-family: var(--po-font-header-2);\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .po-how-luxury .po-eyebrow::before {\n    content: \"\";\n    width: 10px;\n    height: 10px;\n    border-radius: 999px;\n    background: var(--po-orange);\n  }\n\n  .po-how-luxury .po-title {\n    margin: 18px 0 0;\n    max-width: 780px;\n    color: var(--po-dark-green);\n    font-family: var(--po-font-header-1);\n    font-size: clamp(42px, 5vw, 76px);\n    line-height: 0.92;\n    letter-spacing: -0.06em;\n    font-weight: 900;\n  }\n\n  .po-how-luxury .po-title .accent {\n    color: var(--po-orange);\n  }\n\n  .po-how-luxury .po-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 54px;\n    padding: 0 24px;\n    border-radius: 999px;\n    text-decoration: none;\n    font-family: var(--po-font-header-2);\n    font-size: 15px;\n    font-weight: 900;\n    line-height: 1;\n    white-space: nowrap;\n    transition:\n      transform 0.25s ease,\n      box-shadow 0.25s ease,\n      background 0.25s ease,\n      color 0.25s ease,\n      border-color 0.25s ease;\n  }\n\n  .po-how-luxury .po-btn-outline {\n    border: 2px solid var(--po-dark-green);\n    color: var(--po-dark-green);\n    background: transparent;\n  }\n\n  .po-how-luxury .po-btn-outline:hover,\n  .po-how-luxury .po-btn-outline:focus {\n    transform: translateY(-2px);\n    background: var(--po-dark-green);\n    color: var(--po-white);\n    border-color: var(--po-dark-green);\n    box-shadow: 0 18px 42px rgba(41, 63, 7, 0.18);\n    text-decoration: none;\n  }\n\n  .po-how-luxury .po-step-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 22px;\n  }\n\n  .po-how-luxury .po-step {\n    position: relative;\n    overflow: hidden;\n    padding: 34px 30px 32px;\n    border-radius: 32px;\n    background: var(--po-white);\n    border: 1px solid rgba(41, 63, 7, 0.12);\n    box-shadow:\n      inset 0 1px 0 rgba(255, 255, 255, 1),\n      0 22px 60px rgba(41, 63, 7, 0.09);\n    transition:\n      transform 0.35s ease,\n      box-shadow 0.35s ease,\n      border-color 0.35s ease,\n      background 0.35s ease;\n  }\n\n  .po-how-luxury .po-step::before {\n    content: \"\";\n    position: absolute;\n    width: 108px;\n    height: 108px;\n    right: -42px;\n    top: -42px;\n    border-radius: 999px;\n    background: rgba(149, 173, 79, 0.24);\n    pointer-events: none;\n    transition: transform 0.35s ease, opacity 0.35s ease;\n  }\n\n  .po-how-luxury .po-step:nth-child(2)::before {\n    background: rgba(255, 150, 14, 0.18);\n  }\n\n  .po-how-luxury .po-step:nth-child(3)::before {\n    background: rgba(41, 63, 7, 0.08);\n  }\n\n  .po-how-luxury .po-step::after {\n    content: \"\";\n    position: absolute;\n    left: 28px;\n    right: 28px;\n    bottom: 0;\n    height: 4px;\n    border-radius: 999px 999px 0 0;\n    background: linear-gradient(90deg, var(--po-green), var(--po-orange));\n    transform: scaleX(0);\n    transform-origin: center;\n    transition: transform 0.35s ease;\n  }\n\n  .po-how-luxury .po-step:hover {\n    transform: translateY(-8px);\n    border-color: rgba(149, 173, 79, 0.55);\n    box-shadow:\n      inset 0