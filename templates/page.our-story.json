{"sections":{"main":{"type":"main-page","disabled":true,"settings":{}},"custom_liquid_8Ur84g":{"type":"custom-liquid","name":"story","settings":{"custom_liquid":"<style>\n  .po-our-story,\n  .po-our-story * {\n    box-sizing: border-box;\n  }\n\n  .po-our-story {\n    --po-page-width: 1280px;\n    --po-cream: #F7F1E4;\n    --po-cream-deep: #EEE1C9;\n    --po-forest: #2F7A4E;\n    --po-forest-deep: #073D27;\n    --po-terracotta: #C96E3C;\n    --po-honey: #F1C858;\n    --po-ink: #1E2B21;\n\n    width: 100%;\n    background: var(--po-cream);\n    color: var(--po-ink);\n    font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    padding: 94px 0;\n    overflow: hidden;\n  }\n\n  .po-our-story__container {\n    width: 100%;\n    max-width: var(--po-page-width);\n    margin: 0 auto;\n    padding: 0 24px;\n  }\n\n  .po-our-story__grid {\n    display: grid;\n    grid-template-columns: minmax(360px, 0.92fr) minmax(420px, 1.08fr);\n    gap: 72px;\n    align-items: center;\n  }\n\n  .po-our-story__media {\n    position: relative;\n    min-height: 560px;\n  }\n\n  .po-our-story__image-card {\n    position: relative;\n    width: 100%;\n    height: 560px;\n    border-radius: 42px;\n    overflow: hidden;\n    background: var(--po-cream-deep);\n    box-shadow: 0 28px 70px rgba(7, 61, 39, 0.13);\n  }\n\n  .po-our-story__image-card img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .po-our-story__image-card::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(180deg, rgba(7, 61, 39, 0.02), rgba(7, 61, 39, 0.18)),\n      radial-gradient(circle at 20% 18%, rgba(241, 200, 88, 0.2), transparent 32%);\n    pointer-events: none;\n  }\n\n  .po-our-story__sticker {\n    position: absolute;\n    left: -18px;\n    bottom: 46px;\n    z-index: 2;\n    width: min(278px, 72%);\n    padding: 24px 24px 22px;\n    border-radius: 28px;\n    background: var(--po-honey);\n    color: var(--po-forest-deep);\n    box-shadow: 0 22px 48px rgba(7, 61, 39, 0.18);\n    transform: rotate(-3deg);\n  }\n\n  .po-our-story__script {\n    font-family: Fraunces, Georgia, serif;\n    font-size: 28px;\n    line-height: 1.08;\n    letter-spacing: -0.045em;\n    font-style: italic;\n    font-weight: 650;\n  }\n\n  .po-our-story__sticker-sub {\n    margin-top: 10px;\n    color: rgba(7, 61, 39, 0.7);\n    font-size: 11px;\n    line-height: 1.35;\n    font-weight: 850;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .po-our-story__badge {\n    position: absolute;\n    top: 34px;\n    right: -18px;\n    z-index: 2;\n    width: 124px;\n    height: 124px;\n    border-radius: 50%;\n    background: var(--po-forest-deep);\n    color: var(--po-cream);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    box-shadow: 0 22px 48px rgba(7, 61, 39, 0.2);\n    transform: rotate(7deg);\n  }\n\n  .po-our-story__badge strong {\n    display: block;\n    font-family: Fraunces, Georgia, serif;\n    font-size: 34px;\n    line-height: 0.9;\n    letter-spacing: -0.04em;\n    font-weight: 650;\n    color: var(--po-honey);\n  }\n\n  .po-our-story__badge span {\n    display: block;\n    margin-top: 7px;\n    font-size: 9px;\n    line-height: 1.2;\n    font-weight: 850;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n\n  .po-our-story__eyebrow {\n    width: fit-content;\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    color: var(--po-terracotta);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    margin-bottom: 18px;\n  }\n\n  .po-our-story__eyebrow::before {\n    content: \"\";\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: var(--po-terracotta);\n    box-shadow: 0 0 0 6px rgba(201, 110, 60, 0.13);\n    flex: 0 0 9px;\n  }\n\n  .po-our-story__title {\n    margin: 0;\n    max-width: 680px;\n    color: var(--po-forest-deep);\n    font-family: Fraunces, Georgia, serif;\n    font-size: clamp(44px, 5vw, 76px);\n    line-height: 0.98;\n    letter-spacing: -0.055em;\n    font-weight: 650;\n  }\n\n  .po-our-story__title .accent {\n    color: var(--po-terracotta);\n    font-style: italic;\n    font-weight: 520;\n  }\n\n  .po-our-story__text {\n    margin-top: 26px;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 22px;\n    color: rgba(30, 43, 33, 0.74);\n  }\n\n  .po-our-story__text p {\n    margin: 0;\n    font-size: 17px;\n    line-height: 1.68;\n    font-weight: 500;\n  }\n\n  .po-our-story__text strong {\n    color: var(--po-forest-deep);\n    font-weight: 850;\n  }\n\n  .po-our-story__values {\n    margin-top: 34px;\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 14px;\n  }\n\n  .po-our-story__value {\n    min-height: 126px;\n    padding: 20px 18px;\n    border-radius: 24px;\n    background: var(--po-cream-deep);\n    border: 1px solid rgba(7, 61, 39, 0.08);\n  }\n\n  .po-our-story__value-num {\n    color: var(--po-forest-deep);\n    font-family: Fraunces, Georgia, serif;\n    font-size: 34px;\n    line-height: 1;\n    letter-spacing: -0.045em;\n    font-weight: 650;\n  }\n\n  .po-our-story__value-label {\n    margin-top: 8px;\n    color: rgba(30, 43, 33, 0.68);\n    font-size: 12px;\n    line-height: 1.35;\n    font-weight: 850;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n\n  .po-our-story__note {\n    margin-top: 28px;\n    padding: 22px 24px;\n    border-left: 4px solid var(--po-terracotta);\n    border-radius: 0 22px 22px 0;\n    background: rgba(201, 110, 60, 0.08);\n    color: rgba(30, 43, 33, 0.76);\n    font-size: 16px;\n    line-height: 1.62;\n    font-weight: 550;\n  }\n\n  @media (max-width: 1020px) {\n    .po-our-story {\n      padding: 76px 0;\n    }\n\n    .po-our-story__grid {\n      grid-template-columns: 1fr;\n      gap: 46px;\n    }\n\n    .po-our-story__media {\n      min-height: auto;\n      max-width: 760px;\n    }\n\n    .po-our-story__image-card {\n      height: 520px;\n    }\n\n    .po-our-story__title {\n      max-width: 780px;\n    }\n  }\n\n  @media (max-width: 720px) {\n    .po-our-story {\n      padding: 62px 0;\n    }\n\n    .po-our-story__container {\n      padding: 0 16px;\n    }\n\n    .po-our-story__grid {\n      gap: 36px;\n    }\n\n    .po-our-story__image-card {\n      height: 410px;\n      border-radius: 30px;\n    }\n\n    .po-our-story__sticker {\n      left: 10px;\n      bottom: 18px;\n      width: 226px;\n      padding: 18px 18px 17px;\n      border-radius: 22px;\n    }\n\n    .po-our-story__script {\n      font-size: 23px;\n    }\n\n    .po-our-story__sticker-sub {\n      font-size: 9.5px;\n    }\n\n    .po-our-story__badge {\n      top: 18px;\n      right: 10px;\n      width: 96px;\n      height: 96px;\n    }\n\n    .po-our-story__badge strong {\n      font-size: 27px;\n    }\n\n    .po-our-story__badge span {\n      font-size: 7.5px;\n    }\n\n    .po-our-story__eyebrow {\n      font-size: 10.5px;\n      margin-bottom: 14px;\n    }\n\n    .po-our-story__title {\n      font-size: clamp(38px, 12vw, 52px);\n      line-height: 1;\n      letter-spacing: -0.05em;\n    }\n\n    .po-our-story__text {\n      grid-template-columns: 1fr;\n      gap: 14px;\n      margin-top: 22px;\n    }\n\n    .po-our-story__text p {\n      font-size: 15.5px;\n      line-height: 1.62;\n    }\n\n    .po-our-story__values {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      gap: 9px;\n      margin-top: 26px;\n    }\n\n    .po-our-story__value {\n      min-height: 104px;\n      border-radius: 18px;\n      padding: 15px 10px;\n    }\n\n    .po-our-story__value-num {\n      font-size: 27px;\n    }\n\n    .po-our-story__value-label {\n      font-size: 9.5px;\n      letter-spacing: 0.07em;\n    }\n\n    .po-our-story__note {\n      margin-top: 22px;\n      padding: 18px 18px;\n      font-size: 14.5px;\n      line-height: 1.58;\n      border-radius: 0 18px 18px 0;\n    }\n  }\n\n  @media (max-width: 390px) {\n    .po-our-story__image-card {\n      height: 380px;\n    }\n\n    .po-our-story__sticker {\n      width: 205px;\n    }\n\n    .po-our-story__script {\n      font-size: 21px;\n    }\n\n    .po-our-story__values {\n      gap: 7px;\n    }\n\n    .po-our-story__value {\n      padding: 13px 8px;\n    }\n\n    .po-our-story__value-num {\n      font-size: 24px;\n    }\n\n    .po-our-story__value-label {\n      font-size: 8.7px;\n    }\n  }\n<\/style>\n\n<section class=\"po-our-story po-split po-section\" id=\"po-our-story\">\n  <div class=\"po-our-story__container po-container\">\n    <div class=\"po-our-story__grid\">\n      <div class=\"po-our-story__media\">\n        <div class=\"po-our-story__image-card po-image-card\">\n          <img\n            src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0787\/2761\/0619\/files\/about-founder.jpg?v=1780297792\"\n            alt=\"Plant Organics founder preparing fresh organic meals in the kitchen\"\n            loading=\"lazy\"\n          >\n        <\/div>\n\n        <div class=\"po-our-story__badge\">\n          <div>\n            <strong>5+<\/strong>\n            <span>Years of clean meals<\/span>\n          <\/div>\n        <\/div>\n\n        <div class=\"po-our-story__sticker\">\n          <div class=\"po-our-story__script\">\n            “Food should heal, not harm.”\n          <\/div>\n          <div class=\"po-our-story__sticker-sub\">\n            — Maya, Founder\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"po-our-story__content\">\n        <div class=\"po-our-story__eyebrow po-eyebrow\">Our Story<\/div>\n\n        <h2 class=\"po-our-story__title po-title\">\n          We started with the food <span class=\"accent\">we wished existed.<\/span>\n        <\/h2>\n\n        <div class=\"po-our-story__text po-soft\">\n          <p>\n            Plant Organics began in a small kitchen with one simple frustration:\n            clean, organic meal delivery was too hard to find. Too many options were\n            filled with seed oils, fillers, hidden ingredients, and meals that felt\n            convenient — but not truly nourishing.\n          <\/p>\n\n          <p>\n            So we started cooking the way we wanted to eat: real produce, premium\n            ingredients, responsibly sourced proteins, and meals made fresh every week.\n            What began as a small local kitchen has grown into a weekly ritual for\n            people who want food that feels good from the first bite.\n          <\/p>\n        <\/div>\n\n        <div class=\"po-our-story__values\">\n          <div class=\"po-our-story__value\">\n            <div class=\"po-our-story__value-num\">100%<\/div>\n            <div class=\"po-our-story__value-label\">Fresh weekly prep<\/div>\n          <\/div>\n\n          <div class=\"po-our-story__value\">\n            <div class=\"po-our-story__value-num\">0<\/div>\n            <div class=\"po-our-story__value-label\">Industrial seed oils<\/div>\n          <\/div>\n\n          <div class=\"po-our-story__value\">\n            <div class=\"po-our-story__value-num\">2wk<\/div>\n            <div class=\"po-our-story__value-label\">Rotating seasonal menu<\/div>\n          <\/div>\n        <\/div>\n\n        <div class=\"po-our-story__note\">\n          Today, our mission is still simple: make real food easier, cleaner, and more joyful —\n          so your weekly meals support your body, your schedule, and your glow.\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>","custom_class":""}}},"order":["main","custom_liquid_8Ur84g"]}