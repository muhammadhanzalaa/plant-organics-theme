            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Show now",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "default": false,
          "label": "Use outline button style"
        },
        {
          "type": "select",
          "id": "layout",
          "options": [
            {
              "value": "image_first",
              "label": "Image first"
            },
            {
              "value": "text_first",
              "label": "Image second"
            }
          ],
          "default": "image_first",
          "label": "Image first",
          "info": "Image first is the default mobile layout."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tpt - Image with text #3",
