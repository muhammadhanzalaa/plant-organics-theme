        </div>

        <button type="submit" class="po-btn-action">Get Started &rarr;</button>
      </form>

      <div class="po-bottom-note">
        One delivery subscription per profile. Your meal plan automatically renews based on your dietary preferences unless canceled by Thursday at 10 AM. Add-ons are not included in automatic renewals.
      </div>
    </div>
  </div>

  <!-- PAGE 2 & PAGE 3 MAIN LAYOUT -->
