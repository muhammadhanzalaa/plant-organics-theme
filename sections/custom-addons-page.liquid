  let addOnTracking = {};

  function el(id) { return document.getElementById(id + '-' + SECTION_ID); }

  // Allowed local-delivery ZIP codes supplied by the store owner.
  // Customers outside this list cannot continue from Step 1.
  const ALLOWED_ZIP_CODES = new Set(["33004","33009","33019","33020","33021","33023","33024","33025","33026","33027","33028","33029","33060","33062","33063","33064","33065","33066","33067","33068","33069","33071","33073","33076","33301","33304","33305","33306","33308","33309","33311","33312","33313","33314","33315","33316","33317","33319","33321","33322","33323","33324","33325","33326","33327","33328","33330","33331","33332","33334","33351","33388","33394","33441","33442","33401","33403","33404","33405","33406","33407","33408","33409","33410","33411","33412","33413","33414","33415","33417","33418","33426","33428","33430","33431","33432","33433","33434","33435","33436","33437","33438","33444","33445","33446","33449","33458","33460","33461","33462","33463","33467","33469","33470","33472","33473","33476","33477","33478","33480","33483","33484","33486","33487","33493","33496","33498"]);

  function validateDeliveryZip(rawZip) {
    const zip = String(rawZip || '').trim();
    const normalized = zip.replace(/\s+/g, '');
    const validFormat = /^\d{5}$/.test(normalized);
    const errorEl = el('zip-error');

    if (!validFormat) {
      if (errorEl) {
        errorEl.textContent = 'Please enter a valid 5-digit ZIP code.';
        errorEl.style.display = 'block';
      }
      return false;
    }

    if (!ALLOWED_ZIP_CODES.has(normalized)) {
      if (errorEl) {
        errorEl.textContent = 'Sorry, we do not currently deliver to this ZIP code.';
        errorEl.style.display = 'block';
      }
      return false;
    }

    if (errorEl) errorEl.style.display = 'none';
    return true;
  }

  // Form Submission (Page 1)
  function submitFormStep1(e) {
    e.preventDefault();
    const zipInput = el('input-zip');
