{% liquid
  assign ratio_value = '1 / 1'

  case section.settings.image_ratio
    when 'portrait'
      assign ratio_value = '1 / 1.12'
    when 'landscape'
      assign ratio_value = '1.25 / 1'
    else
      assign ratio_value = '1 / 1'
  endcase
%}

<style>
  #po-menu-grid-{{ section.id }},
  #po-menu-grid-{{ section.id }} * {
    box-sizing: border-box;
  }

  #po-menu-grid-{{ section.id }} {
    --po-page-width: {{ section.settings.page_width }}px;
    --po-bg: {{ section.settings.background_color }};
    --po-card-bg: {{ section.settings.card_background }};
    --po-card-border: {{ section.settings.card_border }};
    --po-text: {{ section.settings.text_color }};
    --po-muted: {{ section.settings.muted_color }};
    --po-green: {{ section.settings.green_color }};
    --po-orange: {{ section.settings.orange_color }};
    --po-quick-text: {{ section.settings.quick_view_text_color }};
    --po-card-ratio: {{ ratio_value }};
    --po-font-heading: "Bricolage Grotesque", "Montserrat", Arial, sans-serif;
    --po-font-body: "Montserrat", Arial, sans-serif;

    width: 100%;
    position: relative;
    overflow: hidden;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background:
      radial-gradient(circle at 8% 10%, rgba(149, 173, 79, 0.16), transparent 28%),
      radial-gradient(circle at 88% 12%, rgba(255, 150, 14, 0.16), transparent 28%),
      radial-gradient(circle at 50% 100%, rgba(252, 182, 235, 0.11), transparent 34%),
      linear-gradient(135deg, #fff4e7 0%, #fff0dc 48%, #fffaf3 100%);
    color: var(--po-text);
    font-family: var(--po-font-body);
  }

  #po-menu-grid-{{ section.id }} .po-container {
    width: 100%;
    max-width: var(--po-page-width);
    margin: 0 auto;
  }

  #po-menu-grid-{{ section.id }} .po-head {
    max-width: 860px;
    margin: 0 0 42px;
  }

  #po-menu-grid-{{ section.id }} .po-eyebrow {
    display: -webkit-inline-box;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-box-align: center;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    background: rgba(123, 148, 66, 0.12);
    border: 1px solid rgba(123, 148, 66, 0.26);
    color: var(--po-green);
    font-family: var(--po-font-heading);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #po-menu-grid-{{ section.id }} .po-eyebrow::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--po-orange);
  }

  #po-menu-grid-{{ section.id }} .po-title {
    margin: 18px 0 0;
    color: var(--po-text);
    font-family: var(--po-font-heading);
    font-size: clamp(38px, 5vw, 72px);
    line-height: 0.96;
    letter-spacing: -0.05em;
    font-weight: 900;
  }

  #po-menu-grid-{{ section.id }} .po-title span {
    color: var(--po-orange);
    font-style: italic;
  }

  #po-menu-grid-{{ section.id }} .po-text {
    margin: 18px 0 0;
    max-width: 700px;
    color: var(--po-muted);
    font-size: 16px;
    line-height: 1.65;
    font-weight: 600;
  }

  #po-menu-grid-{{ section.id }} .po-top-nav {
    {% if section.settings.sticky_nav %}
      position: -webkit-sticky;
      position: sticky;
      top: {{ section.settings.sticky_offset }}px;
    {% else %}
      position: relative;
    {% endif %}
    z-index: 20;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: 0 auto 52px;
    padding: 10px;
    width: -webkit-fit-content;
    width: fit-content;
    max-width: 100%;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(45, 45, 45, 0.08);
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.05);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  #po-menu-grid-{{ section.id }} .po-top-nav a {
    display: -webkit-inline-box;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-box-align: center;
    align-items: center;
    -webkit-box-pack: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    text-decoration: none;
    color: var(--po-text);
    font-size: 12px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    -webkit-transition: 0.22s ease;
    transition: 0.22s ease;
  }

  #po-menu-grid-{{ section.id }} .po-top-nav a:hover {
    background: var(--po-green);
    color: #fff;
  }

  /* ================= CATEGORY / SECTION SPACING — matched to Weekly Menu page ================= */
  #po-menu-grid-{{ section.id }} .po-category {
    scroll-margin-top: 120px;
    margin-top: 34px;
  }

  #po-menu-grid-{{ section.id }} .po-category:first-of-type {
    margin-top: 0;
  }

  #po-menu-grid-{{ section.id }} .po-category-head {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: end;
    align-items: flex-end;
    -webkit-box-pack: justify;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
    padding: 0 4px;
  }

  #po-menu-grid-{{ section.id }} .po-category-title {
    margin: 0;
    color: var(--po-text);
    font-family: var(--po-font-heading);
    font-size: clamp(34px, 4vw, 58px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 900;
    text-transform: uppercase;
  }

  #po-menu-grid-{{ section.id }} .po-category-note {
    margin: 7px 0 0;
    color: var(--po-muted);
    font-size: 13px;
    line-height: 1.45;
    font-weight: 800;
  }

  #po-menu-grid-{{ section.id }} .po-category-count {
    flex: 0 0 auto;
    display: -webkit-inline-box;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-box-align: center;
    align-items: center;
    min-height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    background: rgba(255, 150, 14, 0.09);
    border: 1px solid rgba(255, 150, 14, 0.24);
    color: var(--po-text);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  #po-menu-grid-{{ section.id }} .po-menu-grid {
    display: -ms-grid;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
  }

  #po-menu-grid-{{ section.id }} .po-product-card {
    position: relative;
    isolation: isolate;
    min-width: 0;
    height: 100%;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--po-card-bg);
    border: 1px solid var(--po-card-border);
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_inner_padding }}px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.035);
    -webkit-transition:
      -webkit-transform 0.28s ease,
      box-shadow 0.28s ease,
      border-color 0.28s ease;
    transition:
      transform 0.28s ease,
      box-shadow 0.28s ease,
      border-color 0.28s ease;
  }

  #po-menu-grid-{{ section.id }} .po-product-card:hover {
    -webkit-transform: translateY(-4px);
    transform: translateY(-4px);
    box-shadow: 0 20px 46px rgba(0, 0, 0, 0.08);
    border-color: rgba(123, 148, 66, 0.28);
  }

  #po-menu-grid-{{ section.id }} .po-product-media {
    position: relative;
    overflow: hidden;
    border-radius: calc({{ section.settings.card_radius }}px - 5px);
    aspect-ratio: var(--po-card-ratio);
    background: #eee7dc;
  }

  #po-menu-grid-{{ section.id }} .po-product-media img,
  #po-menu-grid-{{ section.id }} .po-placeholder-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #po-menu-grid-{{ section.id }} .po-product-media img {
    object-fit: cover;
    -webkit-transform: scale(1.001);
    transform: scale(1.001);
    -webkit-transition: -webkit-transform 0.45s ease;
    transition: transform 0.45s ease;
  }

  #po-menu-grid-{{ section.id }} .po-product-card:hover .po-product-media img {
    -webkit-transform: scale(1.045);
    transform: scale(1.045);
  }

  #po-menu-grid-{{ section.id }} .po-product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    display: -webkit-inline-box;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-box-align: center;
    align-items: center;
    min-height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    color: var(--po-text);
    font-size: 10px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
  }

  #po-menu-grid-{{ section.id }} .po-product-badge.po-feature {
    background: var(--po-orange);
    color: #fff;
  }

  #po-menu-grid-{{ section.id }} .po-quick-view {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 4;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    -webkit-transform: translateY(10px);
    transform: translateY(10px);
    -webkit-transition:
      opacity 0.24s ease,
      visibility 0.24s ease,
      -webkit-transform 0.24s ease;
    transition:
      opacity 0.24s ease,
      visibility 0.24s ease,
      transform 0.24s ease;
  }

  #po-menu-grid-{{ section.id }} .po-product-card:hover .po-quick-view {
    opacity: 1;
    visibility: visible;
    -webkit-transform: translateY(0);
    transform: translateY(0);
  }

  #po-menu-grid-{{ section.id }} .po-quick-view__text {
    min-height: 40px;
    display: -webkit-inline-box;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-box-align: center;
    align-items: center;
    -webkit-box-pack: center;
    justify-content: center;
    padding: 0 14px;
    background: var(--po-green);
    color: var(--po-quick-text);
    font-size: 13px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  #po-menu-grid-{{ section.id }} .po-quick-view__icon {
    min-height: 40px;
    display: -webkit-inline-box;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-box-align: center;
    align-items: center;
    -webkit-box-pack: center;
    justify-content: center;
    background: var(--po-orange);
    color: #fff;
    border-radius: 10px;
    margin-left: -1px;
  }

  #po-menu-grid-{{ section.id }} .po-quick-view__icon svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  #po-menu-grid-{{ section.id }} .po-product-info {
    position: relative;
    flex: 1 1 auto;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    flex-direction: column;
    -webkit-box-pack: start;
    justify-content: flex-start;
    padding: 15px 14px 34px;
    min-height: 96px;
    text-align: center;
  }

  #po-menu-grid-{{ section.id }} .po-product-title {
    margin: 0;
    color: var(--po-text);
    font-family: var(--po-font-body);
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.18;
    font-weight: 900;
    letter-spacing: 0.20em;
    text-transform: uppercase;
  }

  #po-menu-grid-{{ section.id }} .po-product-title-row {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    align-items: center;
    -webkit-box-pack: start;
    justify-content: left;
    flex-wrap: wrap;
    gap: 7px;
    padding-bottom: 10px;
  }

  /* ================= DIETARY ICONS — matched exactly to Weekly Menu page (.po-diet-icon) ================= */
  #po-menu-grid-{{ section.id }} .po-dietary-icons {
    position: absolute;
    right: 6px;
    bottom: 0;
    z-index: 3;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    align-items: center;
    gap: 4px;
  }

  #po-menu-grid-{{ section.id }} .po-dietary-icon {
    display: -webkit-inline-box;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-box-align: center;
    align-items: center;
    -webkit-box-pack: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid rgba(41, 63, 7, 0.25);
    color: var(--po-text);
    font-size: 10px;
    font-weight: 800;
    line-height: 1;
  }

  #po-menu-grid-{{ section.id }} .po-product-price {
    margin: 10px 0 0;
    color: var(--po-text);
    font-size: 17px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  #po-menu-grid-{{ section.id }} .po-product-meta {
    margin-top: 7px;
    color: var(--po-muted);
    font-size: 12px;
    line-height: 1.35;
    font-weight: 700;
  }

  #po-menu-grid-{{ section.id }} .po-product-meta strong {
    color: var(--po-orange);
  }

  /* ================= DETAILS ACCORDION — View Details / Hide Details toggle ================= */
  #po-menu-grid-{{ section.id }} .po-product-summary {
    position: relative;
  }

  #po-menu-grid-{{ section.id }} .po-product-card.active {
    height: auto;
  }

  #po-menu-grid-{{ section.id }} .po-details-btn {
    display: -webkit-inline-box;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-box-align: center;
    align-items: center;
    -webkit-box-pack: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    margin-top: 10px;
    min-height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid rgba(41, 63, 7, 0.18);
    background: #ffffff;
    color: var(--po-text);
    font-family: var(--po-font-body);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    -webkit-transition: background 0.2s ease, border-color 0.2s ease;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  #po-menu-grid-{{ section.id }} .po-details-btn:hover {
    background: rgba(123, 148, 66, 0.08);
    border-color: rgba(123, 148, 66, 0.35);
  }

  #po-menu-grid-{{ section.id }} .po-details-btn__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    -webkit-transition: -webkit-transform 0.3s ease;
    transition: transform 0.3s ease;
  }

  #po-menu-grid-{{ section.id }} .po-product-card.active .po-details-btn__icon {
    -webkit-transform: rotate(180deg);
    transform: rotate(180deg);
  }

  #po-menu-grid-{{ section.id }} .po-meal-desc {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    padding: 0 12px;
    margin-top: 0;
    border-radius: 12px;
    font-size: 12px;
    line-height: 1.5;
    font-weight: 600;
    color: var(--po-muted);
    background: transparent;
    border: 1px solid transparent;
    text-align: left;
    -webkit-transition: max-height 0.35s ease, opacity 0.35s ease, padding 0.35s ease, margin 0.35s ease;
    transition: max-height 0.35s ease, opacity 0.35s ease, padding 0.35s ease, margin 0.35s ease;
  }

  #po-menu-grid-{{ section.id }} .po-product-card.active .po-meal-desc {
    max-height: 220px;
    opacity: 1;
    padding: 10px 12px;
    margin-top: 8px;
    background: #fff0dc;
    border: 1px solid rgba(255, 150, 14, 0.25);
  }

  @media (max-width: 1100px) {
    #po-menu-grid-{{ section.id }} .po-menu-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    #po-menu-grid-{{ section.id }} {
      padding-left: 14px;
      padding-right: 14px;
    }

    #po-menu-grid-{{ section.id }} .po-category-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    #po-menu-grid-{{ section.id }} .po-menu-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    #po-menu-grid-{{ section.id }} .po-top-nav {
      position: relative;
      justify-content: flex-start;
      width: 100%;
      border-radius: 22px;
    }

    #po-menu-grid-{{ section.id }} .po-top-nav a {
      flex: 1 1 calc(50% - 8px);
    }
  }

  @media (max-width: 520px) {
    #po-menu-grid-{{ section.id }} .po-menu-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 14px;
    }

    #po-menu-grid-{{ section.id }} .po-product-card {
      border-radius: 18px;
      padding: 5px;
    }

    #po-menu-grid-{{ section.id }} .po-product-media {
      border-radius: 15px;
    }

    #po-menu-grid-{{ section.id }} .po-product-info {
      padding: 12px 8px 11px;
    }

    #po-menu-grid-{{ section.id }} .po-product-title {
      font-size: 13px;
      letter-spacing: 0.14em;
    }

    #po-menu-grid-{{ section.id }} .po-product-price {
      font-size: 15px;
      margin-top: 8px;
    }

    #po-menu-grid-{{ section.id }} .po-product-badge {
      top: 8px;
      left: 8px;
      min-height: 24px;
      padding: 0 9px;
      font-size: 8.5px;
    }

    #po-menu-grid-{{ section.id }} .po-quick-view {
      left: 8px;
      right: 8px;
      bottom: 8px;
      grid-template-columns: minmax(0, 1fr) 36px;
    }

    #po-menu-grid-{{ section.id }} .po-quick-view__text,
    #po-menu-grid-{{ section.id }} .po-quick-view__icon {
      min-height: 36px;
    }

    #po-menu-grid-{{ section.id }} .po-quick-view__text {
      font-size: 12px;
    }

    #po-menu-grid-{{ section.id }} .po-dietary-icons {
      right: 5px;
      bottom: 0;
      gap: 3px;
    }

    #po-menu-grid-{{ section.id }} .po-dietary-icon {
      width: 20px;
      height: 20px;
      font-size: 9px;
    }
  }
</style>

<section id="po-menu-grid-{{ section.id }}" class="po-menu-category-grid">
  <div class="po-container">
    {% if section.settings.show_header %}
      <div class="po-head">
        {% if section.settings.eyebrow != blank %}
          <div class="po-eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="po-title">
            {{ section.settings.heading }}
            {% if section.settings.heading_accent != blank %}
              <span>{{ section.settings.heading_accent }}</span>
            {% endif %}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="po-text">{{ section.settings.text }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.show_nav and section.blocks.size > 0 %}
      <nav class="po-top-nav" aria-label="Menu category navigation">
        {% for block in section.blocks %}
          {% if block.type == 'category' %}
            <a href="#po-cat-{{ section.id }}-{{ block.id }}">
              {% if block.settings.title != blank %}
                {{ block.settings.title }}
              {% elsif block.settings.collection != blank %}
                {{ block.settings.collection.title }}
              {% else %}
                Category
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}

    {% for block in section.blocks %}
      {% if block.type == 'category' %}
        {% liquid
          assign category_collection = block.settings.collection
          assign category_title = block.settings.title
          assign category_note = block.settings.note
          assign category_badge = block.settings.badge
          assign category_meta = block.settings.item_meta
          assign category_default_badge = block.settings.default_badge

          if category_title == blank and category_collection != blank
            assign category_title = category_collection.title
          endif
        %}

        <div class="po-category" id="po-cat-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="po-category-head">
            <div>
              {% if category_title != blank %}
                <h2 class="po-category-title">{{ category_title }}</h2>
              {% endif %}

              {% if category_note != blank %}
                <p class="po-category-note">{{ category_note }}</p>
              {% endif %}
            </div>

            {% if category_badge != blank %}
              <span class="po-category-count">{{ category_badge }}</span>
            {% endif %}
          </div>

          <div class="po-menu-grid">
            {% if category_collection != blank and category_collection.products_count > 0 %}
              {% for product in category_collection.products limit: section.settings.products_per_category %}
                {% liquid
                  assign product_tags = product.tags | join: ',' | downcase
                  assign badge_text = category_default_badge
                  assign badge_class = ''

                  if section.settings.show_product_badges
                    if product.metafields.custom.menu_badge.value != blank
                      assign badge_text = product.metafields.custom.menu_badge.value
                      assign badge_class = 'po-feature'
                    elsif product_tags contains 'seasonal'
                      assign badge_text = 'Seasonal Feature'
                      assign badge_class = 'po-feature'
                    endif
                  else
                    assign badge_text = ''
                  endif

                  assign menu_icons_value = product.metafields.custom.menu_icons.value | default: ''
                  assign menu_icons_normalized = menu_icons_value
                  assign menu_icons_normalized = menu_icons_normalized | replace: ')(', ','
                  assign menu_icons_normalized = menu_icons_normalized | remove: '(' | remove: ')'
                  assign menu_icons_normalized = menu_icons_normalized | replace: ';', ',' | replace: '|', ','
                  assign menu_icons = menu_icons_normalized | split: ','

                  assign product_title_lower = product.title | downcase

                  if product_title_lower contains 'overnight oats' or product_title_lower contains 'greek yogurt parfait'
                    assign menu_icons_value = 'VG'
                    assign menu_icons_normalized = 'VG'
                    assign menu_icons = menu_icons_normalized | split: ','
                  endif

                  assign product_description_text = ''

                  if product_title_lower contains 'organic herb-roasted chicken'
                    assign product_description_text = 'Organic herb-roasted chicken served with a fresh herb and citrus remoulade.'
                  elsif product_title_lower contains 'grass-fed beef meatballs'
                    assign product_description_text = 'Grass-fed beef meatballs blended with breadcrumbs and Italian herbs, simmered in crushed tomatoes.'
                  elsif product_title_lower contains 'turkey burgers'
                    assign product_description_text = 'Juicy turkey burgers seasoned with a blend of fresh herbs and savory spices.'
                  elsif product_title_lower contains 'grass-fed bison patties'
                    assign product_description_text = 'Flavorful grass-fed bison patties seasoned with herbs and signature spices.'
                  elsif product_title_lower contains 'lemon herb tofu'
                    assign product_description_text = 'Tender tofu infused with bright lemon crema and finished with fresh herbs.'
                  elsif product_title_lower contains 'spinach' and product_title_lower contains 'veggie cakes'
                    assign product_description_text = 'Savory veggie cakes made with spinach, feta, carrots, and herbs, served with a refreshing tzatziki sauce.'
                  elsif product_title_lower contains 'wild lemon dill salmon'
                    assign product_description_text = 'Wild-caught salmon seasoned with lemon and dill, paired with a creamy garlic yogurt sauce.'
                  elsif product_title_lower contains 'roasted broccoli'
                    assign product_description_text = 'Roasted broccoli tossed in mustard oil and finished with red pepper flakes.'
                  elsif product_title_lower contains 'garlic herb sweet potatoes'
                    assign product_description_text = 'Roasted sweet potatoes infused with garlic and thyme.'
                  elsif product_title_lower contains 'lemon herb farro'
                    assign product_description_text = 'Hearty farro mixed with lemon chickpeas, fresh herbs, and toasted pine nuts.'
                  elsif product_title_lower contains 'roasted cauliflower'
                    assign product_description_text = 'Roasted cauliflower seasoned with paprika and aromatic tarragon.'
                  elsif product_title_lower contains 'charred green beans'
                    assign product_description_text = 'Charred green beans topped with almonds, pomegranate seeds, and creamy goat cheese.'
                  elsif product_title_lower contains 'classic arugula salad'
                    assign product_description_text = 'Fresh arugula with cherry tomatoes, pine nuts, grated Parmesan, and olive oil.'
                  elsif product_title_lower contains 'seasonal greens salad'
                    assign product_description_text = 'Refreshing mix of cucumber, watermelon, mint, and feta, tossed in a bright lemon-lime dressing.'
                  elsif product_title_lower contains 'kale crunch salad'
                    assign product_description_text = 'Crisp kale with apples, walnuts, golden raisins, and raspberry vinaigrette.'
                  elsif product_title_lower contains 'mediterranean cucumber salad'
                    assign product_description_text = 'Cucumber, cherry tomatoes, and red onions tossed in a sumac olive oil dressing.'
                  elsif product_title_lower contains 'citrus avocado salad'
                    assign product_description_text = 'Orange, avocado, and arugula finished with a white balsamic vinaigrette.'
                  elsif product_title_lower contains 'overnight oats'
                    assign product_description_text = 'Creamy oats with raspberry, blueberry, shredded coconut, and in-house-made banana milk. (8oz each/order)'
                  elsif product_title_lower contains 'chia pudding'
                    assign product_description_text = 'Chia seed pudding layered with yogurt, blueberry, peanut butter, and flax seeds. (8oz each/order)'
                  elsif product_title_lower contains 'egg bites'
                    assign product_description_text = 'Fluffy egg bites with spinach and green onions. (3/order)'
                  elsif product_title_lower contains 'greek yogurt parfait'
                    assign product_description_text = 'Greek yogurt layered with house-made granola, mixed berries, and honey. (8oz each/order)'
                  elsif product_title_lower contains 'protein muffins'
                    assign product_description_text = 'Nourishing muffins made with plant-based protein powder, pumpkin purée, maple syrup, warm spices, and almond milk. (3 each/order)'
                  elsif product_title_lower contains 'banana bread'
                    assign product_description_text = 'Moist banana bread with cinnamon and almond milk. (3 slices/order)'
                  elsif product_title_lower contains 'energy bites'
                    assign product_description_text = 'Wholesome bites made with oats, almond butter, maple syrup, and dark chocolate chunks. (5 each/order)'
                  elsif product_title_lower contains 'mango bread'
                    assign product_description_text = 'Soft mango bread flavored with cinnamon, cardamom, and almond milk. (3 slices/order)'
                  elsif product_title_lower contains 'green glow'
                    assign product_description_text = 'A vibrant blend of cucumber, celery, green apple, spinach, kale, lemon, and ginger. (10oz/each)'
                  elsif product_title_lower contains 'citrus immunity'
                    assign product_description_text = 'Bright citrus mix of orange, grapefruit, lemon, pineapple, ginger, and turmeric. (10oz/each)'
                  elsif product_title_lower contains 'beet boost'
                    assign product_description_text = 'Earthy-sweet blend of beetroot, carrot, apple, lemon, and ginger. (10oz/each)'
                  elsif product_title_lower contains 'tropical greens'
                    assign product_description_text = 'Refreshing fusion of pineapple, mango, spinach, cucumber, lime, and mint. (10oz/each)'
                  endif
                %}

                <a href="{{ product.url | within: category_collection }}" class="po-product-card">
                  <div class="po-product-media">
                    {% if product.featured_image != blank %}
                      {{
                        product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '360, 480, 620, 760, 900',
                          sizes: '(min-width: 1100px) 33vw, (min-width: 820px) 33vw, 50vw',
                          alt: product.title
                      }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'po-placeholder-svg' }}
                    {% endif %}

                    {% if badge_text != blank %}
                      <span class="po-product-badge {{ badge_class }}">{{ badge_text }}</span>
                    {% endif %}

                    {% if section.settings.show_quick_view %}
                      <span class="po-quick-view" aria-hidden="true">
                        <span class="po-quick-view__text">{{ section.settings.quick_view_label }}</span>
                      </span>
                    {% endif %}
                  </div>

                  <div class="po-product-info">
                    <div class="po-product-summary">
                      <div class="po-product-title-row">
                        <h3 class="po-product-title">{{ product.title }}</h3>
                      </div>

                      {% if menu_icons_value != blank %}
                        <span class="po-dietary-icons" aria-label="Dietary information">
                          {% for icon in menu_icons %}
                            {% assign clean_icon = icon | strip | upcase %}
                            {% if clean_icon != blank %}
                              <span class="po-dietary-icon">{{ clean_icon }}</span>
                            {% endif %}
                          {% endfor %}
                        </span>
                      {% endif %}

                      {% if section.settings.show_price %}
                        <div class="po-product-price">{{ product.price | money }}</div>
                      {% endif %}

                      {% if section.settings.show_meta_text and category_meta != blank %}
                        <div class="po-product-meta">{{ category_meta }}</div>
                      {% endif %}
                    </div>

                    {% if product_description_text != blank %}
                      <button type="button" class="po-details-btn" onclick="toggleDetails(event, this)">
                        <span class="po-details-btn__text">View Details</span>
                        <svg class="po-details-btn__icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                      <div class="po-meal-desc">{{ product_description_text }}</div>
                    {% endif %}
                  </div>
                </a>
              {% endfor %}
            {% else %}
              {% for i in (1..3) %}
                <div class="po-product-card">
                  <div class="po-product-media">
                    {{ 'product-1' | placeholder_svg_tag: 'po-placeholder-svg' }}

                    {% if section.settings.show_quick_view %}
                      <span class="po-quick-view" aria-hidden="true">
                        <span class="po-quick-view__text">{{ section.settings.quick_view_label }}</span>
                      </span>
                    {% endif %}
                  </div>

                  <div class="po-product-info">
                    <h3 class="po-product-title">Menu Item</h3>
                    {% if section.settings.show_price %}
                      <div class="po-product-price">{{ 2400 | money }}</div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<script>
  function toggleDetails(event, button) {
    event.preventDefault();
    event.stopPropagation();

    var card = button.closest('.po-product-card');
    if (!card) return;

    var isActive = card.classList.toggle('active');
    var label = button.querySelector('.po-details-btn__text');
    if (label) {
      label.textContent = isActive ? 'Hide Details' : 'View Details';
    }
  }
</script>

