  }

  function updatePlanCardPrices() {
    // Plan cards always show the base weekly price. Monthly 10% savings is shown
    // only in the right-hand order summary, as requested.
  }

  // Same-juice bundle pricing. Different juice names do NOT combine.
  // Requested tiers: 1=$9, 2=$18, 3=$24, 4=$36, 5=$45, 6=$45, 7=$54.
  // After 7, each additional juice adds $9: 8=$63, 9=$72, etc.
  function sameJuiceBundlePrice(quantity) {
    const q = Math.max(0, Number(quantity) || 0);
    const tiers = { 0: 0, 1: 9, 2: 18, 3: 24, 4: 36, 5: 45, 6: 45, 7: 54 };
    if (q <= 7) return tiers[q];
    return 54 + ((q - 7) * 9);
  }

  function itemCategory(itemId) {
    for (const cat of addOnsCatalog) {
      if (cat.items.some(i => String(i.id) === String(itemId))) return cat.category;
    }
    return '';
  }

  function getItemDisplayPrice(item) {
    const qty = addOnTracking[item.id] || 0;
    if (item.categoryKey === 'juice' || itemCategory(item.id) === 'Fresh-Pressed Juice') {
      return sameJuiceBundlePrice(qty);
    }
    return qty * Number(item.price);
  }

  function isFamilyPlan() {
    return activePlanKey === 'family';
  }

  function getAddOnDiscountRate() {
    return isFamilyPlan() ? FAMILY_ADDON_DISCOUNT_RATE : 0;
  }

  function getAddOnBaseTotalForItem(item, qty) {
    const q = Number(qty) || 0;
    if (q <= 0) return 0;
    if (itemCategory(item.id) === 'Fresh-Pressed Juice') {
      return sameJuiceBundlePrice(q);
    }
    return q * Number(item.price);
  }

  function getAddOnFinalTotalForItem(item, qty) {
    const base = getAddOnBaseTotalForItem(item, qty);
    return base * (1 - getAddOnDiscountRate());
  }

  function getAddOnsBaseTotal() {
    let total = 0;
    addOnsCatalog.forEach(cat => {
      cat.items.forEach(item => {
        total += getAddOnBaseTotalForItem(item, addOnTracking[item.id] || 0);
      });
    });
    return total;
  }

  function getAddOnsTotal() {
    let total = 0;
    addOnsCatalog.forEach(cat => {
      cat.items.forEach(item => {
        total += getAddOnFinalTotalForItem(item, addOnTracking[item.id] || 0);
      });
    });
    return total;
  }

  function recalculateSidebar() {
    const config = planConfigs[activePlanKey];
    const basePlanPrice = Number(config.price);
    const recurringPlanPrice = frequency === 'Monthly' ? Number(config.monthlyPrice) : basePlanPrice;
    // Recurring subtotal is ALWAYS the meal plan only. Add-ons are one-time and excluded.
    const recurringSubtotalOnly = recurringPlanPrice;
    const addOnsBaseTotal = getAddOnsBaseTotal();
    const addOnsTotal = getAddOnsTotal();
    const familyAddOnDiscount = isFamilyPlan() ? (addOnsBaseTotal - addOnsTotal) : 0;
    const merchandiseSubtotal = recurringPlanPrice + addOnsTotal;
    const delivery = 10.00;
    const taxBase = merchandiseSubtotal + delivery;
    const tax = taxBase * 0.07;
    const firstOrderTotal = taxBase + tax;

    el('sum-plan-title').innerText = config.name;
    // Keep the plan line at its base price; monthly savings is shown below separately.
    el('sum-plan-price').innerText = `$${basePlanPrice.toFixed(2)}`;

    const monthlyNote = el('monthly-discount-note');
    if (frequency === 'Monthly') {
      monthlyNote.style.display = 'block';
      el('monthly-discount-value').innerText = `$${recurringPlanPrice.toFixed(2)}`;
    } else {
      monthlyNote.style.display = 'none';
    }

    const familyAddonNote = el('family-addon-note');
    const familyAddonPageNote = el('family-addon-page-note');
    const showFamilyAddonOffer = isFamilyPlan() && addOnsBaseTotal > 0;
    if (familyAddonNote) familyAddonNote.style.display = showFamilyAddonOffer ? 'block' : 'none';
    if (familyAddonPageNote) familyAddonPageNote.style.display = isFamilyPlan() ? 'block' : 'none';

    el('sum-subtotal-price').innerText = `$${merchandiseSubtotal.toFixed(2)}`;

    const addOnsLine = el('sum-addons-line');
    const addOnsLabel = el('sum-addons-label');
    if (addOnsTotal > 0) {
      addOnsLine.style.display = 'flex';
      if (addOnsLabel) {
        addOnsLabel.innerText = isFamilyPlan()
          ? 'One-Time Add-Ons (Family Add-Ons Discount, 10%)'
          : 'One-Time Add-Ons';
      }
      el('sum-addons-price').innerText = `$${addOnsTotal.toFixed(2)}`;
    } else {
      addOnsLine.style.display = 'none';
      if (addOnsLabel) addOnsLabel.innerText = 'One-Time Add-Ons';
      el('sum-addons-price').innerText = '$0.00';
    }

    el('sum-delivery-price').innerText = `$${delivery.toFixed(2)}`;
    el('sum-tax-price').innerText = `$${tax.toFixed(2)}`;
    el('sum-grand-total').innerText = `$${firstOrderTotal.toFixed(2)}`;
    el('sum-recurring-price').innerText = `$${recurringSubtotalOnly.toFixed(2)} / ${frequency === 'Monthly' ? 'month' : 'week'}`;
    updateDietaryPageSummary();

    const juiceBundleNote = el('juice-bundle-note');
    const hasJuiceBundle = addOnsCatalog.some(cat => cat.category === 'Fresh-Pressed Juice' && cat.items.some(item => (addOnTracking[item.id] || 0) >= 3));
    if (juiceBundleNote) {
      juiceBundleNote.style.display = hasJuiceBundle ? 'block' : 'none';
      if (juiceBundleNote) juiceBundleNote.textContent = 'Quantity discounts apply when the same juice is selected. Different juice names are priced separately.';
    }
  }

