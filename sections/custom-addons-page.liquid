  function updateAddonQty(id, delta) {
    const current = addOnTracking[id] || 0;
    const next = Math.max(0, current + delta);
    if (next === 0) delete addOnTracking[id];
    else addOnTracking[id] = next;

    document.getElementById(`addon-val-${id}-${SECTION_ID}`).innerText = next;
    recalculateSidebar();
