      ]
    },
    {
      category: "Fresh-Pressed Juice",
      items: [
        // TODO: paste your real Shopify CDN image URL between the quotes below for each Juice item.
        { id: "49089738539259", name: "Beet Boost", price: 9.00, image: "" },
