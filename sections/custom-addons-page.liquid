    "Seasonal Greens": "https://cdn.shopify.com/s/files/1/0787/2761/0619/files/SIMPLE_Watermelon_Cucumber_Feta_Salad___Clean_Food_Crush.jpg?v=1786036153",
    "Classic Arugula Salad": "https://cdn.shopify.com/s/files/1/0787/2761/0619/files/Fresh_arugula_salad_with_cherry_tomatoes_pine_nuts_and_parmesan_cheese_recipe_ideas.jpg?v=1786078881",
