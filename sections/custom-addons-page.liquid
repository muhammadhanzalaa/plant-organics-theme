    } else if (currentStep === 3) {
      updateDietaryPageSummary();
      el('view-step-main').classList.remove('active');
      el('view-step-4').classList.add('active');
      el('nav-node-3').classList.remove('active');
      el('nav-node-4').classList.add('active');
      currentStep = 4;
      el('sidebar-action-btn').innerText = "Continue To Add-Ons →";
