{% comment %}
  Plant Organics - All-in-One Custom Meal Box & Subscription Builder
  File: sections/custom-addons-page.liquid
  Version: V21 - Dedicated Dietary Preference Page
{% endcomment %}

<style>
  /* Base Container */
  .po-builder-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 15px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #1e293b;
  }

  /* Wizard Steps Navigation Header */
  .po-wizard-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 15px;
    flex-wrap: wrap;
  }
  .po-step-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
  }
  .po-step-item.active { color: #1b4332; }
  .po-step-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
  }
  .po-step-item.active .po-step-circle {
    background: #1b4332;
    color: #ffffff;
  }
  .po-step-line {
    width: 30px;
    height: 2px;
    background: #e2e8f0;
  }

  /* Common Banner */
  .po-alert-banner {
    background-color: #fff9e6;
    border: 1px solid #ffe58f;
    padding: 12px 16px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    color: #856404;
    margin-bottom: 20px;
  }

  /* Step Views Visibility */
  .po-step-view { display: none; }
  .po-step-view.active { display: block; }

  /* STEP 1: FORM STYLING */
  .po-form-card {
    max-width: 620px;
    margin: 20px auto;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.03);
  }
  .po-form-title {
    text-align: center;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 25px;
    color: #0f172a;
  }
  .po-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 20px;
  }
  .po-form-group { display: flex; flex-direction: column; gap: 6px; }
  .po-form-group.full-width { grid-column: span 2; }
  .po-form-group label {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    color: #475569;
    letter-spacing: 0.5px;
  }
  .po-form-group input {
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 13px;
    outline: none;
    transition: all 0.2s;
  }
  .po-form-group input:focus { border-color: #1b4332; box-shadow: 0 0 0 2px rgba(27,67,50,0.1); }

  .po-bottom-note {
    background: #fff3e6;
    border: 1px solid #ffd8a8;
    color: #d97706;
    font-size: 11px;
    text-align: center;
    padding: 12px;
    border-radius: 6px;
    margin-top: 20px;
    line-height: 1.4;
  }

  /* STEP 2 & 3 LAYOUT GRID */
  .po-main-layout {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 30px;
  }

  /* Step 2 Plan Cards */
  .po-section-label {
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
    margin: 20px 0 12px 0;
    letter-spacing: 0.5px;
  }
  .po-plans-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 25px;
  }
  .po-plan-card {
    border: 2px solid #e2e8f0;
    border-radius: 10px;
    padding: 16px;
    background: #ffffff;
    cursor: pointer;
    position: relative;
    transition: all 0.2s;
  }
  .po-plan-card.selected {
    border-color: #1b4332;
    background: #f4f8f5;
  }
  .po-plan-badge {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: #1b4332;
    color: #ffffff;
    font-size: 9px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 10px;
    letter-spacing: 0.5px;
  }
  .po-plan-title { font-weight: 800; font-size: 13px; text-transform: uppercase; margin-bottom: 4px; }
  .po-plan-price { font-size: 16px; font-weight: 800; color: #1b4332; margin-bottom: 6px; }
  .po-plan-desc { font-size: 11px; color: #64748b; line-height: 1.3; }

  /* Starter Meal Row (Dropdowns) */
  .po-starter-row {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 10px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 10px;
  }
  .po-starter-field label {
    display: block;
    font-size: 10px;
    font-weight: 800;
    color: #64748b;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .po-starter-field select {
    width: 100%;
    padding: 9px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 12px;
    background: #ffffff;
    outline: none;
  }

  /* Bulk Meal Row (Weight Buttons) */
  .po-cat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 10px 14px;
    border-radius: 6px;
    margin: 18px 0 10px 0;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }
  .po-bulk-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 8px;
  }
  .po-bulk-title { font-size: 13px; font-weight: 700; color: #1e293b; }
  .po-bulk-sub { font-size: 11px; color: #64748b; font-weight: normal; }
  .po-bulk-info-row { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .po-bulk-img {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
    background: #f1f5f9;
  }

  /* Quantity Control (+/-) */
  .po-qty-counter {
    display: flex;
    align-items: center;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    overflow: hidden;
    background: #ffffff;
  }
  .po-qty-btn {
    width: 30px;
    height: 30px;
    border: none;
    background: #f1f5f9;
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
    color: #334155;
    transition: background 0.15s;
  }
  .po-qty-btn:hover { background: #e2e8f0; }
  .po-qty-val {
    width: 32px;
    text-align: center;
    font-size: 12px;
    font-weight: 800;
  }

  /* SIDEBAR STYLING */
  .po-sidebar {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
    position: sticky;
    top: 20px;
    height: fit-content;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
  }
  .po-sb-heading {
    font-size: 11px;
    font-weight: 800;
    color: #475569;
    text-transform: uppercase;
    margin-bottom: 10px;
    letter-spacing: 0.5px;
  }
  .po-radio-group { margin-bottom: 18px; }
  .po-radio-group label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 8px;
    cursor: pointer;
  }

  .po-allergy-disclaimer {
    font-size: 10px;
    color: #64748b;
    line-height: 1.4;
    background: #f8fafc;
    padding: 10px;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
    margin-top: 8px;
  }
  .po-textarea {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 8px;
    font-size: 11px;
    margin-top: 6px;
    display: none;
    outline: none;
  }

  select.po-sb-select {
    width: 100%;
    padding: 10px;
    border: 1px solid #1b4332;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 18px;
    background: #ffffff;
  }

  .po-summary-line {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    margin-bottom: 8px;
    color: #334155;
  }
  .po-summary-line.total {
    font-size: 16px;
    font-weight: 800;
    color: #1b4332;
    border-top: 1px solid #e2e8f0;
    padding-top: 12px;
    margin-top: 12px;
  }
  .po-summary-line.discount { color:#d97706; }
  .po-summary-line.muted { color:#64748b; font-size:11px; }
  .po-summary-line.recurring {
    font-weight:800;
    border-top:1px solid #e2e8f0;
    padding-top:10px;
    margin-top:10px;
  }
  .po-family-addon-note {
    display: none;
    background: #f4f8f5;
    border: 1px solid #cde3d3;
    color: #1b4332;
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    margin: 8px 0 12px 0;
  }
  .po-monthly-note {
    display:none;
    background:#fff7ed;
    color:#c2410c;
    border:1px solid #fed7aa;
    border-radius:6px;
    padding:8px 10px;
    font-size:11px;
    font-weight:800;
    margin:-8px 0 12px;
  }
  .po-tax-note { font-size:10px; color:#64748b; line-height:1.35; margin-top:6px; }
  .po-dietary-recurring-note {
    color:#b91c1c;
    font-size:10px;
    line-height:1.35;
    font-weight:700;
    margin:-10px 0 14px;
  }

  /* Dedicated dietary preference page */
  .po-dietary-page {
    max-width: 720px;
    margin: 30px auto;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.03);
  }
  .po-dietary-page-title {
    text-align: center;
    font-size: 22px;
    font-weight: 900;
    text-transform: uppercase;
    color: #0f172a;
    margin-bottom: 10px;
  }
  .po-dietary-page-subtitle {
    text-align: center;
    font-size: 12px;
    color: #64748b;
    margin-bottom: 24px;
    line-height: 1.5;
  }
  .po-dietary-page label {
    display: block;
    font-size: 11px;
    font-weight: 800;
    color: #475569;
    text-transform: uppercase;
    margin-bottom: 7px;
    letter-spacing: 0.5px;
  }
  .po-dietary-page select {
    width: 100%;
    padding: 12px;
    border: 1px solid #1b4332;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    background: #ffffff;
    outline: none;
  }
  .po-dietary-page-note {
    margin-top: 14px;
    color: #b91c1c;
    font-size: 12px;
    line-height: 1.5;
    font-weight: 700;
  }
  .po-dietary-page-summary {
    margin-top: 22px;
    padding: 12px 14px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #f8fafc;
    font-size: 12px;
    color: #334155;
  }
  .po-dietary-page-summary strong {
    color: #1b4332;
  }

  .po-btn-action {
    width: 100%;
    background: #1b4332;
    color: #ffffff;
    padding: 14px;
    border: none;
    border-radius: 6px;
    font-weight: 800;
    font-size: 12px;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 15px;
    letter-spacing: 0.5px;
    transition: background 0.2s;
  }
  .po-btn-action:hover { background: #2d6a4f; }
  .po-btn-action:disabled { opacity: 0.6; cursor: not-allowed; }

  @media (max-width: 850px) {
    .po-main-layout { grid-template-columns: 1fr; }
    .po-plans-grid { grid-template-columns: 1fr; }
    .po-starter-row { grid-template-columns: 1fr; }
    .po-form-grid { grid-template-columns: 1fr; }
    .po-form-group.full-width { grid-column: span 1; }
  }

  /* ==========================================================
     STORE TYPOGRAPHY MATCH — FONT / SIZE / STYLE ONLY
     Based on the store typography variables supplied by client:
       Header 1: "Degular Demo Black", "Bricolage Grotesque", "Montserrat"
       Header 2: "Bricolage Grotesque", "Montserrat"
       Body:     "Montserrat Classic", "Montserrat", Arial
     No pricing, subscription, cart, validation, navigation or
     selection logic is changed by this block.
     ========================================================== */

  .po-builder-container {
    --po-store-header-1: "Degular Demo Black", "Bricolage Grotesque", "Montserrat", sans-serif;
    --po-store-header-2: "Bricolage Grotesque", "Montserrat", sans-serif;
    --po-store-body: "Montserrat Classic", "Montserrat", Arial, sans-serif;
    --po-store-heading-color: #293f07;
    --po-store-body-color: #2f2f2f;
    --po-store-muted-color: #64748b;
    --po-store-accent-color: #ff960e;

    font-family: var(--po-store-body);
    color: var(--po-store-body-color);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* Wizard / page navigation */
  .po-builder-container .po-step-item {
    font-family: var(--po-store-header-2);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.025em;
    color: var(--po-store-muted-color);
  }

  .po-builder-container .po-step-item.active {
    color: var(--po-store-heading-color);
  }

  .po-builder-container .po-step-circle {
    font-family: var(--po-store-header-2);
    font-size: 11px;
    font-weight: 700;
  }

  /* Common notices / small body copy */
  .po-builder-container .po-alert-banner,
  .po-builder-container .po-bottom-note,
  .po-builder-container .po-tax-note,
  .po-builder-container .po-dietary-recurring-note {
    font-family: var(--po-store-body);
    letter-spacing: 0.025em;
  }

  /* Main step headings */
  .po-builder-container .po-section-label,
  .po-builder-container .po-form-title,
  .po-builder-container .po-dietary-page-title,
  .po-builder-container .po-sb-heading {
    font-family: var(--po-store-header-1);
    color: var(--po-store-heading-color);
    letter-spacing: 0.01em;
  }

  .po-builder-container .po-section-label {
    font-size: 17px;
    font-weight: 900;
    line-height: 1.05;
  }

  .po-builder-container .po-form-title,
  .po-builder-container .po-dietary-page-title {
    font-size: 30px;
    font-weight: 900;
    line-height: 1;
  }

  .po-builder-container .po-sb-heading {
    font-size: 12px;
    font-weight: 800;
    line-height: 1.2;
  }

  /* Plan cards (Step 2) */
  .po-builder-container .po-plan-title {
    font-family: var(--po-store-header-2);
    color: var(--po-store-heading-color);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0.01em;
  }

  .po-builder-container .po-plan-price {
    font-family: var(--po-store-header-1);
    color: var(--po-store-heading-color);
    font-size: 28px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .po-builder-container .po-plan-price small {
    font-family: var(--po-store-header-2);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .po-builder-container .po-plan-desc {
    font-family: var(--po-store-body);
    color: var(--po-store-body-color);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }

  .po-builder-container .po-plan-badge {
    font-family: var(--po-store-header-2);
    background: var(--po-store-accent-color);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  /* Meal / add-on item typography (Steps 2 & 3) */
  .po-builder-container .po-cat-header {
    font-family: var(--po-store-header-2);
    color: var(--po-store-heading-color);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .po-builder-container .po-starter-field label,
  .po-builder-container .po-bulk-title {
    font-family: var(--po-store-header-2);
    color: var(--po-store-heading-color);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
  }

  .po-builder-container .po-starter-field select,
  .po-builder-container .po-textarea,
  .po-builder-container select.po-sb-select,
  .po-builder-container .po-dietary-page select,
  .po-builder-container .po-form-group input {
    font-family: var(--po-store-body);
    color: var(--po-store-body-color);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .po-builder-container .po-bulk-sub {
    font-family: var(--po-store-body);
    color: var(--po-store-muted-color);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.35;
  }

  .po-builder-container .po-qty-btn,
  .po-builder-container .po-qty-val {
    font-family: var(--po-store-header-2);
    font-weight: 700;
  }

  .po-builder-container .po-qty-btn {
    font-size: 14px;
  }

  .po-builder-container .po-qty-val {
    font-size: 12px;
  }

  /* Sidebar / order summary */
  .po-builder-container .po-radio-group,
  .po-builder-container .po-radio-group label,
  .po-builder-container .po-summary-line,
  .po-builder-container .po-family-addon-note,
  .po-builder-container .po-monthly-note,
  .po-builder-container .po-allergy-disclaimer,
  .po-builder-container .po-dietary-page-subtitle,
  .po-builder-container .po-dietary-page-note,
  .po-builder-container .po-dietary-page-summary {
    font-family: var(--po-store-body);
    color: var(--po-store-body-color);
  }

  .po-builder-container .po-radio-group label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.015em;
  }

  .po-builder-container .po-summary-line {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
  }

  .po-builder-container .po-summary-line.total {
    font-family: var(--po-store-header-2);
    color: var(--po-store-heading-color);
    font-size: 18px;
    font-weight: 800;
  }

  .po-builder-container .po-summary-line.recurring {
    font-family: var(--po-store-header-2);
    color: var(--po-store-heading-color);
    font-size: 13px;
    font-weight: 800;
  }

  /* Dedicated dietary page (Step 4) */
  .po-builder-container .po-dietary-page-title {
    font-size: 30px;
    font-weight: 900;
  }

  .po-builder-container .po-dietary-page-subtitle {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.55;
  }

  .po-builder-container .po-dietary-page label {
    font-family: var(--po-store-header-2);
    color: var(--po-store-heading-color);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .po-builder-container .po-dietary-page-note {
    color: #b91c1c;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.55;
  }

  .po-builder-container .po-dietary-page-summary {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.45;
  }

  .po-builder-container .po-dietary-page-summary strong {
    font-family: var(--po-store-header-2);
    color: var(--po-store-heading-color);
    font-weight: 800;
  }

  /* Buttons — match the store's bold display style */
  .po-builder-container .po-btn-action {
    font-family: var(--po-store-header-2);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

</style>

<div class="po-builder-container" id="po-builder-{{ section.id }}">

  <!-- Progress Header -->
  <div class="po-wizard-nav">
    <div class="po-step-item active" id="nav-node-1-{{ section.id }}"><span class="po-step-circle">1</span> Get Started</div>
    <div class="po-step-line"></div>
    <div class="po-step-item" id="nav-node-2-{{ section.id }}"><span class="po-step-circle">2</span> Build Your Meal Plans</div>
    <div class="po-step-line"></div>
    <div class="po-step-item" id="nav-node-3-{{ section.id }}"><span class="po-step-circle">3</span> Add Ons</div>
    <div class="po-step-line"></div>
    <div class="po-step-item" id="nav-node-4-{{ section.id }}"><span class="po-step-circle">4</span> Dietary Preference</div>
  </div>

  <!-- PAGE 1: GET STARTED FORM -->
  <div class="po-step-view active" id="view-step-1-{{ section.id }}">
    <div class="po-form-card">
      <div class="po-form-title">GET STARTED</div>

      <form id="po-customer-form-{{ section.id }}" >
