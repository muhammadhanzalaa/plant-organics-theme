  function cleanId(str) { return str.replace(/[^a-zA-Z0-9]/g, ''); }

  // Weight Limit Control Logic
  function updateBulkQty(catKey, itemName, delta, maxLimit) {
    const totalSelected = Object.values(bulkTracking[catKey]).reduce((a, b) => a + b, 0);
    const currentItemQty = bulkTracking[catKey][itemName] || 0;

    if (delta > 0 && totalSelected >= maxLimit) {
      alert(`You cannot select more than ${maxLimit} lbs for ${catKey.toUpperCase()}.`);
      return;
    }

    const nextQty = Math.max(0, currentItemQty + delta);
    if (nextQty === 0) delete bulkTracking[catKey][itemName];
    else bulkTracking[catKey][itemName] = nextQty;

    document.getElementById(`bqty-${catKey}-${cleanId(itemName)}-${SECTION_ID}`).innerText = nextQty;

    const newTotal = Object.values(bulkTracking[catKey]).reduce((a, b) => a + b, 0);
    document.getElementById(`lbl-${catKey}-${SECTION_ID}`).innerText = `${newTotal} / ${maxLimit} LBS`;
  }

  // Render Addons UI
  async function fetchAddonImage(item) {
    if (item.image) return item.image;

    const q = encodeURIComponent(item.name);
    const url = `/search/suggest.json?q=${q}&resources[type]=product&resources[limit]=8&resources[options][unavailable_products]=last`;

    try {
      const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
      if (!res.ok) return '';

      const data = await res.json();
      const products = data?.resources?.results?.products || [];
      const target = item.name.trim().toLowerCase();
      const exact = products.find(product => String(product.title || '').trim().toLowerCase() === target);
      const match = exact || products[0];
      if (!match) return '';

      let imageUrl = match.featured_image?.url || match.image?.url || match.featured_image || '';
      if (typeof imageUrl === 'object' && imageUrl) imageUrl = imageUrl.url || '';
      if (imageUrl && imageUrl.startsWith('//')) imageUrl = 'https:' + imageUrl;
      if (imageUrl) item.image = imageUrl;
      return imageUrl;
    } catch (error) {
      console.warn('Add-on image lookup failed:', item.name, error);
      return '';
    }
  }

  function updateAddonImageInDOM(item) {
    if (!item.image) return;
    const img = document.querySelector(`[data-addon-image-id="${item.id}"]`);
    if (img) {
      img.src = item.image;
      img.removeAttribute('data-placeholder');
    }
  }

  async function hydrateAddonImages() {
    const tasks = [];
    addOnsCatalog.forEach(cat => {
      cat.items.forEach(item => {
        if (!item.image) {
          tasks.push(
            fetchAddonImage(item).then(() => updateAddonImageInDOM(item))
          );
        }
      });
    });
    await Promise.allSettled(tasks);
  }

