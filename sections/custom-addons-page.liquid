              <div class="po-plan-desc">4 lbs protein • 3 lbs sides • 2 lbs salads</div>
            </div>
          </div>

          <div class="po-section-label" id="builder-box-title-{{ section.id }}">2. BUILD YOUR STARTER BOX</div>
          <div id="dynamic-builder-container-{{ section.id }}"></div>
        </div>

