  // Final AJAX Cart Submission
  function expectedRecurringPrice(planKey, freq) {
    const cfg = planConfigs[planKey];
    return freq === 'Monthly' ? Number(cfg.monthlyPrice) : Number(cfg.price);
  }

  function sellingPlanFrequencyMatches(name, freq) {
    const text = String(name || '').toLowerCase();
    if (freq === 'Weekly') {
      return /week|weekly/.test(text);
    }
    return /month|monthly/.test(text);
  }

  function sellingPlanAllocationCents(rawPrice) {
    // Shopify Liquid exposes selling-plan allocation money as minor units
    // (for example 13400 = $134.00) in this template context.
    // Keep this helper defensive in case a decimal dollar value is returned.
    const n = Number(rawPrice);
    if (!Number.isFinite(n)) return 0;
    return Math.abs(n) >= 1000 ? Math.round(n) : Math.round(n * 100);
  }

  function sellingPlanAllocationDollars(rawPrice) {
    return sellingPlanAllocationCents(rawPrice) / 100;
  }

  function findSellingPlanId(planKey, freq) {
    const cfg = planConfigs[planKey];
    const plans = appstlePlans[planKey] || [];
    const expected = expectedRecurringPrice(planKey, freq);
    const expectedCents = Math.round(expected * 100);

    // FIRST: use a verified, explicit selling-plan ID when one is known.
    // This is required for Starter because Shopify currently has several
    // older duplicate plans attached to the same product.
    const explicitId = freq === 'Weekly'
      ? cfg.weeklySellingPlanId
      : cfg.monthlySellingPlanId;

    if (explicitId) {
      return String(explicitId);
    }

    // SECOND: optional Theme Editor override, but only if its real price
    // matches the expected checkout price and its name matches the frequency.
    if (cfg.legacySellingPlanId) {
      const overridden = plans.find(p => String(p.id) === String(cfg.legacySellingPlanId));
      if (overridden) {
        const actualCents = sellingPlanAllocationCents(overridden.price);
        if (actualCents === expectedCents && sellingPlanFrequencyMatches(overridden.name, freq)) {
          return String(overridden.id);
        }
      }
    }

    // THIRD: automatic safe match using frequency + REAL allocation price.
    const exact = plans.find(p => {
      const actualCents = sellingPlanAllocationCents(p.price);
      return sellingPlanFrequencyMatches(p.name, freq) && actualCents === expectedCents;
    });

    if (exact) return String(exact.id);

    // Never fall back to a frequency-only match. That would allow an old
    // incorrect price (e.g. $114 or $149) to reach checkout.
    const available = plans.map(p => {
      const price = sellingPlanAllocationDollars(p.price);
      return `${p.name} = $${price.toFixed(2)} (ID ${p.id})`;
    }).join(' | ');

    throw new Error(
      `No correct ${freq} selling plan was found for ${cfg.name}. ` +
      `Expected $${expected.toFixed(2)} at checkout. ` +
      `Available selling plans: ${available || 'none'}`
    );
  }

  function getPlanSelectionProperties(config, planPrice, allergyText) {
    const basePlanPrice = Number(config.price);
    let propertiesPayload = {
      "Plan": config.name,
      "Displayed Plan Price": `$${planPrice.toFixed(2)}`,
      "Customer Name": `${customerData.firstName} ${customerData.lastName}`,
      "Customer Email": customerData.email,
      "Phone": customerData.phone,
      "Delivery Zip": customerData.zip,
      "Subscription Frequency": frequency,
      "Base Plan Price": `$${basePlanPrice.toFixed(2)}`,
      "Recurring Plan Price": `$${planPrice.toFixed(2)}`,
      "One-Time Add-Ons": `$${getAddOnsTotal().toFixed(2)}`,
      "Family Add-On Discount": isFamilyPlan() ? "10% OFF eligible add-ons" : "Not applicable",
      "Tax Estimate": `7%`,
      "Dietary Preference": el('dietary-preference-select').value,
      "Food Allergies": allergyText
    };

    if (config.type === 'dropdown') {
      document.querySelectorAll('#po-builder-' + SECTION_ID + ' .po-starter-row').forEach((row, idx) => {
        const p = row.querySelector('.starter-p-sel').value || 'Unselected';
        const s = row.querySelector('.starter-s-sel').value || 'Unselected';
        const sl = row.querySelector('.starter-sl-sel').value || 'Unselected';
        propertiesPayload[`Meal ${idx + 1}`] = `${p} / ${s} / ${sl}`;
      });
    } else {
      propertiesPayload["Proteins Selected"] = Object.entries(bulkTracking.protein)
        .map(([k, v]) => `${k} (${v} lbs)`).join(', ');
      propertiesPayload["Sides Selected"] = Object.entries(bulkTracking.side)
        .map(([k, v]) => `${k} (${v} lbs)`).join(', ');
      propertiesPayload["Salads Selected"] = Object.entries(bulkTracking.salad)
        .map(([k, v]) => `${k} (${v} lbs)`).join(', ');
    }

    return propertiesPayload;
  }

  function submitCartAndCheckout() {
    const btn = el('sidebar-action-btn');
    btn.innerText = "Processing...";
    btn.disabled = true;

    const config = planConfigs[activePlanKey];
    const allergyChoice = document.querySelector(`input[name="allergy_option_${SECTION_ID}"]:checked`);
    const allergyText = allergyChoice && allergyChoice.value === 'Yes'
      ? el('allergy-details').value
      : 'None';

    const basePlanPrice = Number(config.price);
    const planPrice = frequency === 'Monthly' ? Number(config.monthlyPrice) : basePlanPrice;

    let sellingPlanId;
    try {
      sellingPlanId = findSellingPlanId(activePlanKey, frequency);
    } catch (sellingPlanError) {
      alert(sellingPlanError.message);
      btn.innerText = "Proceed To Checkout →";
      btn.disabled = false;
      return;
    }

    // Juice quantity bundle pricing is still calculated for the page summary.
    // The checkout must use a Shopify backend discount/bundle rule if those
    // tier prices are intended to be authoritative at checkout.
    const propertiesPayload = getPlanSelectionProperties(config, planPrice, allergyText);

    // ONLY the meal-plan product receives a selling_plan.
    // This is the key rule: add-ons are deliberately one-time items.
    const planItem = {
      id: Number(config.variantId),
      quantity: 1,
      selling_plan: Number(sellingPlanId),
      properties: propertiesPayload
    };

    const itemsPayload = [planItem];

    Object.keys(addOnTracking).forEach(vId => {
      const qty = Number(addOnTracking[vId]);
      if (qty <= 0) return;
      itemsPayload.push({
        id: Number(vId),
        quantity: qty
        // NO selling_plan here. Add-ons remain one-time purchases.
      });
    });

    // Clear any previous builder cart so repeat attempts never stack old items.
    fetch('/cart/clear.js', { method: 'POST', headers: { 'Accept': 'application/json' } })
      .then(r => { if (!r.ok) throw new Error('Could not clear the previous cart.'); return r.json(); })
      // Add the subscription plan first. This isolates any selling-plan problem
      // from normal one-time add-ons and lets us report the exact Shopify error.
      .then(() => fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [planItem] })
      }))
      .then(async res => {
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.status || data.errors) {
          const detail = data.description || data.message || data.errors || `HTTP ${res.status}`;
          throw new Error(`Could not add ${config.name} subscription. Shopify said: ${typeof detail === 'string' ? detail : JSON.stringify(detail)}`);
        }
        return data;
      })
      // Add each one-time add-on separately. If one fails, we identify its exact name
      // instead of incorrectly telling the customer every product is sold out.
      .then(() => {
        const addonEntries = Object.keys(addOnTracking)
          .map(vId => ({
            variantId: String(vId),
            quantity: Number(addOnTracking[vId])
          }))
          .filter(x => x.quantity > 0);

        return addonEntries.reduce((chain, entry) => {
          return chain.then(() => {
            const addon = addOnsCatalog.flatMap(cat => cat.items).find(item => String(item.id) === entry.variantId);
            const addonName = addon ? addon.name : `Variant ${entry.variantId}`;

            return fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({
                items: [{
                  id: entry.variantId,
                  quantity: entry.quantity
                }]
              })
            }).then(async res => {
              const data = await res.json().catch(() => ({}));
              if (!res.ok || data.status || data.errors) {
                const detail = data.description || data.message || data.errors || `HTTP ${res.status}`;
                throw new Error(`Could not add ${addonName}. Shopify said: ${typeof detail === 'string' ? detail : JSON.stringify(detail)}`);
              }
              return data;
            });
          });
        }, Promise.resolve());
      })
      .then(() => {
        // Shopify handles any configured automatic/eligible first-order discount
        // Shopify handles any eligible first-order discount directly at checkout.
        window.location.href = '/checkout';
      })
      .catch(err => {
        console.error('Builder cart error:', err);
        // Leave a useful diagnostic instead of the misleading generic "sold out" message.
        alert(err.message || 'Shopify could not add the selected item.');
        btn.innerText = currentStep === 3 ? "Proceed To Checkout →" : "Continue To Add-Ons →";
        btn.disabled = false;
      });
  }

  function bindUIEvents() {
    const root = document.getElementById(`po-builder-${SECTION_ID}`);
    if (!root) return;

    const form = document.getElementById(`po-customer-form-${SECTION_ID}`);
    if (form) {
      form.addEventListener('submit', submitFormStep1);
    }

    const zipInput = document.getElementById(`input-zip-${SECTION_ID}`);
    if (zipInput) {
      zipInput.addEventListener('input', () => {
        zipInput.value = zipInput.value.replace(/\D/g, '').slice(0, 5);
        const errorEl = document.getElementById(`zip-error-${SECTION_ID}`);
        if (errorEl && ALLOWED_ZIP_CODES.has(zipInput.value)) errorEl.style.display = 'none';
      });
      zipInput.addEventListener('blur', () => validateDeliveryZip(zipInput.value));
    }

    root.querySelectorAll('.po-plan-card[data-plan-key]').forEach(card => {
      card.addEventListener('click', () => switchPlan(card.dataset.planKey));
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          switchPlan(card.dataset.planKey);
        }
      });
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');
    });

    root.querySelectorAll('input[data-frequency]').forEach(input => {
      input.addEventListener('change', (event) => changeFrequency(event.target.value));
    });

    root.querySelectorAll('input[data-allergy]').forEach(input => {
      input.addEventListener('change', (event) => toggleAllergyInput(event.target.value === 'Yes'));
    });

    const actionButton = document.getElementById(`sidebar-action-btn-${SECTION_ID}`);
    if (actionButton) actionButton.addEventListener('click', handleStepNavigation);

    const dietaryContinueButton = document.getElementById(`dietary-continue-btn-${SECTION_ID}`);
    if (dietaryContinueButton) dietaryContinueButton.addEventListener('click', handleStepNavigation);

    const builderContainer = document.getElementById(`dynamic-builder-container-${SECTION_ID}`);
    if (builderContainer) {
      builderContainer.addEventListener('click', (event) => {
        const button = event.target.closest('[data-bulk-cat][data-bulk-item]');
        if (!button) return;
        event.preventDefault();
        updateBulkQty(
          button.dataset.bulkCat,
          button.dataset.bulkItem,
          Number(button.dataset.bulkDelta),
          Number(button.dataset.bulkMax)
        );
      });
    }

    const addonsContainer = document.getElementById(`dynamic-addons-container-${SECTION_ID}`);
    if (addonsContainer) {
      addonsContainer.addEventListener('click', (event) => {
        const button = event.target.closest('[data-addon-id]');
        if (!button) return;
        event.preventDefault();
        updateAddonQty(button.dataset.addonId, Number(button.dataset.addonDelta));
      });
    }
  }

  bindUIEvents();
  recalculateSidebar();

  // All controls are bound with addEventListener; no inline POBuilder_* handlers are used.
})();
</script>

