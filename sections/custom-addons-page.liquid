        </div>
        <div class="po-monthly-note" id="monthly-discount-note-{{ section.id }}">Monthly selected: 10% OFF → <span id="monthly-discount-value-{{ section.id }}">$120.60</span> / month</div>
        <div class="po-family-addon-note" id="family-addon-note-{{ section.id }}">Family Plan selected: 10% OFF all eligible add-ons</div>
        <div class="po-summary-line" id="sum-addons-line-{{ section.id }}" style="display:none;">
          <span id="sum-addons-label-{{ section.id }}">One-Time Add-Ons</span>
          <span id="sum-addons-price-{{ section.id }}">$0.00</span>
        </div>
        <div class="po-summary-line">
          <span>Subtotal</span>
          <span id="sum-subtotal-price-{{ section.id }}">$134.00</span>
        </div>
        <div class="po-summary-line">
          <span>+ Delivery</span>
          <span id="sum-delivery-price-{{ section.id }}">$10.00</span>
        </div>
        <div class="po-summary-line">
          <span>Estimated Tax (7%)</span>
          <span id="sum-tax-price-{{ section.id }}">$0.00</span>
        </div>
        <div class="po-summary-line total">
          <span>Estimated Total Before Checkout Discounts</span>
          <span id="sum-grand-total-{{ section.id }}">$0.00</span>
        </div>
        <div class="po-summary-line recurring" id="sum-recurring-line-{{ section.id }}">
          <span>Recurring Subtotal</span>
          <span id="sum-recurring-price-{{ section.id }}">$134.00 / week</span>
        </div>
        <div class="po-tax-note">Tax shown above is a 7% estimate for the page summary. Shopify will calculate the final tax in checkout from the customer's address and tax settings.</div>

        <button class="po-btn-action" id="sidebar-action-btn-{{ section.id }}" >Continue To Add-Ons &rarr;</button>
      </div>

    </div>
  </div>
</div>

<!-- STEP 4: DEDICATED DIETARY PREFERENCE PAGE -->
<div class="po-step-view" id="view-step-4-{{ section.id }}">
