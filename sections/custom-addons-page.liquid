  // Step Navigation Handler
  function handleStepNavigation() {
    if (!validateDeliveryZip(customerData.zip || el('input-zip').value)) {
      return;
    }

    if (currentStep === 2) {
      const config = planConfigs[activePlanKey];

      // Validate weight limits if bulk plan
      if (config.type === 'bulk') {
        for (let catKey of ['protein', 'side', 'salad']) {
          const sum = Object.values(bulkTracking[catKey]).reduce((a, b) => a + b, 0);
          if (sum < config.limits[catKey]) {
            alert(`Please complete selecting required ${config.limits[catKey]} lbs for ${catKey.toUpperCase()}.`);
            return;
          }
        }
