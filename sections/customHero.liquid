    #shopify-section-{{ section.id }} .po-independent-hero-benefit {
      min-height: 39px;
      padding: 10px 13px;
      border-radius: 18px;
      background: rgba(149, 173, 79, 0.08);
      border: 1px solid rgba(149, 173, 79, 0.2);
      color: rgba(41, 63, 7, 0.86);
      font-size: 12.5px;
      line-height: 1.2;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-benefit svg {
