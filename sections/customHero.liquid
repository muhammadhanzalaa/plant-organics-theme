<style>
  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');

  #shopify-section-{{ section.id }} .po-independent-hero-section,
  #shopify-section-{{ section.id }} .po-independent-hero-section * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .po-independent-hero-section {
    --po-page-width: 1320px;

    --po-pink: #fcb6eb;
    --po-dark-green: #293f07;
    --po-green: #95ad4f;
    --po-orange: #ff960e;
    --po-purple: #927ec3;
    --po-white: #ffffff;

    --po-font-header-1: "Degular Demo Black", "Bricolage Grotesque", "Montserrat", sans-serif;
    --po-font-header-2: "Bricolage Grotesque", "Montserrat", sans-serif;
    --po-font-body: "Montserrat Classic", "Montserrat", Arial, sans-serif;

    --po-hero-height: 720px;

    width: 100%;
    font-family: var(--po-font-body);
    color: var(--po-white);
    overflow: hidden;
    background: var(--po-dark-green);
  }

  #shopify-section-{{ section.id }} .po-independent-container {
    width: 100%;
    max-width: var(--po-page-width);
    margin: 0 auto;
    padding-left: 22px;
    padding-right: 22px;
  }

  #shopify-section-{{ section.id }} .po-independent-hero {
    position: relative;
    min-height: var(--po-hero-height);
    overflow: hidden;
    isolation: isolate;
    background: var(--po-dark-green);
  }

  #shopify-section-{{ section.id }} .po-independent-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(
        90deg,
        rgba(41, 63, 7, 0.96) 0%,
        rgba(41, 63, 7, 0.84) 35%,
        rgba(41, 63, 7, 0.46) 66%,
        rgba(41, 63, 7, 0.18) 100%
      );
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .po-independent-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    background:
      radial-gradient(circle at 18% 34%, rgba(149, 173, 79, 0.2), transparent 32%),
      radial-gradient(circle at 54% 18%, rgba(255, 150, 14, 0.16), transparent 30%),
      linear-gradient(180deg, rgba(41, 63, 7, 0.02), rgba(41, 63, 7, 0.28));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .po-independent-hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 900ms ease, transform 1800ms ease;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .po-independent-hero-slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  #shopify-section-{{ section.id }} .po-independent-hero-slide img {
    width: 100%;
    height: 100%;
    min-height: var(--po-hero-height);
    display: block;
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .po-independent-hero-content {
    position: relative;
    z-index: 5;
    min-height: var(--po-hero-height);
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .po-independent-hero-box {
    max-width: 780px;
    padding: 76px 0;
  }

  #shopify-section-{{ section.id }} .po-independent-hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    padding: 0 17px;
    border-radius: 999px;
    background: rgba(149, 173, 79, 0.2);
    border: 1px solid rgba(149, 173, 79, 0.4);
    color: var(--po-white);
    font-family: var(--po-font-header-2);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 24px;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  #shopify-section-{{ section.id }} .po-independent-hero-kicker::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--po-orange);
  }

  #shopify-section-{{ section.id }} .po-independent-hero-title {
    margin: 0;
    color: var(--po-white);
    font-family: var(--po-font-header-1);
    font-size: clamp(54px, 7.4vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.065em;
    font-weight: 900;
    font-style: normal;
    text-transform: none;
  }

  #shopify-section-{{ section.id }} .po-independent-hero-title em {
    color: var(--po-orange);
    font-family: var(--po-font-header-1);
    font-weight: 900;
    font-style: normal;
    text-shadow: 0 18px 40px rgba(255, 150, 14, 0.18);
  }

  #shopify-section-{{ section.id }} .po-independent-hero-text {
    margin: 26px 0 0;
    max-width: 650px;
    color: rgba(255, 255, 255, 0.86);
    font-family: var(--po-font-body);
    font-size: clamp(16px, 1.42vw, 20px);
    line-height: 1.7;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .po-independent-hero-actions {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  #shopify-section-{{ section.id }} .po-independent-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 25px;
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--po-font-header-2);
    font-size: 15px;
    font-weight: 900;
    line-height: 1;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .po-independent-btn:hover,
  #shopify-section-{{ section.id }} .po-independent-btn:focus {
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .po-independent-btn-accent {
    background: var(--po-orange);
    color: var(--po-dark-green);
    border: 2px solid var(--po-orange);
    box-shadow:
      0 18px 38px rgba(0, 0, 0, 0.22),
      0 0 0 7px rgba(255, 150, 14, 0.08);
  }

  #shopify-section-{{ section.id }} .po-independent-btn-accent:hover,
  #shopify-section-{{ section.id }} .po-independent-btn-accent:focus {
    transform: translateY(-2px);
    background: var(--po-green);
    color: var(--po-dark-green);
    border-color: var(--po-green);
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.26),
      0 0 0 9px rgba(149, 173, 79, 0.1);
  }

  #shopify-section-{{ section.id }} .po-independent-delivery-checker {
    width: 100%;
    max-width: 360px;
  }

  #shopify-section-{{ section.id }} .po-independent-zip-field {
    display: flex;
    align-items: stretch;
    width: 70%;
    min-height: 54px;
    border-radius: 999px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.98);
    border: 2px solid rgba(255, 255, 255, 0.72);
    box-shadow:
      0 18px 42px rgba(0, 0, 0, 0.18),
      0 0 0 7px rgba(255, 255, 255, 0.06);
  }

  #shopify-section-{{ section.id }} .po-independent-zip-input {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0 17px;
    color: var(--po-dark-green);
    font-family: var(--po-font-header-2);
    font-size: 15px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .po-independent-zip-input::placeholder {
    color: rgba(41, 63, 7, 0.56);
  }

  #shopify-section-{{ section.id }} .po-independent-zip-input:disabled {
    opacity: 0.75;
  }

  #shopify-section-{{ section.id }} .po-independent-zip-button {
    flex: 0 0 auto;
    border: 0;
    outline: 0;
    cursor: pointer;
    padding: 0 21px;
    background: var(--po-orange);
    color: var(--po-dark-green);
    font-family: var(--po-font-header-2);
    font-size: 15px;
    font-weight: 900;
    white-space: nowrap;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      opacity 0.25s ease;
  }

  #shopify-section-{{ section.id }} .po-independent-zip-button:hover,
  #shopify-section-{{ section.id }} .po-independent-zip-button:focus {
    background: var(--po-green);
    color: var(--po-dark-green);
  }

  #shopify-section-{{ section.id }} .po-independent-zip-button:disabled {
    cursor: not-allowed;
    opacity: 0.75;
  }

  #shopify-section-{{ section.id }} .po-independent-zip-message {
    min-height: 20px;
    margin: 9px 0 0;
    padding-left: 4px;
    color: rgba(255, 255, 255, 0.86);
    font-family: var(--po-font-body);
    font-size: 13px;
    line-height: 1.4;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .po-independent-zip-message.is-success {
    color: #bdf58f;
  }

  #shopify-section-{{ section.id }} .po-independent-zip-message.is-error {
    color: #ffb5a8;
  }

  #shopify-section-{{ section.id }} .po-independent-hero-benefits {
    margin-top: 32px;
    max-width: 830px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .po-independent-hero-benefit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.11);
    border: 1px solid rgba(149, 173, 79, 0.34);
    color: rgba(255, 255, 255, 0.94);
    font-family: var(--po-font-body);
    font-size: 13px;
    line-height: 1;
    font-weight: 700;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  #shopify-section-{{ section.id }} .po-independent-hero-benefit svg {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
    color: var(--po-orange);
    stroke-width: 2.7;
  }

  #shopify-section-{{ section.id }} .po-independent-dots {
    position: absolute;
    z-index: 7;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .po-independent-dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    background: rgba(255, 255, 255, 0.32);
    cursor: pointer;
    transition:
      width 0.25s ease,
      background 0.25s ease,
      border-color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .po-independent-dot.is-active {
    width: 30px;
    background: var(--po-orange);
    border-color: var(--po-orange);
  }

  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .po-independent-hero-section {
      --po-hero-height: 660px;
    }

    #shopify-section-{{ section.id }} .po-independent-hero::before {
      background:
        linear-gradient(
          90deg,
          rgba(41, 63, 7, 0.96) 0%,
          rgba(41, 63, 7, 0.76) 54%,
          rgba(41, 63, 7, 0.34) 100%
        );
    }

    #shopify-section-{{ section.id }} .po-independent-hero-box {
      max-width: 650px;
    }
  }

  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .po-independent-hero-section {
      --po-hero-height: auto;
      background: var(--po-white);
      color: var(--po-dark-green);
    }

    #shopify-section-{{ section.id }} .po-independent-container {
      padding-left: 14px;
      padding-right: 14px;
    }

    #shopify-section-{{ section.id }} .po-independent-hero {
      min-height: auto;
      display: flex;
      flex-direction: column;
      background:
        radial-gradient(circle at 18% 0%, rgba(149, 173, 79, 0.18), transparent 32%),
        radial-gradient(circle at 88% 18%, rgba(255, 150, 14, 0.12), transparent 34%),
        var(--po-white);
      padding: 16px 0 24px;
    }

    #shopify-section-{{ section.id }} .po-independent-hero::before,
    #shopify-section-{{ section.id }} .po-independent-hero::after {
      display: none;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-slide {
      position: relative;
      inset: auto;
      order: 1;
      display: none;
      width: calc(100% - 28px);
      height: 390px;
      margin: 0 auto;
      opacity: 1;
      transform: none;
      overflow: hidden;
      box-shadow: 0 22px 55px rgba(41, 63, 7, 0.14);
    }

    #shopify-section-{{ section.id }} .po-independent-hero-slide.is-active {
      display: block;
      opacity: 1;
      transform: none;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-slide::before {
      content: "";
      position: absolute;
      inset: 10px;
      z-index: 2;
      border: 1px solid rgba(255, 255, 255, 0.52);
      border-radius: 22px;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-slide::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(180deg, rgba(41, 63, 7, 0.02) 0%, rgba(41, 63, 7, 0.34) 100%),
        radial-gradient(circle at 50% 18%, rgba(255, 150, 14, 0.16), transparent 34%);
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-slide img {
      width: 100%;
      height: 100%;
      min-height: 0;
      object-fit: cover;
      object-position: center;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-content {
      order: 2;
      min-height: auto;
      display: block;
      padding-top: 16px;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-box {
      max-width: none;
      width: 100%;
      padding: 30px 20px 24px;
      border-radius: 28px;
      background: var(--po-white);
      border: 1px solid rgba(41, 63, 7, 0.12);
      box-shadow: 0 18px 48px rgba(41, 63, 7, 0.1);
    }

    #shopify-section-{{ section.id }} .po-independent-hero-kicker {
      min-height: 36px;
      padding: 0 14px;
      background: rgba(149, 173, 79, 0.16);
      border-color: rgba(149, 173, 79, 0.34);
      color: var(--po-dark-green);
      box-shadow: none;
      font-size: 10.5px;
      letter-spacing: 0.13em;
      margin-bottom: 18px;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-title {
      color: var(--po-dark-green);
      font-size: clamp(42px, 13vw, 58px);
      line-height: 0.92;
      letter-spacing: -0.055em;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-title em {
      color: var(--po-orange);
      text-shadow: none;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-text {
      margin-top: 20px;
      color: rgba(41, 63, 7, 0.76);
      font-size: 15.5px;
      line-height: 1.65;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      margin-top: 26px;
    }

    #shopify-section-{{ section.id }} .po-independent-btn {
      width: 100%;
      min-height: 52px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .po-independent-btn-accent {
      background: var(--po-orange);
      color: var(--po-dark-green);
      border-color: var(--po-orange);
      box-shadow: 0 18px 40px rgba(255, 150, 14, 0.18);
      border-radius: 18px;
    }

    #shopify-section-{{ section.id }} .po-independent-btn-accent:hover,
    #shopify-section-{{ section.id }} .po-independent-btn-accent:focus {
      background: var(--po-green);
      color: var(--po-dark-green);
      border-color: var(--po-green);
    }

    #shopify-section-{{ section.id }} .po-independent-delivery-checker {
      max-width: 100%;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .po-independent-zip-field {
      min-height: 52px;
      width: 100%;
      border-color: rgba(41, 63, 7, 0.14);
      box-shadow: 0 14px 34px rgba(41, 63, 7, 0.1);
    }

    #shopify-section-{{ section.id }} .po-independent-zip-input {
      font-size: 13px;
      padding: 0 14px;
    }

    #shopify-section-{{ section.id }} .po-independent-zip-button {
      font-size: 13px;
      padding: 0 17px;
    }

    #shopify-section-{{ section.id }} .po-independent-zip-message {
      color: rgba(41, 63, 7, 0.74);
      font-size: 12.5px;
      padding-left: 2px;
    }

    #shopify-section-{{ section.id }} .po-independent-zip-message.is-success {
      color: #2f7d32;
    }

    #shopify-section-{{ section.id }} .po-independent-zip-message.is-error {
      color: #c62828;
    }

    #shopify-section-{{ section.id }} .po-independent-hero-benefits {
      display: grid;
      grid-template-columns: 1fr;
      margin-top: 24px;
      gap: 8px;
