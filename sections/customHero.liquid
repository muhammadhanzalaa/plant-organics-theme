</style>

<section class="po-independent-hero-section">
  <div class="po-independent-hero" aria-label="Fresh organic meals hero">

    <div class="po-independent-hero-slide is-active">
      {% if section.settings.slide_1 != blank %}
        <img
          src="{{ section.settings.slide_1 | image_url: width: 2200 }}"
          alt="{{ section.settings.slide_1.alt | default: 'Vibrant fresh meals with organic ingredients and produce' | escape }}"
          loading="eager"
        >
      {% else %}
        <img
          src="https://cdn.shopify.com/s/files/1/0787/2761/0619/files/hero-bowl.jpg?v=1780297792"
          alt="Vibrant fresh meals with organic ingredients and produce"
        >
      {% endif %}
    </div>

    <div class="po-independent-hero-slide">
      {% if section.settings.slide_2 != blank %}
        <img
          src="{{ section.settings.slide_2 | image_url: width: 2200 }}"
          alt="{{ section.settings.slide_2.alt | default: 'Fresh organic weekly meals with responsibly sourced ingredients' | escape }}"
          loading="lazy"
        >
      {% else %}
        <img
          src="https://cdn.shopify.com/s/files/1/0787/2761/0619/files/hero-meals.jpg?v=1780297793"
          alt="Fresh organic weekly meals with responsibly sourced ingredients"
        >
      {% endif %}
    </div>

    <div class="po-independent-hero-slide">
      {% if section.settings.slide_3 != blank %}
        <img
          src="{{ section.settings.slide_3 | image_url: width: 2200 }}"
          alt="{{ section.settings.slide_3.alt | default: 'Organic seasonal produce and locally sourced ingredients' | escape }}"
          loading="lazy"
        >
      {% else %}
        <img
          src="https://cdn.shopify.com/s/files/1/0787/2761/0619/files/hero-ingredients.jpg?v=1780297792"
          alt="Organic seasonal produce and locally sourced ingredients"
        >
      {% endif %}
    </div>

    <div class="po-independent-container po-independent-hero-content">
      <div class="po-independent-hero-box">

        {% if section.settings.kicker != blank %}
          <div class="po-independent-hero-kicker">
            {{ section.settings.kicker }}
          </div>
        {% endif %}

        {% if section.settings.title != blank %}
          <h1 class="po-independent-hero-title">
            {{ section.settings.title }}
          </h1>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="po-independent-hero-text">
            {{ section.settings.text }}
          </p>
        {% endif %}

        <div class="po-independent-hero-actions">
          {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link }}" class="po-independent-btn po-independent-btn-accent">
              {{ section.settings.button_label }}
            </a>
          {% endif %}

          {% if section.settings.show_delivery_checker %}
            <div class="po-independent-delivery-checker" data-po-delivery-checker>
              <div class="po-independent-zip-field">
                <input
                  class="po-independent-zip-input"
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  maxlength="5"
                  placeholder="{{ section.settings.delivery_zip_placeholder }}"
                  aria-label="Check delivery ZIP code"
                  data-po-zip-input
                >

                <button class="po-independent-zip-button" type="button" data-po-zip-button>
                  {{ section.settings.delivery_zip_button }}
                </button>
              </div>

              <p class="po-independent-zip-message" data-po-zip-message></p>
            </div>
          {% endif %}
        </div>

        <div class="po-independent-hero-benefits">
          {% for block in section.blocks %}
            {% if block.type == 'benefit' %}
              <div class="po-independent-hero-benefit" {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12.5l4.2 4L19 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ block.settings.text }}
              </div>
            {% endif %}
          {% endfor %}
        </div>

      </div>
    </div>

    <div class="po-independent-dots">
      <button class="po-independent-dot is-active" type="button" data-po-slide-dot="0" aria-label="Go to slide 1"></button>
      <button class="po-independent-dot" type="button" data-po-slide-dot="1" aria-label="Go to slide 2"></button>
      <button class="po-independent-dot" type="button" data-po-slide-dot="2" aria-label="Go to slide 3"></button>
    </div>

  </div>
</section>

<script>
  (function () {
    function initPlantOrganicsHero() {
      var section = document.querySelector('#shopify-section-{{ section.id }} .po-independent-hero-section');
      if (!section || section.dataset.heroReady === 'true') return;

      var hero = section.querySelector('.po-independent-hero');
      if (!hero) return;

      section.dataset.heroReady = 'true';

      var slides = hero.querySelectorAll('.po-independent-hero-slide');
      var dots = hero.querySelectorAll('.po-independent-dot');
      var currentIndex = 0;
      var intervalTime = 4500;
      var timer;

      function showSlide(index) {
        if (!slides.length) return;

        currentIndex = index;

        slides.forEach(function (slide, slideIndex) {
          slide.classList.toggle('is-active', slideIndex === currentIndex);
        });

        dots.forEach(function (dot, dotIndex) {
          dot.classList.toggle('is-active', dotIndex === currentIndex);
        });
      }

      function nextSlide() {
        showSlide((currentIndex + 1) % slides.length);
      }

      function startSlider() {
        stopSlider();
        timer = setInterval(nextSlide, intervalTime);
      }

      function stopSlider() {
        if (timer) clearInterval(timer);
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          var index = parseInt(dot.getAttribute('data-po-slide-dot'), 10);

          if (isNaN(index)) return;

          showSlide(index);
          startSlider();
        });
      });

      hero.addEventListener('mouseenter', stopSlider);
      hero.addEventListener('mouseleave', startSlider);

      showSlide(0);
      startSlider();
    }

    function initDeliveryChecker() {
      var checker = document.querySelector('#shopify-section-{{ section.id }} [data-po-delivery-checker]');
      if (!checker || checker.dataset.deliveryReady === 'true') return;

      checker.dataset.deliveryReady = 'true';

      var zipInput = checker.querySelector('[data-po-zip-input]');
      var zipButton = checker.querySelector('[data-po-zip-button]');
      var zipMessage = checker.querySelector('[data-po-zip-message]');

      var defaultButtonText = zipButton ? zipButton.textContent : '';
      var redirectTimer = null;

      var eligibleZipsRaw = {{ section.settings.delivery_zip_codes | json }};
      var eligibleZips = String(eligibleZipsRaw || '')
        .split(/[\s,]+/)
        .map(function (zip) {
          return zip.trim();
        })
        .filter(Boolean);

      var zipRedirectLink = {{ section.settings.delivery_redirect_link | json }};
      var fallbackRedirectLink = {{ section.settings.button_link | json }};
      var redirectUrl = zipRedirectLink || fallbackRedirectLink || '';

      function resetCheckerState() {
        if (redirectTimer) {
          clearTimeout(redirectTimer);
          redirectTimer = null;
        }

        if (zipButton) {
          zipButton.disabled = false;
          zipButton.textContent = defaultButtonText;
        }

        if (zipInput) {
          zipInput.disabled = false;
        }
      }

      function checkZip() {
        if (!zipInput || !zipMessage) return;

        resetCheckerState();

        var zip = zipInput.value.replace(/\D/g, '').slice(0, 5);
        zipInput.value = zip;

        zipMessage.classList.remove('is-success', 'is-error');

        if (zip.length !== 5) {
          zipMessage.textContent = {{ section.settings.delivery_zip_invalid_message | json }};
          zipMessage.classList.add('is-error');
          return;
        }

        if (eligibleZips.indexOf(zip) !== -1) {
          zipMessage.textContent = {{ section.settings.delivery_zip_success_message | json }} + ' Redirecting...';
          zipMessage.classList.add('is-success');

          if (zipButton) {
            zipButton.disabled = true;
            zipButton.textContent = 'Redirecting...';
          }

          if (zipInput) {
            zipInput.disabled = true;
          }

          if (redirectUrl) {
            redirectTimer = setTimeout(function () {
              window.location.href = redirectUrl;
            }, 2000);
          }

          return;
        }

        zipMessage.textContent = {{ section.settings.delivery_zip_error_message | json }};
        zipMessage.classList.add('is-error');
      }

      if (zipButton) {
        zipButton.addEventListener('click', checkZip);
      }

      if (zipInput) {
        zipInput.addEventListener('input', function () {
          zipInput.value = zipInput.value.replace(/\D/g, '').slice(0, 5);

          if (zipMessage) {
            zipMessage.classList.remove('is-success', 'is-error');
            zipMessage.textContent = '';
          }
        });

        zipInput.addEventListener('keydown', function (event) {
          if (event.key === 'Enter') {
            event.preventDefault();
            checkZip();
          }
        });
      }
    }

    function initAll() {
      initPlantOrganicsHero();
      initDeliveryChecker();
    }

    initAll();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    }

    document.addEventListener('shopify:section:load', initAll);
  })();
</script>

