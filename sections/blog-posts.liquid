<style>
  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap');

  #BlogPosts-{{ section.id }},
  #BlogPosts-{{ section.id }} * {
    box-sizing: border-box;
  }

  #BlogPosts-{{ section.id }} {
    --po-pink: #fcb6eb;
    --po-dark-green: #293f07;
    --po-green: #95ad4f;
    --po-orange: #ff960e;
    --po-purple: #917EC3;
    --po-white: #ffffff;

    --po-font-header-1: "Degular Demo Black", "Bricolage Grotesque", "Montserrat", sans-serif;
    --po-font-header-2: "Bricolage Grotesque", "Montserrat", sans-serif;
    --po-font-body: "Montserrat Classic", "Montserrat", Arial, sans-serif;

    color: var(--po-dark-green);
    font-family: var(--po-font-body);
  }

  #BlogPosts-{{ section.id }} .section-header__title {
    color: var(--po-dark-green);
    font-family: var(--po-font-header-1);
    font-weight: 900;
    letter-spacing: -0.055em;
  }

  #BlogPosts-{{ section.id }} .section-header__title::after {
    background-color: var(--po-orange);
  }

  #BlogPosts-{{ section.id }} .section-header__link,
  #BlogPosts-{{ section.id }} .btn.btn--secondary {
    min-height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    background: transparent;
    color: var(--po-dark-green);
    border: 2px solid rgba(41, 63, 7, 0.34);
    font-family: var(--po-font-header-2);
    font-size: 12px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  #BlogPosts-{{ section.id }} .section-header__link:hover,
  #BlogPosts-{{ section.id }} .section-header__link:focus,
  #BlogPosts-{{ section.id }} .btn.btn--secondary:hover,
  #BlogPosts-{{ section.id }} .btn.btn--secondary:focus {
    background: var(--po-dark-green);
    color: var(--po-white);
    border-color: var(--po-dark-green);
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(41, 63, 7, 0.16);
    text-decoration: none;
  }

  #BlogPosts-{{ section.id }} .article__title,
  #BlogPosts-{{ section.id }} .article__grid-meta .article__title {
    color: var(--po-dark-green);
    font-family: var(--po-font-header-2);
    font-weight: 900;
    letter-spacing: -0.035em;
    text-decoration: none;
    transition: color 0.22s ease;
  }

  #BlogPosts-{{ section.id }} .article__title:hover,
  #BlogPosts-{{ section.id }} .article__grid-meta .article__title:hover {
    color: var(--po-orange);
    text-decoration: none;
  }

  #BlogPosts-{{ section.id }} .article__date,
  #BlogPosts-{{ section.id }} .article__author,
  #BlogPosts-{{ section.id }} .article__grid-meta {
    color: rgba(41, 63, 7, 0.68);
    font-family: var(--po-font-body);
  }

  #BlogPosts-{{ section.id }} .article__date {
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #BlogPosts-{{ section.id }} .article__author {
    font-weight: 700;
  }

  #BlogPosts-{{ section.id }} .article__grid-image {
    border-radius: 22px;
    overflow: hidden;
    background: rgba(149, 173, 79, 0.12);
  }

  #BlogPosts-{{ section.id }} .placeholder-svg {
    background:
      radial-gradient(circle at 15% 15%, rgba(149, 173, 79, 0.18), transparent 30%),
      radial-gradient(circle at 85% 20%, rgba(255, 150, 14, 0.13), transparent 30%),
      radial-gradient(circle at 80% 85%, rgba(252, 182, 235, 0.12), transparent 30%),
      var(--po-white);
    color: rgba(41, 63, 7, 0.28);
  }

  #BlogPosts-{{ section.id }} a {
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    #BlogPosts-{{ section.id }} .section-header__link,
    #BlogPosts-{{ section.id }} .btn.btn--secondary {
      width: 100%;
      margin-top: 18px;
    }
  }
</style>

{%- assign blog = blogs[section.settings.blog] -%}

{%- if section.settings.divider -%}
  <div class="section--divider">
{%- endif -%}

<div id="BlogPosts-{{ section.id }}" class="page-width">

  {%- if section.settings.title != blank -%}
    <header class="section-header{% if section.settings.view_all %}{% unless settings.type_headers_align_text %} section-header--with-link{% endunless %}{% endif %}">
      <h2 class="section-header__title">
        {{ section.settings.title | escape }}
      </h2>

      {%- if section.settings.view_all and blog != blank -%}
        <a href="{{ blog.url }}" class="btn btn--secondary btn--small section-header__link">
          {{ 'blogs.article.view_all' | t }}
        </a>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- unless blog.empty? or blog.articles.size == 0 -%}

    <div class="grid grid--uniform">
      {%- for article in blog.articles -%}
        {%- render 'article-grid-item',
          blog: blog,
          article: article,
          grid_item_width: 'medium-up--one-third',
          per_row: '3',
          image_size: section.settings.blog_image_size
        -%}
      {%- endfor -%}
    </div>

  {%- else -%}

    <div class="grid grid--uniform">
      {%- for i in (1..6) -%}
        <div class="grid__item medium-up--one-third" data-aos="row-of-3">
          <div class="grid">
            <div class="grid__item small--one-third">
              <a href="#" class="article__grid-image">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </a>
            </div>

            <div class="grid__item small--two-thirds">
              <div class="article__grid-meta">
                {%- if section.settings.blog_show_date -%}
                  <div class="article__date">
                    Jul 17, {{ 'now' | date: "%Y" }}
                  </div>
                {%- endif -%}

                <a href="#" class="article__title">Example blog post</a>

                {%- if section.settings.blog_show_author -%}
                  <div class="article__author">by Plant Organics</div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  {%- endunless -%}

</div>

{%- if section.settings.divider -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "All blog posts",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Blog posts"
    },
    {
      "id": "blog",
      "type": "blog",
      "label": "Blog"
    },
    {
      "type": "checkbox",
      "id": "blog_show_tags",
      "label": "Show tags",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "blog_show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_comments",
      "label": "Show comment count",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "blog_show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "select",
      "id": "blog_image_size",
      "label": "Image size",
      "default": "wide",
      "options": [
        {
          "value": "natural",
          "label": "Natural"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        },
        {
          "value": "portrait",
          "label": "Portrait (2:3)"
        },
        {
          "value": "wide",
          "label": "Wide (16:9)"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show section divider",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "All blog posts",
      "settings": {
        "title": "Blog posts",
        "view_all": true
      }
    }
  ]
}
{% endschema %}