                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

       
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu_column' -%}
          <div class="po-footer-smart__menu{% if forloop.first %} is-open{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="po-footer-smart__menu-title">{{ block.settings.heading }}</h3>

              <button class="po-footer-smart__menu-toggle" type="button" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
                <span>{{ block.settings.heading }}</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {%- endif -%}

            <ul class="po-footer-smart__menu-list">
              {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- else -%}
                <li><a href="{{ routes.root_url }}">Weekly Menu</a></li>
                <li><a href="{{ routes.root_url }}">Plans</a></li>
                <li><a href="{{ routes.root_url }}">Add-Ons</a></li>
                <li><a href="{{ routes.root_url }}">Glow Plan</a></li>
                <li><a href="{{ routes.root_url }}">Gift Cards</a></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="po-footer-smart__bottom">
      <div class="po-footer-smart__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name }}. {{ section.settings.copyright_text }}
      </div>

      <div class="po-footer-smart__legal">
        {%- if section.settings.privacy_url != blank -%}<a href="{{ section.settings.privacy_url }}">Privacy</a>{%- endif -%}
        {%- if section.settings.terms_url != blank -%}<a href="{{ section.settings.terms_url }}">Terms</a>{%- endif -%}
        {%- if section.settings.accessibility_url != blank -%}<a href="{{ section.settings.accessibility_url }}">Accessibility</a>{%- endif -%}
      </div>
    </div>

    {%- if show_selectors -%}
      <div class="po-footer-smart__selectors">
        {%- render 'multi-selectors',
          locale_selector: locale_selector,
          currency_selector: currency_selector,
          show_currency_flags: section.settings.show_currency_flags,
          location: 'footer'
        -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_payment_icons -%}
      {%- unless shop.enabled_payment_types == empty -%}
        <div class="po-footer-smart__payments">
          <ul class="inline-list payment-icons footer__section">
            {%- for type in shop.enabled_payment_types -%}
              <li class="icon--payment">{{ type | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endunless -%}
    {%- endif -%}
  </div>

  <script>
    (function () {
      var footer = document.currentScript.closest(".po-footer-smart");
      if (!footer) return;

      var toggles = footer.querySelectorAll(".po-footer-smart__menu-toggle");

      toggles.forEach(function (toggle) {
        toggle.addEventListener("click", function () {
          var menu = toggle.closest(".po-footer-smart__menu");
          if (!menu) return;

          var isOpen = menu.classList.contains("is-open");

          footer.querySelectorAll(".po-footer-smart__menu").forEach(function (item) {
            item.classList.remove("is-open");
            var itemToggle = item.querySelector(".po-footer-smart__menu-toggle");
            if (itemToggle) itemToggle.setAttribute("aria-expanded", "false");
          });

          if (!isOpen) {
            menu.classList.add("is-open");
            toggle.setAttribute("aria-expanded", "true");
          }
        });
      });

      var deliveryChecker = footer.querySelector("[data-po-delivery-checker]");
      if (!deliveryChecker) return;

      var zipInput = deliveryChecker.querySelector("[data-po-zip-input]");
      var zipButton = deliveryChecker.querySelector("[data-po-zip-button]");
      var zipMessage = deliveryChecker.querySelector("[data-po-zip-message]");

      var eligibleZipsRaw = {{ section.settings.delivery_zip_codes | json }};
      var eligibleZips = eligibleZipsRaw
        .split(/[\s,]+/)
        .map(function (zip) {
          return zip.trim();
        })
        .filter(Boolean);

      function checkZip() {
        if (!zipInput || !zipMessage) return;

        var zip = zipInput.value.replace(/\D/g, "").slice(0, 5);
        zipInput.value = zip;

        zipMessage.classList.remove("is-success", "is-error");

        if (zip.length !== 5) {
          zipMessage.textContent = {{ section.settings.delivery_zip_invalid_message | json }};
          zipMessage.classList.add("is-error");
          return;
        }

        if (eligibleZips.indexOf(zip) !== -1) {
          zipMessage.textContent = {{ section.settings.delivery_zip_success_message | json }};
          zipMessage.classList.add("is-success");
        } else {
          zipMessage.textContent = {{ section.settings.delivery_zip_error_message | json }};
          zipMessage.classList.add("is-error");
        }
      }

      if (zipButton) {
        zipButton.addEventListener("click", checkZip);
      }

      if (zipInput) {
        zipInput.addEventListener("input", function () {
          zipInput.value = zipInput.value.replace(/\D/g, "").slice(0, 5);
          zipMessage.classList.remove("is-success", "is-error");
          zipMessage.textContent = "";
        });

        zipInput.addEventListener("keydown", function (event) {
          if (event.key === "Enter") {
            event.preventDefault();
            checkZip();
          }
        });
      }
    })();
  </script>
</footer>

