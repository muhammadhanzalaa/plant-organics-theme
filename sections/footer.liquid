{%- liquid
  assign show_selectors = false
  assign currency_selector = false
  assign locale_selector = false

  if section.settings.show_currency_selector and shop.enabled_currencies.size > 1
    assign currency_selector = true
  endif

  if section.settings.show_locale_selector and shop.enabled_locales.size > 1
    assign locale_selector = true
  endif

  if currency_selector or locale_selector
    assign show_selectors = true
  endif
-%}

<footer
  class="po-split po-footer-smart"
  data-section-id="{{ section.id }}"
  data-section-type="footer-section"
  style="
    --po-page-width: {{ section.settings.page_width }}px;
    --po-cream: {{ section.settings.text_color }};
    --po-cream-deep: {{ section.settings.muted_color }};
    --po-forest: {{ section.settings.accent_green }};
    --po-forest-deep: {{ section.settings.bg_color }};
    --po-terracotta: {{ section.settings.terracotta_color }};
    --po-honey: {{ section.settings.accent_color }};
    --po-ink: {{ section.settings.ink_color }};
    --po-line: {{ section.settings.line_color }};
    --po-pad-top: {{ section.settings.padding_top }}px;
    --po-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <style>
    .po-footer-smart,
    .po-footer-smart * {
      box-sizing: border-box;
    }

    .po-footer-smart {
      width: 100%;
      background:
        radial-gradient(circle at 16% 0%, rgba(241, 200, 88, 0.075), transparent 34%),
        radial-gradient(circle at 88% 28%, rgba(47, 122, 78, 0.18), transparent 34%),
        linear-gradient(180deg, var(--po-forest-deep), #062f1e 100%);
      color: var(--po-cream);
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      padding: var(--po-pad-top) 0 var(--po-pad-bottom);
      overflow: hidden;
    }

    .po-footer-smart a {
      color: inherit;
      text-decoration: none;
    }

    .po-footer-smart .po-container {
      width: 100%;
      max-width: var(--po-page-width);
      margin: 0 auto;
      padding: 0 24px;
    }

    .po-footer-smart__newsletter {
      display: grid;
      grid-template-columns: minmax(360px, 560px) minmax(420px, 560px);
      justify-content: space-between;
      align-items: end;
      gap: clamp(32px, 5vw, 68px);
      padding: 8px 0 42px;
      border-bottom: 1px solid var(--po-line);
    }

    .po-footer-smart__kicker {
      display: inline-block;
      margin: 0 0 12px;
      color: var(--po-honey);
      font-family: Fraunces, Georgia, "Times New Roman", serif;
      font-size: clamp(16px, 1.25vw, 19px);
      line-height: 1;
      font-style: italic;
      font-weight: 650;
      letter-spacing: 0.02em;
      transform: rotate(-1deg);
    }

    .po-footer-smart__heading {
      margin: 0;
      max-width: 570px;
      color: var(--po-cream);
      font-family: Fraunces, Georgia, "Times New Roman", serif;
      font-size: clamp(34px, 3.2vw, 48px);
      line-height: 1.12;
      font-weight: 650;
      letter-spacing: -0.045em;
      text-transform: none;
    }

    .po-footer-smart__form {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
      padding-bottom: 5px;
    }

    .po-footer-smart__field {
      position: relative;
      min-width: 0;
    }

    .po-footer-smart__field svg {
      position: absolute;
      left: 18px;
      top: 50%;
      width: 16px;
      height: 16px;
      transform: translateY(-50%);
      color: rgba(247, 241, 228, 0.56);
      pointer-events: none;
    }

    .po-footer-smart__input {
      width: 100%;
      height: 50px;
      border: 1px solid rgba(247, 241, 228, 0.24);
      border-radius: 999px;
      background: rgba(247, 241, 228, 0.045);
      color: var(--po-cream);
      padding: 0 20px 0 50px;
      outline: none;
      font-size: 14px;
      line-height: 1;
      font-weight: 500;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
      transition: border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
    }

    .po-footer-smart__input::placeholder {
      color: rgba(247, 241, 228, 0.48);
    }

    .po-footer-smart__input:focus {
      border-color: rgba(241, 200, 88, 0.72);
      background: rgba(247, 241, 228, 0.075);
      box-shadow: 0 0 0 4px rgba(241, 200, 88, 0.08);
    }

    .po-footer-smart__submit {
      height: 50px;
      min-width: 154px;
      border: 0;
      border-radius: 999px;
      background: var(--po-honey);
      color: var(--po-forest-deep);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 0 24px;
      font-size: 12px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 14px 28px rgba(0, 0, 0, 0.16);
      transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
    }

    .po-footer-smart__submit:hover {
      transform: translateY(-1px);
      background: #f4c968;
      box-shadow: 0 18px 34px rgba(0, 0, 0, 0.2);
    }

    .po-footer-smart__submit svg {
      width: 15px;
      height: 15px;
      stroke-width: 2.4;
    }

    .po-footer-smart .errors,
    .po-footer-smart .form-success {
      grid-column: 1 / -1;
      margin: 2px 0 0;
      color: var(--po-cream);
      font-size: 13px;
    }

    .po-footer-smart__main {
      display: grid;
      grid-template-columns: minmax(280px, 1.2fr) repeat(3, minmax(130px, 0.66fr));
      gap: clamp(34px, 5vw, 78px);
      align-items: start;
      padding: 46px 0 48px;
      border-bottom: 1px solid var(--po-line);
    }

    .po-footer-smart__brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
    }

    .po-footer-smart__logo-mark {
      width: 100px;
      height: 80px;
      flex: 0 0 100px;
      border-radius: 999px;
      background: var(--po-honey);
      color: var(--po-forest-deep);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .po-footer-smart__logo-mark img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .po-footer-smart__logo-mark svg {
      width: 22px;
      height: 22px;
      stroke-width: 2.2;
    }

    .po-footer-smart__brand-copy {
      display: flex;
      flex-direction: column;
      line-height: 1;
    }

    .po-footer-smart__brand-name {
      color: var(--po-cream);
      font-family: Fraunces, Georgia, "Times New Roman", serif;
      font-size: clamp(24px, 2vw, 28px);
      font-weight: 650;
      line-height: 0.95;
      letter-spacing: -0.065em;
      text-transform: lowercase;
    }

    .po-footer-smart__brand-subtitle {
      margin-top: 7px;
      color: rgba(247, 241, 228, 0.62);
      font-size: 10px;
      line-height: 1;
      font-weight: 800;
      letter-spacing: 0.32em;
      text-transform: uppercase;
    }

    .po-footer-smart__brand-text {
      max-width: 390px;
      margin: 0 0 22px;
      color: var(--po-cream-deep);
      font-size: 15.5px;
      line-height: 1.62;
      font-weight: 500;
    }

    .po-footer-smart__brand-text p {
      margin: 0;
    }

    .po-footer-smart__contact-list {
      max-width: 410px;
      margin: -6px 0 22px;
      display: grid;
      gap: 9px;
      color: var(--po-cream-deep);
      font-size: 13.5px;
      line-height: 1.45;
      font-weight: 600;
    }

    .po-footer-smart__contact-row {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      flex-wrap: wrap;
    }

    .po-footer-smart__contact-row strong {
      color: var(--po-honey);
      font-size: 10px;
      line-height: 1.8;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .po-footer-smart__contact-row a,
    .po-footer-smart__contact-row span {
      color: var(--po-cream-deep);
      overflow-wrap: anywhere;
    }

    .po-footer-smart__contact-row a:hover {
      color: var(--po-cream);
    }

    .po-footer-smart__contact-label {
      display: block;
      margin: 0 0 4px;
      color: var(--po-honey);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .po-footer-smart__brand-actions {
      display: grid;
      align-items: flex-start;
      gap: 16px;
      grid-auto-flow: column;
      margin-bottom: 20px;
    }

    .po-footer-smart__socials {
      display: flex;
      align-items: center;
      gap: 11px;
      padding-top: 4px;
    }

    .po-footer-smart__social {
      width: 38px;
      height: 38px;
      border-radius: 999px;
      border: 1px solid rgba(247, 241, 228, 0.22);
      color: var(--po-cream);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background 0.22s ease, color 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
    }

    .po-footer-smart__social svg {
      width: 17px;
      height: 17px;
    }

    .po-footer-smart__social:hover {
      background: var(--po-honey);
      color: var(--po-forest-deep);
      border-color: var(--po-honey);
      transform: translateY(-1px);
    }

    .po-footer-smart__delivery-checker {
      width: 255px;
      max-width: 100%;
    }

    .po-footer-smart__zip-field {
      width: 100%;
      height: 48px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      border: 1px solid rgba(247, 241, 228, 0.24);
      border-radius: 999px;
      background: rgba(247, 241, 228, 0.045);
      overflow: hidden;
      transition: border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
    }

    .po-footer-smart__zip-field:focus-within {
      border-color: rgba(241, 200, 88, 0.72);
      background: rgba(247, 241, 228, 0.075);
      box-shadow: 0 0 0 4px rgba(241, 200, 88, 0.08);
    }

    .po-footer-smart__zip-input {
      min-width: 0;
      width: 100%;
      height: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--po-cream);
      padding: 0 12px 0 16px;
      font-size: 13px;
      line-height: 1;
      font-weight: 600;
    }

    .po-footer-smart__zip-input::placeholder {
      color: rgba(247, 241, 228, 0.48);
    }

    .po-footer-smart__zip-button {
      height: 38px;
      margin-right: 5px;
      padding: 0 13px;
      border: 0;
      border-radius: 999px;
      background: var(--po-honey);
      color: var(--po-forest-deep);
      font-size: 10px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
      transition: transform 0.22s ease, background 0.22s ease;
    }

    .po-footer-smart__zip-button:hover {
      transform: translateY(-1px);
      background: #f4c968;
    }

    .po-footer-smart__zip-message {
      display: none;
      margin: 8px 0 0;
      font-size: 12px;
      line-height: 1.35;
      font-weight: 700;
    }

    .po-footer-smart__zip-message.is-success,
    .po-footer-smart__zip-message.is-error {
      display: block;
    }

    .po-footer-smart__zip-message.is-success {
      color: var(--po-honey);
    }

    .po-footer-smart__zip-message.is-error {
      color: rgba(247, 241, 228, 0.72);
    }

    .po-footer-smart__menu-title {
      margin: 2px 0 20px;
      color: var(--po-honey);
      font-size: 11px;
      line-height: 1;
      font-weight: 850;
      letter-spacing: 0.4em;
      text-transform: uppercase;
    }

    .po-footer-smart__menu-toggle {
      display: none;
    }

    .po-footer-smart__menu-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    .po-footer-smart__menu-list a {
      display: inline-block;
      color: var(--po-cream-deep);
      font-size: 14.5px;
      line-height: 1.25;
      font-weight: 500;
      transition: color 0.22s ease, transform 0.22s ease;
    }

    .po-footer-smart__menu-list a:hover {
      color: var(--po-cream);
      transform: translateX(3px);
    }

    .po-footer-smart__bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 22px;
      padding-top: 24px;
      color: rgba(247, 241, 228, 0.54);
      font-size: 12.5px;
      line-height: 1.45;
      font-weight: 500;
    }

    .po-footer-smart__legal {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 24px;
      flex-wrap: wrap;
    }

    .po-footer-smart__legal a {
      color: rgba(247, 241, 228, 0.54);
      transition: color 0.22s ease;
    }

    .po-footer-smart__legal a:hover {
      color: var(--po-cream);
    }

    .po-footer-smart__selectors,
    .po-footer-smart__payments {
      padding-top: 22px;
    }

    .po-footer-smart__payments .payment-icons {
      margin: 0;
      justify-content: center;
    }

    @media (max-width: 1120px) {
      .po-footer-smart__newsletter {
        grid-template-columns: 1fr;
        align-items: start;
        gap: 24px;
      }

      .po-footer-smart__heading {
        max-width: 760px;
      }

      .po-footer-smart__form {
        max-width: 680px;
        padding-bottom: 0;
      }

      .po-footer-smart__main {
        grid-template-columns: 1.25fr repeat(3, 1fr);
        gap: 32px;
      }
    }

    @media (max-width: 900px) {
      .po-footer-smart .po-container {
        padding: 0 20px;
      }

      .po-footer-smart__main {
        grid-template-columns: 1fr 1fr 1fr;
        gap: 34px 28px;
      }

      .po-footer-smart__brand {
        grid-column: 1 / -1;
        max-width: 560px;
      }
    }

    @media (max-width: 640px) {
      .po-footer-smart {
        padding-top: calc(var(--po-pad-top) * 0.72);
        padding-bottom: calc(var(--po-pad-bottom) * 0.78);
      }

      .po-footer-smart .po-container {
        padding: 0 16px;
      }

      .po-footer-smart__newsletter {
        padding: 4px 0 32px;
        gap: 22px;
      }

      .po-footer-smart__kicker {
        margin-bottom: 10px;
        font-size: 16px;
      }

      .po-footer-smart__heading {
        max-width: 100%;
        font-size: clamp(30px, 8.5vw, 38px);
        line-height: 1.12;
        letter-spacing: -0.04em;
      }

      .po-footer-smart__form {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .po-footer-smart__input,
      .po-footer-smart__submit {
        height: 48px;
      }

      .po-footer-smart__submit {
        width: 100%;
        min-width: 0;
      }

      .po-footer-smart__main {
        grid-template-columns: 1fr;
        gap: 0;
        padding: 34px 0 36px;
      }

      .po-footer-smart__brand {
        margin-bottom: 26px;
      }

      .po-footer-smart__brand-logo {
        margin-bottom: 16px;
      }

      .po-footer-smart__logo-mark {
        width: 40px;
        height: 40px;
        flex-basis: 40px;
      }

      .po-footer-smart__brand-name {
        font-size: 25px;
      }

      .po-footer-smart__brand-subtitle {
        font-size: 9px;
        letter-spacing: 0.28em;
      }

      .po-footer-smart__brand-text {
        font-size: 15px;
        line-height: 1.58;
        margin-bottom: 20px;
      }

      .po-footer-smart__brand-actions {
        flex-direction: column;
        align-items: stretch;
        gap: 16px;
      }

      .po-footer-smart__delivery-checker {
        width: 100%;
      }

      .po-footer-smart__socials {
        padding-top: 0;
      }

      .po-footer-smart__menu {
        border-top: 1px solid rgba(247, 241, 228, 0.13);
      }

      .po-footer-smart__menu:last-of-type {
        border-bottom: 1px solid rgba(247, 241, 228, 0.13);
      }

      .po-footer-smart__menu-title {
        display: none;
      }

      .po-footer-smart__menu-toggle {
        width: 100%;
        min-height: 54px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--po-honey);
        font-size: 11px;
        line-height: 1;
        font-weight: 850;
        letter-spacing: 0.34em;
        text-transform: uppercase;
        cursor: pointer;
      }

      .po-footer-smart__menu-toggle svg {
        width: 17px;
        height: 17px;
        transition: transform 0.22s ease;
      }

      .po-footer-smart__menu.is-open .po-footer-smart__menu-toggle svg {
        transform: rotate(180deg);
      }

      .po-footer-smart__menu-list {
        display: none;
        gap: 12px;
        padding: 0 0 18px;
      }

      .po-footer-smart__menu.is-open .po-footer-smart__menu-list {
        display: flex;
      }

      .po-footer-smart__menu-list a {
        font-size: 14.5px;
      }

      .po-footer-smart__bottom {
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
        padding-top: 22px;
      }

      .po-footer-smart__legal {
        justify-content: flex-start;
        gap: 12px 20px;
      }
    }

    @media (max-width: 420px) {
      .po-footer-smart__heading {
        font-size: 29px;
      }

      .po-footer-smart__brand-logo {
        gap: 10px;
      }

      .po-footer-smart__brand-name {
        font-size: 23px;
      }
    }
  </style>

  <div class="po-container">
    {%- if section.settings.show_newsletter -%}
      <div class="po-footer-smart__newsletter">
        <div class="po-footer-smart__newsletter-copy">
          {%- if section.settings.kicker != blank -%}
            <span class="po-footer-smart__kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="po-footer-smart__heading">{{ section.settings.heading | newline_to_br }}</h2>
          {%- endif -%}
        </div>

        {%- form 'customer', id: 'POFooterSmartNewsletter', class: 'po-footer-smart__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="po-footer-smart__field">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4.5 7.5h15v10h-15v-10Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M5 8l7 5.2L19 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>

            <input
              id="POFooterSmartNewsletterEmail"
              class="po-footer-smart__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ section.settings.email_placeholder }}"
              required
            >
          </div>

          <button class="po-footer-smart__submit" type="submit">
            <span>{{ section.settings.button_label }}</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h13" stroke="currentColor" stroke-linecap="round"/>
              <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          {%- if form.posted_successfully? -%}
            <p class="form-success">{{ 'general.newsletter_form.confirmation' | t }}</p>
          {%- endif -%}

          {{ form.errors | default_errors }}
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="po-footer-smart__main">
      <div class="po-footer-smart__brand">
        <a href="{{ routes.root_url }}" class="po-footer-smart__brand-logo" aria-label="{{ shop.name }} home">
          <span class="po-footer-smart__logo-mark">
            {%- if section.settings.logo_mark != blank -%}
              {{ section.settings.logo_mark | image_url: width: 120 | image_tag: loading: 'lazy', alt: shop.name }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M19.5 4.5C11.6 4.8 6.2 8.8 5.2 15.4C4.8 18 6.6 20.1 9.1 20.1C14.9 20.1 18.4 13.2 19.5 4.5Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M5.5 18.5C8.2 14.4 11.7 11.7 15.8 10.3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endif -%}
          </span>

          <span class="po-footer-smart__brand-copy">
            <span class="po-footer-smart__brand-name">{{ section.settings.brand_name }}</span>
            <span class="po-footer-smart__brand-subtitle">{{ section.settings.brand_subtitle }}</span>
          </span>
        </a>

        {%- if section.settings.brand_text != blank -%}
          <div class="po-footer-smart__brand-text">{{ section.settings.brand_text }}</div>
        {%- endif -%}

         <div class="po-footer-smart__brand-actions">
          <div class="po-footer-smart__socials" aria-label="Social links">
            {%- if section.settings.instagram_url != blank -%}
              <a class="po-footer-smart__social" href="{{ section.settings.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="3.2" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/><circle cx="15.7" cy="8.3" r=".7" fill="currentColor"/></svg>
              </a>
            {%- endif -%}

            {%- if section.settings.facebook_url != blank -%}
